[package]
name = "cyim-lsp"
version = "${file:VERSION}"
description = "cyim-lsp — LSP client plugin for cyim. Spawns cyrius-lsp as a subprocess, frames JSON-RPC over pipes, and routes diagnostics / didSave / didChange / definition / references through cyim's plugin ABI."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.2.11"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cyim-lsp"

# Stdlib footprint:
#   syscalls/alloc/fmt/io  — required core
#   string/str/vec         — message buffers, line storage
#   assert                 — tests/cyim-lsp.tcyr
#   json                   — JSON-RPC payload parse / build
#   process                — spawn(cmd, arg1, arg2) for cyrius-lsp subprocess
[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "string",
    "str",
    "vec",
    "assert",
    "json",
    "process",
]

# `[lib]` drives `cyrius distlib` — concatenates the listed modules
# into `dist/cyim-lsp.cyr` for downstream consumers (cyim, via
# `include "lib/cyim-lsp.cyr"`). The bundle is **self-contained**:
# every symbol resolves against the listed modules + cyrius stdlib,
# with NO references to consumer-side editor symbols. Consumer-side
# hook registration lives in the consumer's own glue file (see
# `docs/examples/cyim_glue.cyr` for cyim's reference shape).
#
# Single-pass compiler: each module may only reference symbols
# defined earlier. Order:
#   jsonrpc.cyr        — Content-Length framing, message build / parse
#   subprocess.cyr     — pipe / fork / exec / dup2 primitives
#   lsp_diags.cyr      — publishDiagnostics walker, per-URI tuple state
#                        (defines lsp_diags_handle_frame)
#   lsp_client.cyr     — LSP protocol (initialize, send, recv, drain);
#                        references jsonrpc + subprocess + lsp_diags_handle_frame
#   lsp_state.cyr      — per-buffer state vec
#   lsp_position.cyr   — line↔char/offset helpers; URI/coord parse;
#                        references lsp_diags (find/parse helpers)
#   lsp_documents.cyr  — didOpen/didChange/didSave/nav senders;
#                        references jsonrpc + lsp_client + lsp_state
[lib]
modules = [
    "src/jsonrpc.cyr",
    "src/subprocess.cyr",
    "src/lsp_diags.cyr",
    "src/lsp_client.cyr",
    "src/lsp_state.cyr",
    "src/lsp_position.cyr",
    "src/lsp_documents.cyr",
]
