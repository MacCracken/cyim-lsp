[package]
name = "cyim-lsp"
version = "${file:VERSION}"
description = "cyim-lsp — LSP client plugin for cyim. Spawns cyrius-lsp as a subprocess, frames JSON-RPC over pipes, and routes diagnostics / didSave / didChange / definition / references through cyim's plugin ABI."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.5.18"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "cyim-lsp"

# Stdlib footprint:
#   syscalls/alloc/fmt/io  — required core
#   string/str/vec         — message buffers, line storage
#   assert                 — tests/cyim-lsp.tcyr
#   process                — spawn(cmd, arg1, arg2) for cyrius-lsp subprocess
#
# `json` was declared here from v0.2.0 and NEVER CALLED — every LSP payload is
# scanned by this repo's own hand-written readers (lsp_diags.cyr's
# `_lsp_diag_parse_int` / `_lsp_diags_find`, lsp_position.cyr's coord parsers),
# chosen so diagnostics parsing does not allocate a whole document tree per
# publishDiagnostics. The declaration went stale when cyrius folded `json` into
# `bayan` (which now re-exports `json_parse` / `json_get` / … as shims), leaving
# no `lib/json.cyr` in the 6.5.x stdlib. Nothing broke here only because this
# repo's committed `lib/` still carried a pre-fold `json.cyr` — `lib sync`
# copies, it does not prune. It surfaced the moment a CONSUMER resolved the
# `dist/cyim-lsp.deps` sidecar against a correctly-synced stdlib:
# "dep cyim-lsp requires 'json' but it is not in the cyrius stdlib".
# Dropped rather than repointed at `bayan` — declaring bayan would fold ~5.4
# KLOC into every consumer to satisfy a dependency that does not exist.
#   args                   — NOT used directly. Required on the agnos target
#                            only: io.cyr's getenv() delegates to
#                            args_agnos.cyr's _agnos_getenv under
#                            CYRIUS_TARGET_AGNOS, because agnos has no
#                            /proc/self/environ and stages envp on the exec
#                            init stack instead. Declaring io without args
#                            builds fine on Linux and leaves an undefined
#                            function on agnos — invisible until this repo
#                            started building --agnos in CI.
[deps]
stdlib = [
    "syscalls",
    "alloc",
    "fmt",
    "io",
    "string",
    "str",
    "vec",
    "args",
    "assert",
    "process",
]

# `[lib]` drives `cyrius distlib` — concatenates the listed modules
# into `dist/cyim-lsp.cyr` for downstream consumers (cyim, via
# `include "lib/cyim-lsp.cyr"`). The bundle is **self-contained**:
# every symbol resolves against the listed modules + cyrius stdlib,
# with NO references to consumer-side editor symbols. Consumer-side
# hook registration lives in the consumer's own glue file (see
# `docs/examples/cyim_glue.cyr` for cyim's reference shape).
#
# Single-pass compiler: each module may only reference symbols
# defined earlier. Order:
#   jsonrpc.cyr        — Content-Length framing, message build / parse
#   subprocess.cyr     — pipe / fork / exec / dup2 primitives
#   lsp_diags.cyr      — publishDiagnostics walker, per-URI tuple state
#                        (defines lsp_diags_handle_frame)
#   lsp_client.cyr     — LSP protocol (initialize, send, recv, drain);
#                        references jsonrpc + subprocess + lsp_diags_handle_frame
#   lsp_state.cyr      — per-buffer state vec
#   lsp_position.cyr   — line↔char/offset helpers; URI/coord parse;
#                        references lsp_diags (find/parse helpers)
#   lsp_documents.cyr  — didOpen/didChange/didSave/nav senders;
#                        references jsonrpc + lsp_client + lsp_state
[lib]
modules = [
    "src/jsonrpc.cyr",
    "src/subprocess.cyr",
    "src/lsp_diags.cyr",
    "src/lsp_client.cyr",
    "src/lsp_state.cyr",
    "src/lsp_position.cyr",
    "src/lsp_documents.cyr",
]
