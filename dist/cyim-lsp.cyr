# --- jsonrpc.cyr ---

# jsonrpc.cyr — JSON-RPC 2.0 framing for LSP (v0.2.0)
#
# LSP messages are JSON-RPC payloads with a Content-Length header:
#   Content-Length: <N>\r\n
#   \r\n
#   <N bytes of JSON>
#
# Public surface (frozen for v0.2.x):
#   jsonrpc_version()                          -> "2.0"
#   jsonrpc_next_id()                          -> auto-incrementing i64
#   jsonrpc_build_notification(method, params) -> framed cstring
#   jsonrpc_build_request(id, method, params)  -> framed cstring
#   jsonrpc_parse_frame(buf, len, off_out, len_out) -> 1 / 0 / -1
#
# `params` is a NUL-term cstring of pre-serialized JSON (e.g.
# `{"textDocument":{"uri":"file:///foo"}}`). v0.2.0 hand-rolls the
# JSON-RPC envelope rather than using the json stdlib because the
# envelope shape is fixed and embedding pre-serialized params keeps
# the API simple. Future versions may use json stdlib for more
# complex outgoing builds (e.g. nested object construction in
# message handlers); v0.2.0 doesn't need it.
#
# `jsonrpc_parse_frame` return values:
#   1   — valid frame found; *off_out and *len_out set
#   0   — buffer incomplete; caller should accumulate more bytes
#   -1  — malformed header; caller should drop the connection
#
# Self-contained — no plugin ABI references. First in dist/cyim-lsp.cyr
# concatenation order; downstream modules (lsp_client, plugin_init)
# build on these helpers.

# === Internal helpers ===

# Append a NUL-term cstring `src` into `dst` at offset `off`.
# Returns the new offset (off + strlen(src)).
fn _jr_append(dst, off, src) {
    var sl = strlen(src);
    var i = 0;
    while (i < sl) {
        store8(dst + off + i, load8(src + i));
        i = i + 1;
    }
    return off + sl;
}

# Convert a non-negative i64 to a NUL-term decimal cstring on the
# heap. Returns the heap pointer (caller-owned; lives until process
# exit per cyrius's bump-alloc convention).
fn _jr_itoa(n) {
    if (n == 0) {
        var z = alloc(2);
        if (z == 0) { return 0; }
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    # Reverse-fill into a 24-byte stack buf (max i64 = 19 digits + sign).
    var tmp[24];
    var tlen = 0;
    var v = n;
    while (v > 0) {
        store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
        v = v / 10;
        tlen = tlen + 1;
    }
    var out = alloc(tlen + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < tlen) {
        store8(out + i, load8(&tmp + tlen - 1 - i));
        i = i + 1;
    }
    store8(out + tlen, 0);
    return out;
}

# Wrap `body` (NUL-term JSON cstring) with the LSP Content-Length
# header. Returns the framed cstring.
fn _jr_frame(body) {
    var body_len = strlen(body);
    var dec = _jr_itoa(body_len);
    if (dec == 0) { return 0; }
    var dec_len = strlen(dec);
    # "Content-Length: " (16) + dec + "\r\n\r\n" (4) + body
    var total = 16 + dec_len + 4 + body_len;
    var out = alloc(total + 1);
    if (out == 0) { return 0; }
    var off = 0;
    off = _jr_append(out, off, "Content-Length: ");
    off = _jr_append(out, off, dec);
    off = _jr_append(out, off, "\r\n\r\n");
    off = _jr_append(out, off, body);
    store8(out + off, 0);
    return out;
}

# === Public API ===

fn jsonrpc_version() {
    return "2.0";
}

# Auto-incrementing message id allocator. Starts at 1; LSP
# specification recommends positive integers but neither requires
# strict monotonicity nor forbids reuse — incrementing is the
# safe choice. Caller correlates request id → response id.
var _jsonrpc_next_id = 1;

fn jsonrpc_next_id() {
    var n = _jsonrpc_next_id;
    _jsonrpc_next_id = n + 1;
    return n;
}

# Build a JSON-RPC notification (no `id` field — fire-and-forget).
# `method` and `params` are NUL-term cstrings; `params` must be a
# pre-serialized JSON value (object, array, or null).
#
# Body shape:
#   {"jsonrpc":"2.0","method":"<method>","params":<params>}
#
# Returns a NUL-term framed cstring (Content-Length header + body)
# or 0 on alloc failure.
fn jsonrpc_build_notification(method, params) {
    var ml = strlen(method);
    var pl = strlen(params);
    # Upper-bound capacity:
    #   prefix `{"jsonrpc":"2.0","method":"` = 27
    #   sep `","params":` = 11
    #   suffix `}` = 1
    var cap = 39 + ml + pl + 1;
    var body = alloc(cap);
    if (body == 0) { return 0; }
    var off = 0;
    off = _jr_append(body, off, "{\"jsonrpc\":\"2.0\",\"method\":\"");
    off = _jr_append(body, off, method);
    off = _jr_append(body, off, "\",\"params\":");
    off = _jr_append(body, off, params);
    off = _jr_append(body, off, "}");
    store8(body + off, 0);
    return _jr_frame(body);
}

# Build a JSON-RPC request (with `id` for response correlation).
#
# Body shape:
#   {"jsonrpc":"2.0","id":<id>,"method":"<method>","params":<params>}
#
# Returns a NUL-term framed cstring or 0 on alloc failure.
fn jsonrpc_build_request(id, method, params) {
    var id_str = _jr_itoa(id);
    if (id_str == 0) { return 0; }
    var idl = strlen(id_str);
    var ml = strlen(method);
    var pl = strlen(params);
    # Upper-bound capacity:
    #   prefix `{"jsonrpc":"2.0","id":` = 22
    #   id digits
    #   sep1 `,"method":"` = 11
    #   method
    #   sep2 `","params":` = 11
    #   params
    #   suffix `}` = 1
    var cap = 45 + idl + ml + pl + 1;
    var body = alloc(cap);
    if (body == 0) { return 0; }
    var off = 0;
    off = _jr_append(body, off, "{\"jsonrpc\":\"2.0\",\"id\":");
    off = _jr_append(body, off, id_str);
    off = _jr_append(body, off, ",\"method\":\"");
    off = _jr_append(body, off, method);
    off = _jr_append(body, off, "\",\"params\":");
    off = _jr_append(body, off, params);
    off = _jr_append(body, off, "}");
    store8(body + off, 0);
    return _jr_frame(body);
}

# Parse one LSP frame from `buf` (raw bytes, length `len`).
# On valid frame: writes body offset + length to the i64 slots
# at `off_out` and `len_out`, returns 1.
# On incomplete frame (need more bytes): returns 0 (slots untouched).
# On malformed frame: returns -1.
#
# The LSP spec also allows additional headers (e.g. Content-Type)
# separated by \r\n; v0.2.0 only handles Content-Length and
# rejects any other header line as malformed. Lifting this is a
# v0.2.x patch when a real server starts sending Content-Type.
fn jsonrpc_parse_frame(buf, len, off_out, len_out) {
    # Need at least "Content-Length: \r\n\r\n0" = ~22 bytes for any frame.
    # Tolerate short buffers (incomplete) without ever reading past `len`.
    if (len < 16) { return 0; }
    # Match prefix "Content-Length: " (16 bytes).
    var prefix = "Content-Length: ";
    var i = 0;
    while (i < 16) {
        if (load8(buf + i) != load8(prefix + i)) { return 0 - 1; }
        i = i + 1;
    }
    # Parse decimal length up to \r. Use the go-flag loop pattern
    # so we can stop the loop when CR is seen without using `break`
    # (Cyrius's break is unreliable in loops with `var` decls).
    var n = 0;
    var k = 16;
    var saw_cr = 0;
    var any_digit = 0;
    var go = 1;
    while (go == 1) {
        if (k >= len) { go = 0; }
        if (go == 1) {
            var c = load8(buf + k);
            if (c == 13) {
                saw_cr = 1;
                go = 0;
            }
            if (c != 13) {
                if (c < 48) { return 0 - 1; }
                if (c > 57) { return 0 - 1; }
                n = n * 10 + (c - 48);
                # F-1 (audit 2026-05-06): cap at 16 MB. Matches the
                # _lsp_recv_frame buffer cap upstream; anything larger
                # is rejected before integer overflow can wrap `n` to
                # a negative value and bypass the body-length guard.
                if (n > 16777216) { return 0 - 1; }
                any_digit = 1;
                k = k + 1;
            }
        }
    }
    if (saw_cr == 0) { return 0; }
    if (any_digit == 0) { return 0 - 1; }
    # Now expect \r\n\r\n starting at buf[k].
    if (k + 4 > len) { return 0; }
    if (load8(buf + k) != 13)     { return 0 - 1; }
    if (load8(buf + k + 1) != 10) { return 0 - 1; }
    if (load8(buf + k + 2) != 13) { return 0 - 1; }
    if (load8(buf + k + 3) != 10) { return 0 - 1; }
    var body_start = k + 4;
    if (body_start + n > len) { return 0; }
    store64(off_out, body_start);
    store64(len_out, n);
    return 1;
}

# --- subprocess.cyr ---

# subprocess.cyr — bidirectional-pipe subprocess primitives (v0.3.0)
#
# cyim-lsp spawns cyrius-lsp as a subprocess and talks to it over
# stdin/stdout pipes (LSP protocol convention). This file owns the
# pipe + fork + exec dance and the per-process handle.
#
# Why not stdlib's `process.cyr` `spawn()`? That helper is
# unidirectional (run + capture stdout). LSP needs both directions
# in flight simultaneously: parent writes requests / notifications
# to child stdin while reading responses / publishDiagnostics from
# child stdout.
#
# Public surface (frozen for v0.3.x):
#   lsp_proc_spawn(cmd, arg1, arg2)       -> proc handle (heap) or 0
#   lsp_proc_send(proc, buf, len)         -> bytes written, or -1
#   lsp_proc_recv(proc, buf, max)         -> bytes read, or -1 / 0 (EOF)
#   lsp_proc_close(proc)                  -> 0 on success, -1 on error
#   lsp_proc_pid(proc)                    -> child pid, or -1 if closed
#
# Proc handle layout (32 B):
#   +0   pid           i64 (set to -1 by close)
#   +8   read_fd       i64 (parent reads child stdout)
#   +16  write_fd      i64 (parent writes to child stdin)
#   +24  reserved      i64 (future: spawn-side state, e.g. capabilities ptr)
#
# Pipe orientation:
#   p_in[2]:  parent → child (parent writes p_in[1], child reads p_in[0] as stdin)
#   p_out[2]: child → parent (child writes p_out[1] as stdout, parent reads p_out[0])
#
# After fork, parent closes the child's ends; child closes the
# parent's ends, dup2's its halves to stdin/stdout, then execve.

# Build the argv array for execve. Mirrors process.cyr's `_exec3`
# but inlined here so we don't need to depend on process.cyr's
# internal-only helper. argv layout: [cmd, arg1?, arg2?, NULL].
fn _lsp_proc_exec(cmd, arg1, arg2) {
    var argv[4];
    store64(&argv, cmd);
    var ai = 1;
    if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
    if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
    store64(&argv + ai * 8, 0);
    var envp[1];
    store64(&envp, 0);
    sys_execve(cmd, &argv, &envp);
    # If execve returns, exec failed.
    sys_exit(127);
    return 0;
}

# Spawn `cmd` with optional arg1 / arg2 (pass 0 to omit). Sets up
# bidirectional pipes; returns a 32 B proc handle on success, 0 on
# any failure (pipe / fork / alloc).
#
# Caller is responsible for calling lsp_proc_close to reap the
# child and free the pipe fds. Forgetting close leaks fds + leaves
# a zombie process; always pair spawn with close.
fn lsp_proc_spawn(cmd, arg1, arg2) {
    var p_in[16];
    var p_out[16];
    if (sys_pipe(&p_in) < 0) { return 0; }
    if (sys_pipe(&p_out) < 0) {
        sys_close(load32(&p_in));
        sys_close(load32(&p_in + 4));
        return 0;
    }
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(load32(&p_in));
        sys_close(load32(&p_in + 4));
        sys_close(load32(&p_out));
        sys_close(load32(&p_out + 4));
        return 0;
    }
    if (pid == 0) {
        # Child: close parent's ends, wire halves to stdin/stdout.
        sys_close(load32(&p_in + 4));   # parent's write end of input pipe
        sys_close(load32(&p_out));      # parent's read end of output pipe
        sys_dup2(load32(&p_in), 0);     # stdin = read end of input pipe
        sys_dup2(load32(&p_out + 4), 1); # stdout = write end of output pipe
        sys_close(load32(&p_in));
        sys_close(load32(&p_out + 4));
        _lsp_proc_exec(cmd, arg1, arg2);
        # Unreachable; _lsp_proc_exec calls sys_exit on failure.
        sys_exit(127);
    }
    # Parent: close child's ends, build the handle.
    sys_close(load32(&p_in));        # child's read end of input pipe
    sys_close(load32(&p_out + 4));   # child's write end of output pipe
    var proc = alloc(32);
    if (proc == 0) {
        sys_close(load32(&p_in + 4));
        sys_close(load32(&p_out));
        return 0;
    }
    store64(proc,      pid);
    store64(proc + 8,  load32(&p_out));     # parent reads child stdout from here
    store64(proc + 16, load32(&p_in + 4));  # parent writes to child stdin here
    store64(proc + 24, 0);
    return proc;
}

# Accessors.
fn lsp_proc_pid(proc) {
    if (proc == 0) { return 0 - 1; }
    return load64(proc);
}

# Write `len` bytes from `buf` to the child's stdin. Returns the
# write() return value (bytes written, or -errno on failure).
fn lsp_proc_send(proc, buf, len) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    return sys_write(load64(proc + 16), buf, len);
}

# Read up to `max` bytes from the child's stdout into `buf`.
# Returns the read() return value:
#   > 0  — bytes read
#   = 0  — EOF (child closed stdout / exited)
#   < 0  — -errno
fn lsp_proc_recv(proc, buf, max) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    return sys_read(load64(proc + 8), buf, max);
}

# Close the child's pipes and reap the process via sys_waitpid.
# Idempotent: marks the proc handle's pid = -1 after first call so
# a second close() returns immediately without re-reaping.
fn lsp_proc_close(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0; }   # already closed
    sys_close(load64(proc + 8));
    sys_close(load64(proc + 16));
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    store64(proc, 0 - 1);   # mark closed
    return 0;
}

# Send SIGTERM to the child without closing pipes or reaping.
# Used by `:lsp-restart` to interrupt an unresponsive server
# before close-then-respawn. The caller still needs to call
# lsp_proc_close afterward to reap the zombie. Returns sys_kill's
# return value.
fn lsp_proc_kill(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    # SIGTERM = 15
    return sys_kill(pid, 15);
}

# Set O_NONBLOCK on the read pipe (parent reads child stdout).
# Called by lsp_client.cyr at the end of the initialize handshake
# so subsequent reads can return -EAGAIN instead of blocking. The
# write fd stays blocking (we always intend to send our entire
# message; partial-write handling lives in `_lsp_send_all` already).
#
# Constants: F_GETFL = 3, F_SETFL = 4, O_NONBLOCK = 2048 (Linux).
# SYS_FCNTL = 72 from syscalls_x86_64_linux.cyr.
#
# Returns 0 on success, -1 on fcntl failure.
fn lsp_proc_set_nonblock(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    var read_fd = load64(proc + 8);
    var flags = syscall(72, read_fd, 3, 0);   # F_GETFL
    if (flags < 0) { return 0 - 1; }
    var rc = syscall(72, read_fd, 4, flags | 2048);   # F_SETFL | O_NONBLOCK
    if (rc < 0) { return 0 - 1; }
    return 0;
}

# Non-blocking read variant. Like lsp_proc_recv but returns:
#   > 0  bytes read
#   = 0  EOF (child exited / closed stdout)
#   = -2 EAGAIN — no data ready right now (caller drains later)
#   = -1 unrecoverable error
#
# Requires lsp_proc_set_nonblock to have been called first.
fn lsp_proc_recv_nb(proc, buf, max) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    var n = sys_read(load64(proc + 8), buf, max);
    if (n >= 0) { return n; }
    # Linux's read(O_NONBLOCK) returns -EAGAIN (-11) when no data.
    if (n == 0 - 11) { return 0 - 2; }
    return 0 - 1;
}

# --- lsp_diags.cyr ---

# lsp_diags.cyr — per-URI diagnostic state (v0.5.0)
#
# Receives `textDocument/publishDiagnostics` notifications from
# the server, stores per-URI severity counts, and renders a
# status-segment summary like "E:3 W:1".
#
# v0.5.0 scope: severity counts only. Individual diagnostic line
# / message extraction (for cyim's diagnostic_provider hook →
# inline render) is v0.5.1's scope. The status_segment showing
# "LSP error count" is the cyim 1.4.0 pickup target — first
# user-visible signal that cyim-lsp is working.
#
# Public surface:
#   lsp_diags_init()                       -> 0
#   lsp_diags_handle_frame(body, body_len) -> 1 if publishDiagnostics
#                                             handled, 0 otherwise
#   lsp_diags_lookup(uri)                  -> entry ptr or 0
#   lsp_diags_count(entry, severity)       -> i64 count
#   lsp_diags_format_status(entry, out_buf, cap)
#                                          -> bytes written
#
# Per-URI entry layout (48 B):
#   +0   uri_ptr        (NUL-term cstring)
#   +8   count_error    (severity 1 in LSP)
#   +16  count_warning  (severity 2)
#   +24  count_info     (severity 3)
#   +32  count_hint     (severity 4)
#   +40  diag_vec       (vec<tuple_ptr> — per-diag tuples for the
#                        diagnostic_provider hook; 0 if no entries
#                        yet for this URI; v0.5.1+)
#
# Per-diag tuple layout (24 B; v0.5.1):
#   +0   line           (1-indexed line, LSP+1)
#   +8   severity       (1..4)
#   +16  msg_ptr        (NUL-term cstring; heap-owned)
#
# LSP severity values per LSP §3.7.4:
#   1 = Error
#   2 = Warning
#   3 = Information
#   4 = Hint

var _lsp_diags_table = 0;

fn lsp_diags_init() {
    if (_lsp_diags_table == 0) { _lsp_diags_table = vec_new(); }
    return 0;
}

# Compare a NUL-term cstring `a` against bytes [b, b+blen).
# Returns 1 on byte equality, 0 otherwise.
fn _lsp_diags_str_eq_range(a, b, blen) {
    var al = strlen(a);
    if (al != blen) { return 0; }
    var i = 0;
    while (i < blen) {
        if (load8(a + i) != load8(b + i)) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Lookup entry by URI cstring. Returns entry or 0 on miss.
fn lsp_diags_lookup(uri) {
    if (_lsp_diags_table == 0) { return 0; }
    var n = vec_len(_lsp_diags_table);
    var i = 0;
    while (i < n) {
        var e = vec_get(_lsp_diags_table, i);
        if (e != 0) {
            var eu = load64(e);
            if (eu != 0) {
                if (_lsp_diags_str_eq_range(uri, eu, strlen(eu)) == 1) {
                    return e;
                }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Create / find an entry for `uri`. URI is duplicated onto heap
# so caller can free / replace its own buffer.
fn _lsp_diags_get_or_create(uri) {
    if (_lsp_diags_table == 0) { lsp_diags_init(); }
    var existing = lsp_diags_lookup(uri);
    if (existing != 0) { return existing; }
    var ul = strlen(uri);
    var uri_dup = alloc(ul + 1);
    if (uri_dup == 0) { return 0; }
    var i = 0;
    while (i < ul) { store8(uri_dup + i, load8(uri + i)); i = i + 1; }
    store8(uri_dup + ul, 0);
    var e = alloc(48);
    if (e == 0) { return 0; }
    store64(e,      uri_dup);
    store64(e + 8,  0);
    store64(e + 16, 0);
    store64(e + 24, 0);
    store64(e + 32, 0);
    store64(e + 40, 0);
    vec_push(_lsp_diags_table, e);
    return e;
}

# Reset severity counts AND tuple vec on an entry (used when
# publishDiagnostics arrives — a new notification REPLACES the
# prior diag set per LSP §3.7.4).
fn _lsp_diags_reset(entry) {
    if (entry == 0) { return 0; }
    store64(entry + 8,  0);
    store64(entry + 16, 0);
    store64(entry + 24, 0);
    store64(entry + 32, 0);
    # v0.5.1: replace tuple vec with a fresh empty one. Old vec
    # leaks (cyrius bump-alloc — acceptable; tuples are bounded
    # in size). vec_clear would avoid the leak; v0.5.x can
    # tighten if memory pressure surfaces.
    store64(entry + 40, 0);
    return 0;
}

# Public count accessor. severity is 1..4; out-of-range returns 0.
fn lsp_diags_count(entry, severity) {
    if (entry == 0) { return 0; }
    if (severity == 1) { return load64(entry + 8); }
    if (severity == 2) { return load64(entry + 16); }
    if (severity == 3) { return load64(entry + 24); }
    if (severity == 4) { return load64(entry + 32); }
    return 0;
}

# === Bytescan helpers ===
#
# v0.5.0 doesn't pull the json stdlib parser into the LSP
# message hot path — JSON-RPC messages from cyrius-lsp have a
# well-defined shape and bytescanning the few literals we need
# is O(N) and avoids parser dependencies. The trade-off:
# bytescan is fragile against whitespace variations and string
# escapes within URIs. Real cyrius-lsp output doesn't use
# either, so it works in practice. If a future server breaks
# this assumption, refactor to use json_parse.

# Find the next occurrence of `needle` (NUL-term) in
# `[buf+from, buf+blen)`. Returns the offset within `buf` or -1.
fn _lsp_diags_find(buf, blen, from, needle) {
    var nl = strlen(needle);
    if (nl == 0) { return from; }
    var i = from;
    while (i + nl <= blen) {
        var hit = 1;
        var j = 0;
        while (j < nl) {
            if (load8(buf + i + j) != load8(needle + j)) {
                hit = 0;
                j = nl;
            }
            j = j + 1;
        }
        if (hit == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# Count occurrences of `needle` in `[buf, buf+blen)`. Used for
# severity counts: count `"severity":1` etc.
fn _lsp_diags_count_pattern(buf, blen, needle) {
    var count = 0;
    var nl = strlen(needle);
    if (nl == 0) { return 0; }
    var i = 0;
    while (i + nl <= blen) {
        var hit = _lsp_diags_find(buf, blen, i, needle);
        if (hit < 0) { return count; }
        count = count + 1;
        i = hit + nl;
    }
    return count;
}

# Extract the URI from a publishDiagnostics body. Looks for
# `"uri":"` and reads until the next `"`. Returns a heap-alloc'd
# cstring or 0 on failure.
fn _lsp_diags_extract_uri(buf, blen) {
    var marker = "\"uri\":\"";
    var pos = _lsp_diags_find(buf, blen, 0, marker);
    if (pos < 0) { return 0; }
    var start = pos + 7;   # past the marker
    # Find closing quote — assumes URIs don't contain unescaped
    # quotes (file:/// paths don't, by spec).
    var end = start;
    var go = 1;
    while (go == 1) {
        if (end >= blen) { return 0; }
        if (load8(buf + end) == 34) { go = 0; }
        if (go == 1) { end = end + 1; }
    }
    var ul = end - start;
    var out = alloc(ul + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < ul) {
        store8(out + i, load8(buf + start + i));
        i = i + 1;
    }
    store8(out + ul, 0);
    return out;
}

# === Per-diag extraction (v0.5.1) ===

# Allocate a 24 B tuple {line, severity, msg_ptr}.
fn _lsp_diag_tuple_new(line, severity, msg_ptr) {
    var t = alloc(24);
    if (t == 0) { return 0; }
    store64(t,      line);
    store64(t + 8,  severity);
    store64(t + 16, msg_ptr);
    return t;
}

fn lsp_diag_tuple_line(t)     { if (t == 0) { return 0; } return load64(t); }
fn lsp_diag_tuple_severity(t) { if (t == 0) { return 0; } return load64(t + 8); }
fn lsp_diag_tuple_msg(t)      { if (t == 0) { return 0; } return load64(t + 16); }

# Public accessors for entry's tuple vec.
fn lsp_diags_entry_count(entry) {
    if (entry == 0) { return 0; }
    var v = load64(entry + 40);
    if (v == 0) { return 0; }
    return vec_len(v);
}

fn lsp_diags_entry_tuple(entry, idx) {
    if (entry == 0) { return 0; }
    var v = load64(entry + 40);
    if (v == 0) { return 0; }
    if (idx < 0) { return 0; }
    if (idx >= vec_len(v)) { return 0; }
    return vec_get(v, idx);
}

# Parse an integer starting at `pos` in `body`. Returns the
# parsed value; sets *new_pos to point past the last digit.
# Returns -1 on no-digits.
fn _lsp_diag_parse_int(body, blen, pos, new_pos_out) {
    var n = 0;
    var any = 0;
    var p = pos;
    var go = 1;
    while (go == 1) {
        if (p >= blen) { go = 0; }
        if (go == 1) {
            var c = load8(body + p);
            if (c < 48) { go = 0; }
            if (c > 57) { go = 0; }
            if (go == 1) {
                n = n * 10 + (c - 48);
                # F-2 (audit 2026-05-06): cap at 100M. LSP coords
                # are non-negative; 100M dwarfs any conceivable
                # file. Stops the loop at the cap so further digits
                # don't wrap `n` to negative.
                if (n > 100000000) { n = 100000000; go = 0; }
                any = 1;
                p = p + 1;
            }
        }
    }
    store64(new_pos_out, p);
    if (any == 0) { return 0 - 1; }
    return n;
}

# Extract a JSON string starting after the opening quote at
# `pos` (which should be 1 past the `"`). Returns a heap-alloc'd
# cstring or 0. *end_pos_out gets the offset past the closing
# quote. Handles `\"`, `\\`, `\n`, `\r`, `\t` escapes; passes
# others through verbatim. Returns 0 on unterminated string.
fn _lsp_diag_parse_string(body, blen, pos, end_pos_out) {
    # First pass: measure (counting decoded bytes).
    var p = pos;
    var dec_len = 0;
    var go = 1;
    while (go == 1) {
        if (p >= blen) { return 0; }
        var c = load8(body + p);
        if (c == 34) { go = 0; }
        if (go == 1) {
            if (c == 92) {
                if (p + 1 >= blen) { return 0; }
                var c2 = load8(body + p + 1);
                if (c2 == 110) { dec_len = dec_len + 1; }   # \n
                if (c2 == 114) { dec_len = dec_len + 1; }   # \r
                if (c2 == 116) { dec_len = dec_len + 1; }   # \t
                if (c2 == 92)  { dec_len = dec_len + 1; }   # \\
                if (c2 == 34)  { dec_len = dec_len + 1; }   # \"
                if (c2 == 47)  { dec_len = dec_len + 1; }   # \/
                if (c2 == 98)  { dec_len = dec_len + 1; }   # \b
                if (c2 == 102) { dec_len = dec_len + 1; }   # \f
                if (c2 == 117) {
                    # \uXXXX — skip 4 hex digits, output 1 byte
                    # placeholder for v0.5.1 (full UTF-8 decoding
                    # is v0.5.x). 4 + 1 = 5 source chars yield
                    # 1 dec byte.
                    dec_len = dec_len + 1;
                    p = p + 4;
                }
                p = p + 2;
            } else {
                dec_len = dec_len + 1;
                p = p + 1;
            }
        }
    }
    # Second pass: copy + decode.
    var dst = alloc(dec_len + 1);
    if (dst == 0) { return 0; }
    var rp = pos;
    var wp = 0;
    go = 1;
    while (go == 1) {
        # F-3 (audit 2026-05-06): mirror first-pass `p >= blen`
        # guard. With stable input bytes the second pass walks
        # the same validated path, but the bound is now explicit
        # — defense-in-depth against any future buf mutation
        # between passes.
        if (rp >= blen) { return 0; }
        var c = load8(body + rp);
        if (c == 34) { go = 0; }
        if (go == 1) {
            if (c == 92) {
                var c2 = load8(body + rp + 1);
                if (c2 == 110)      { store8(dst + wp, 10); wp = wp + 1; }
                if (c2 == 114) { store8(dst + wp, 13); wp = wp + 1; }
                if (c2 == 116) { store8(dst + wp,  9); wp = wp + 1; }
                if (c2 == 92)  { store8(dst + wp, 92); wp = wp + 1; }
                if (c2 == 34)  { store8(dst + wp, 34); wp = wp + 1; }
                if (c2 == 47)  { store8(dst + wp, 47); wp = wp + 1; }
                if (c2 == 98)  { store8(dst + wp,  8); wp = wp + 1; }
                if (c2 == 102) { store8(dst + wp, 12); wp = wp + 1; }
                if (c2 == 117) {
                    # \uXXXX — emit '?' as v0.5.1 placeholder.
                    store8(dst + wp, 63);
                    wp = wp + 1;
                    rp = rp + 4;
                }
                rp = rp + 2;
            } else {
                store8(dst + wp, c);
                wp = wp + 1;
                rp = rp + 1;
            }
        }
    }
    store8(dst + wp, 0);
    store64(end_pos_out, rp + 1);   # past the closing "
    return dst;
}

# Walk the diagnostics array starting at `array_start` (index of
# `[` in body). Brace-depth + string-aware so nested objects
# (range.start, range.end) and embedded `{ } "` in messages
# don't fool the splitter.
#
# For each top-level diag object, calls
# `_lsp_diags_extract_one(body, blen, obj_start, obj_end, entry)`
# which appends a tuple to the entry's vec.
#
# Returns the number of objects walked.
fn _lsp_diags_walk_array(body, blen, array_start, entry) {
    if (load8(body + array_start) != 91) { return 0; }   # not '['
    var pos = array_start + 1;
    var depth = 0;
    var in_string = 0;
    var escaped = 0;
    var obj_start = 0 - 1;
    var count = 0;
    var go = 1;
    while (go == 1) {
        if (pos >= blen) { go = 0; }
        if (go == 1) {
            var c = load8(body + pos);
            if (in_string == 1) {
                if (escaped == 1) {
                    escaped = 0;
                } else {
                    if (c == 92) { escaped = 1; }
                    if (c == 34) { in_string = 0; }
                }
            } else {
                # Outside any string: handle '{', '}', '"', ']'
                # exactly once per byte. Each handler is mutually
                # exclusive; the prior version had `depth == 0`
                # AND `depth > 0` arms that both fired on a single
                # `{` (depth flipped 0 → 1 then 1 → 2).
                if (c == 34) { in_string = 1; }
                if (c == 123) {
                    if (depth == 0) { obj_start = pos; }
                    depth = depth + 1;
                }
                if (c == 125) {
                    depth = depth - 1;
                    if (depth == 0) {
                        _lsp_diags_extract_one(body, blen, obj_start, pos + 1, entry);
                        count = count + 1;
                        obj_start = 0 - 1;
                    }
                }
                if (c == 93) {
                    if (depth == 0) { go = 0; }
                }
            }
            if (go == 1) { pos = pos + 1; }
        }
    }
    return count;
}

# Extract {line, severity, message} from a single diag object
# bounded by [obj_start, obj_end), append to entry's tuple vec.
# Tolerates missing fields (zero / empty defaults).
fn _lsp_diags_extract_one(body, blen, obj_start, obj_end, entry) {
    if (entry == 0) { return 0; }
    # Lazy-init the tuple vec.
    var v = load64(entry + 40);
    if (v == 0) {
        v = vec_new();
        store64(entry + 40, v);
    }
    # Find "start":{ then nearest "line":N within the object.
    var start_marker = "\"start\":{";
    var sp = _lsp_diags_find(body, obj_end, obj_start, start_marker);
    var line = 0;
    if (sp >= 0) {
        var line_marker = "\"line\":";
        var lp = _lsp_diags_find(body, obj_end, sp, line_marker);
        if (lp >= 0) {
            var np_slot[8];
            store64(&np_slot, 0);
            var n = _lsp_diag_parse_int(body, obj_end, lp + 7, &np_slot);
            if (n >= 0) { line = n + 1; }   # LSP 0-indexed → cyim 1-indexed
        }
    }
    # Find "severity":N.
    var sev_marker = "\"severity\":";
    var sevp = _lsp_diags_find(body, obj_end, obj_start, sev_marker);
    var sev = 0;
    if (sevp >= 0) {
        var np_slot2[8];
        store64(&np_slot2, 0);
        var sv = _lsp_diag_parse_int(body, obj_end, sevp + 11, &np_slot2);
        if (sv >= 0) { sev = sv; }
    }
    # Find "message":"..." — handle escapes.
    var msg_marker = "\"message\":\"";
    var mp = _lsp_diags_find(body, obj_end, obj_start, msg_marker);
    var msg = 0;
    if (mp >= 0) {
        var ep_slot[8];
        store64(&ep_slot, 0);
        msg = _lsp_diag_parse_string(body, obj_end, mp + 11, &ep_slot);
    }
    var t = _lsp_diag_tuple_new(line, sev, msg);
    if (t != 0) { vec_push(v, t); }
    return 0;
}

# === Public: handle a single inbound frame ===

# Returns 1 if the frame was a publishDiagnostics and we updated
# state; 0 otherwise (other notification kinds get ignored at
# v0.5.0).
fn lsp_diags_handle_frame(body, body_len) {
    var method_marker = "\"method\":\"textDocument/publishDiagnostics\"";
    if (_lsp_diags_find(body, body_len, 0, method_marker) < 0) {
        return 0;
    }
    var uri = _lsp_diags_extract_uri(body, body_len);
    if (uri == 0) { return 0; }
    var entry = _lsp_diags_get_or_create(uri);
    if (entry == 0) { return 0; }
    _lsp_diags_reset(entry);
    var c1 = _lsp_diags_count_pattern(body, body_len, "\"severity\":1");
    var c2 = _lsp_diags_count_pattern(body, body_len, "\"severity\":2");
    var c3 = _lsp_diags_count_pattern(body, body_len, "\"severity\":3");
    var c4 = _lsp_diags_count_pattern(body, body_len, "\"severity\":4");
    store64(entry + 8,  c1);
    store64(entry + 16, c2);
    store64(entry + 24, c3);
    store64(entry + 32, c4);
    # v0.5.1: walk the diagnostics array, append per-diag tuples.
    var arr_marker = "\"diagnostics\":[";
    var ap = _lsp_diags_find(body, body_len, 0, arr_marker);
    if (ap >= 0) {
        # The `[` is at ap + len(marker) - 1 = ap + 14 (since
        # marker ends with `[`).
        _lsp_diags_walk_array(body, body_len, ap + 14, entry);
    }
    return 1;
}

# === Status segment formatter ===
#
# Render "E:n W:m I:k H:l" into `out_buf` (heap, caller-owned).
# Categories with zero count are omitted. Returns bytes written
# (excluding trailing NUL); 0 if all four counts are zero.
#
# Used by the status_segment plugin hook. Returning 0 (no segment)
# tells cyim's render layer to omit the divider — the segment
# only appears when there are actual diagnostics.

fn _lsp_diags_itoa_into(n, dst, off) {
    if (n == 0) {
        store8(dst + off, 48);
        return off + 1;
    }
    # Reverse-fill via a temp buffer.
    var tmp[24];
    var tlen = 0;
    var v = n;
    while (v > 0) {
        store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
        v = v / 10;
        tlen = tlen + 1;
    }
    var i = 0;
    while (i < tlen) {
        store8(dst + off + i, load8(&tmp + tlen - 1 - i));
        i = i + 1;
    }
    return off + tlen;
}

fn _lsp_diags_emit_cat(label, n, dst, off, written_any) {
    if (n == 0) { return off; }
    if (written_any > 0) {
        store8(dst + off, 32);   # space
        off = off + 1;
    }
    var ll = strlen(label);
    var i = 0;
    while (i < ll) {
        store8(dst + off + i, load8(label + i));
        i = i + 1;
    }
    off = off + ll;
    return _lsp_diags_itoa_into(n, dst, off);
}

fn lsp_diags_format_status(entry, out_buf, cap) {
    if (entry == 0) { return 0; }
    if (cap < 32) { return 0; }
    var e = load64(entry + 8);
    var w = load64(entry + 16);
    var i = load64(entry + 24);
    var h = load64(entry + 32);
    if (e == 0) {
        if (w == 0) {
            if (i == 0) {
                if (h == 0) { return 0; }
            }
        }
    }
    var off = 0;
    var any = 0;
    if (e > 0) {
        off = _lsp_diags_emit_cat("E:", e, out_buf, off, any);
        any = 1;
    }
    if (w > 0) {
        off = _lsp_diags_emit_cat("W:", w, out_buf, off, any);
        any = 1;
    }
    if (i > 0) {
        off = _lsp_diags_emit_cat("I:", i, out_buf, off, any);
        any = 1;
    }
    if (h > 0) {
        off = _lsp_diags_emit_cat("H:", h, out_buf, off, any);
        any = 1;
    }
    store8(out_buf + off, 0);
    return off;
}

# --- lsp_client.cyr ---

# lsp_client.cyr — LSP protocol client (v0.3.0)
#
# High-level layer above subprocess.cyr + jsonrpc.cyr:
#   - Spawns cyrius-lsp (or any LSP server cmd) and runs the
#     `initialize` handshake
#   - Owns the per-process state: proc handle (pid + pipe fds),
#     last received frame, attached/detached flag
#   - Issues `shutdown` + `exit` cleanly when stopping
#
# Protocol shape (LSP §3.7 LifeCycle):
#   1. Client → Server: `initialize` request (id=1)
#   2. Server → Client: `initialize` response (id=1, result has capabilities)
#   3. Client → Server: `initialized` notification
#   4. … traffic …
#   5. Client → Server: `shutdown` request
#   6. Server → Client: `shutdown` response
#   7. Client → Server: `exit` notification
#   8. Server exits
#
# v0.3.0 implements 1, 2, 3, 5, 6, 7, 8. Step 4 (real document
# sync via post_save / post_change hooks) lands in v0.4.0 / M3.
#
# Public surface (frozen for v0.3.x):
#   lsp_client_running()                  -> pid (>0 if attached, 0 otherwise)
#   lsp_client_describe()                 -> cstring
#   lsp_client_start(cmd_path)            -> 0 / -1
#   lsp_client_stop()                     -> 0 / -1
#   lsp_client_proc()                     -> proc handle (or 0)

# Per-client state. _lsp_proc holds the subprocess handle; null
# means "no server attached". Single-server design — multi-server
# multiplexing is post-v1.0 per the cyim-lsp roadmap "Out of scope".
var _lsp_proc = 0;

# Static description buffer, regenerated on each `lsp_client_describe`
# call. 64 bytes accommodates "cyrius-lsp pid=<i64-decimal> (running)"
# or the "(not attached)" alternative.
var _lsp_describe_buf[64];

# Public: returns the child pid if attached, 0 if not. Reads past
# `lsp_proc_close` are safe — the close marks pid = -1, and we
# treat any non-positive value as detached.
fn lsp_client_running() {
    if (_lsp_proc == 0) { return 0; }
    var pid = lsp_proc_pid(_lsp_proc);
    if (pid <= 0) { return 0; }
    return pid;
}

fn lsp_client_proc() {
    return _lsp_proc;
}

# Render a human-readable description into `_lsp_describe_buf` and
# return a pointer to it. Used by:
#   - main.cyr's standalone driver (smoke output)
#   - the v0.5.0+ `:lsp-status` ex-command
fn lsp_client_describe() {
    var pid = lsp_client_running();
    if (pid == 0) {
        var s = "(not attached)";
        var sl = strlen(s);
        var i = 0;
        while (i < sl) {
            store8(&_lsp_describe_buf + i, load8(s + i));
            i = i + 1;
        }
        store8(&_lsp_describe_buf + sl, 0);
        return &_lsp_describe_buf;
    }
    # "cyrius-lsp pid=" + decimal pid
    var prefix = "cyrius-lsp pid=";
    var pl = strlen(prefix);
    var off = 0;
    while (off < pl) {
        store8(&_lsp_describe_buf + off, load8(prefix + off));
        off = off + 1;
    }
    # Inline itoa for pid (mirrors trailing_ws's pattern in cyim).
    var tmp[24];
    var tlen = 0;
    var v = pid;
    if (v == 0) {
        store8(&tmp, 48);
        tlen = 1;
    } else {
        while (v > 0) {
            store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
            v = v / 10;
            tlen = tlen + 1;
        }
    }
    var j = 0;
    while (j < tlen) {
        store8(&_lsp_describe_buf + off, load8(&tmp + tlen - 1 - j));
        off = off + 1;
        j = j + 1;
    }
    store8(&_lsp_describe_buf + off, 0);
    return &_lsp_describe_buf;
}

# Read one framed JSON-RPC message from the server. Allocates a
# heap buffer, accumulates bytes via lsp_proc_recv, calls
# jsonrpc_parse_frame after each read until a complete frame is
# present (or error / EOF).
#
# Writes body offset + length to *off_out / *len_out.
# Returns the buffer pointer on success, 0 on error (alloc fail,
# malformed frame, EOF mid-frame, oversized frame).
#
# v0.3.0 uses an 8 KB buffer — handles initialize + shutdown
# responses (typically <2 KB). v0.4.0+ may need to grow for
# publishDiagnostics on large files; that's a wrap-and-grow
# refinement.
fn _lsp_recv_frame(off_out, len_out) {
    if (_lsp_proc == 0) { return 0; }
    var cap = 8192;
    var buf = alloc(cap);
    if (buf == 0) { return 0; }
    var total = 0;
    var go = 1;
    while (go == 1) {
        if (total >= cap) {
            # Frame larger than v0.3.0 buffer cap.
            return 0;
        }
        var n = lsp_proc_recv(_lsp_proc, buf + total, cap - total);
        if (n <= 0) {
            # 0 = EOF mid-frame, < 0 = error.
            return 0;
        }
        total = total + n;
        var off_slot[8];
        store64(&off_slot, 0);
        var len_slot[8];
        store64(&len_slot, 0);
        var rc = jsonrpc_parse_frame(buf, total, &off_slot, &len_slot);
        if (rc == 1) {
            store64(off_out, load64(&off_slot));
            store64(len_out, load64(&len_slot));
            return buf;
        }
        if (rc == 0 - 1) {
            return 0;
        }
        # rc == 0: incomplete; loop and read more.
    }
    return 0;
}

# Send `msg` (a framed JSON-RPC cstring) to the server, writing
# all bytes (handling short writes). Returns 0 on success, -1 on
# error.
fn _lsp_send_all(msg) {
    if (_lsp_proc == 0) { return 0 - 1; }
    var total = strlen(msg);
    var sent = 0;
    var go = 1;
    while (go == 1) {
        if (sent >= total) { go = 0; }
        if (go == 1) {
            var n = lsp_proc_send(_lsp_proc, msg + sent, total - sent);
            if (n <= 0) { return 0 - 1; }
            sent = sent + n;
        }
    }
    return 0;
}

# Send the LSP `initialize` request and wait for the response.
# Discards capabilities for v0.3.0 (just verifies the response
# parses cleanly). v0.4.0+ stores capabilities for feature
# negotiation (e.g. did we get definitionProvider?).
fn _lsp_initialize() {
    var id = jsonrpc_next_id();
    # Minimal initialize params per LSP §3.7.1. processId=null is
    # accepted by cyrius-lsp; rootUri=null too. capabilities={}
    # signals "client supports nothing optional".
    var params = "{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}";
    var msg = jsonrpc_build_request(id, "initialize", params);
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    # Read response. v0.3.0 just verifies a frame arrives — no
    # capability inspection.
    var off_slot[8];
    store64(&off_slot, 0);
    var len_slot[8];
    store64(&len_slot, 0);
    var resp = _lsp_recv_frame(&off_slot, &len_slot);
    if (resp == 0) { return 0 - 1; }
    # Send `initialized` notification — LSP requires this to
    # signal "ready to send didOpen" etc. Empty params per spec.
    var notif = jsonrpc_build_notification("initialized", "{}");
    if (notif == 0) { return 0 - 1; }
    if (_lsp_send_all(notif) != 0) { return 0 - 1; }
    # v0.5.0: switch the read fd to non-blocking so the periodic
    # frame drain (called from cyim's diagnostic_provider hook
    # per render frame) can return immediately when no server-
    # pushed notifications are waiting. The handshake above used
    # blocking reads — once the protocol is established and the
    # only inbound traffic is async notifications (publishDiagnostics
    # etc.), non-blocking is the right mode.
    lsp_proc_set_nonblock(_lsp_proc);
    return 0;
}

# Drain available frames from the server. Reads bytes non-blocking,
# accumulates into a buffer, parses complete frames as they arrive,
# and dispatches each to `handler_fp(body_ptr, body_len)`. Stops
# when the read fd has no more bytes available right now (EAGAIN).
#
# Returns the number of frames successfully dispatched. -1 on
# unrecoverable error (alloc / read).
#
# Buffer management: 16 KB scratch per call. Frames larger than
# that get rejected by jsonrpc_parse_frame's incomplete-buffer
# branch — same cap as the v0.3.0 _lsp_recv_frame; v0.5.x can
# grow if real-world diagnostics push past it.
fn _lsp_drain_frames(handler_fp) {
    if (_lsp_proc == 0) { return 0; }
    var cap = 16384;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - 1; }
    var total = 0;
    var dispatched = 0;
    var go = 1;
    while (go == 1) {
        if (total >= cap) { go = 0; }
        if (go == 1) {
            var n = lsp_proc_recv_nb(_lsp_proc, buf + total, cap - total);
            if (n == 0 - 2) {
                # EAGAIN: no more data right now. Try parsing
                # what we have, then exit.
                go = 0;
            }
            if (n == 0) {
                # EOF: server exited; bail.
                return dispatched;
            }
            if (n < 0) {
                if (n != 0 - 2) { return 0 - 1; }
            }
            if (n > 0) { total = total + n; }
        }
        # Parse + dispatch every complete frame in [0, total).
        var parse_more = 1;
        while (parse_more == 1) {
            var off_slot[8];
            store64(&off_slot, 0);
            var len_slot[8];
            store64(&len_slot, 0);
            var rc = jsonrpc_parse_frame(buf, total, &off_slot, &len_slot);
            if (rc == 1) {
                var body_off = load64(&off_slot);
                var body_len = load64(&len_slot);
                fncall2(handler_fp, buf + body_off, body_len);
                dispatched = dispatched + 1;
                # Shift remaining bytes left; we may have started
                # the next frame's header.
                var remaining = total - (body_off + body_len);
                if (remaining > 0) {
                    var i = 0;
                    while (i < remaining) {
                        store8(buf + i, load8(buf + body_off + body_len + i));
                        i = i + 1;
                    }
                }
                total = remaining;
            }
            if (rc != 1) { parse_more = 0; }
            if (rc == 0 - 1) {
                # Malformed: drop the buffer to recover. Future
                # bytes start fresh.
                total = 0;
            }
        }
    }
    return dispatched;
}

# === v0.6.0: synchronous request/response helper ===
#
# `_lsp_request_sync` sends a JSON-RPC request and polls the drain
# until a response arrives with the matching id, or until
# `max_iters` polling cycles elapse (rough timeout — each cycle
# does one non-blocking read attempt + tight loop).
#
# Used by navigation (textDocument/definition, references) where
# the user presses a key / runs an ex-command and expects a
# result without returning to the editor's render loop. LSP
# responses to definition queries from cyrius-lsp typically
# arrive within a few ms; max_iters of 1000 (with a tight inner
# loop) gives ample headroom without freezing cyim if the server
# is slow / dead.
#
# Notification handlers (publishDiagnostics) registered with
# `_lsp_drain_frames` still fire during the wait — non-response
# frames just go through the normal handler chain.
#
# Returns the body buffer + sets *body_off_out / *body_len_out
# on success. 0 on timeout / error.

# State for matching incoming responses to the in-flight request.
var _lsp_pending_id     = 0;
var _lsp_pending_body   = 0;
var _lsp_pending_off    = 0;
var _lsp_pending_len    = 0;

# Frame handler invoked by drain when waiting for a response. If
# the frame's `"id":N` matches the pending request id, capture
# the body for the caller and clear the pending slot. Other
# frames (notifications) get dispatched to lsp_diags_handle_frame
# so publishDiagnostics still updates state during sync waits.
fn _lsp_response_handler(body, body_len) {
    if (_lsp_pending_id == 0) {
        # Not currently waiting — let other handlers (diags) see it.
        lsp_diags_handle_frame(body, body_len);
        return 0;
    }
    # Look for `"id":<n>` (response). Bytescan because we don't
    # have the json stdlib parser in this hot path.
    var id_marker = "\"id\":";
    var ip = _lsp_diags_find(body, body_len, 0, id_marker);
    if (ip < 0) {
        # No id field → notification (publishDiagnostics, etc).
        lsp_diags_handle_frame(body, body_len);
        return 0;
    }
    var np_slot[8];
    store64(&np_slot, 0);
    var fid = _lsp_diag_parse_int(body, body_len, ip + 5, &np_slot);
    if (fid != _lsp_pending_id) {
        # Response to some other request, or the id is wrong.
        lsp_diags_handle_frame(body, body_len);
        return 0;
    }
    # Match: capture body for the caller. Allocate copy so the
    # frame buffer (drain's scratch) can be reused.
    var copy = alloc(body_len + 1);
    if (copy == 0) { return 0; }
    var i = 0;
    while (i < body_len) {
        store8(copy + i, load8(body + i));
        i = i + 1;
    }
    store8(copy + body_len, 0);
    _lsp_pending_body = copy;
    _lsp_pending_off  = 0;
    _lsp_pending_len  = body_len;
    _lsp_pending_id   = 0;   # clear pending — caller picks up
    return 0;
}

# Send `request_msg` (a framed JSON-RPC cstring built by
# jsonrpc_build_request) and poll until the response with
# `expected_id` arrives or `max_iters` polling cycles elapse.
# Returns response body cstring (heap-owned, length in *len_out)
# or 0 on timeout / error.
fn _lsp_request_sync(request_msg, expected_id, body_len_out, max_iters) {
    if (_lsp_proc == 0) { return 0; }
    if (_lsp_pending_id != 0) {
        # Already waiting on a different request — concurrent
        # sync requests not supported in v0.6.0.
        return 0;
    }
    _lsp_pending_id   = expected_id;
    _lsp_pending_body = 0;
    _lsp_pending_len  = 0;
    if (_lsp_send_all(request_msg) != 0) {
        _lsp_pending_id = 0;
        return 0;
    }
    var iter = 0;
    var go = 1;
    while (go == 1) {
        if (iter >= max_iters) { go = 0; }
        if (go == 1) {
            _lsp_drain_frames(&_lsp_response_handler);
            if (_lsp_pending_body != 0) {
                # Response arrived (handler captured it).
                store64(body_len_out, _lsp_pending_len);
                var b = _lsp_pending_body;
                _lsp_pending_body = 0;
                _lsp_pending_len  = 0;
                return b;
            }
            iter = iter + 1;
        }
    }
    # Timeout: clear pending so future calls can retry.
    _lsp_pending_id = 0;
    return 0;
}

# Send `shutdown` request, await response, then send `exit`
# notification. After this the server should exit on its own;
# lsp_proc_close still calls sys_waitpid to reap.
fn _lsp_shutdown_handshake() {
    var id = jsonrpc_next_id();
    var msg = jsonrpc_build_request(id, "shutdown", "null");
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    var off_slot[8];
    store64(&off_slot, 0);
    var len_slot[8];
    store64(&len_slot, 0);
    var resp = _lsp_recv_frame(&off_slot, &len_slot);
    if (resp == 0) {
        # Server may have crashed mid-shutdown; not fatal.
        return 0 - 1;
    }
    var exit_notif = jsonrpc_build_notification("exit", "null");
    if (exit_notif == 0) { return 0 - 1; }
    if (_lsp_send_all(exit_notif) != 0) { return 0 - 1; }
    return 0;
}

# Spawn + initialize handshake. Internal entry point — public
# variants vary the cmd argv shape.
fn _lsp_client_start_with(cmd, arg1, arg2) {
    if (_lsp_proc != 0) {
        # Already attached — caller should stop before restart.
        return 0 - 1;
    }
    var p = lsp_proc_spawn(cmd, arg1, arg2);
    if (p == 0) { return 0 - 1; }
    _lsp_proc = p;
    var rc = _lsp_initialize();
    if (rc != 0) {
        # Handshake failed; clean up.
        lsp_proc_close(_lsp_proc);
        _lsp_proc = 0;
        return 0 - 1;
    }
    return 0;
}

# Spawn `cmd_path` (absolute path expected) and run the LSP
# `initialize` handshake. Returns 0 on success, -1 on any failure
# (already running, spawn failed, handshake failed).
fn lsp_client_start(cmd_path) {
    return _lsp_client_start_with(cmd_path, 0, 0);
}

# Spawn `cyrius-lsp` via PATH lookup (`/usr/bin/env cyrius-lsp`)
# and run the initialize handshake. The default entry point used
# by lsp_documents' lazy-start path. Returns 0 on success, -1 on
# any failure.
fn lsp_client_start_default() {
    return _lsp_client_start_with("/usr/bin/env", "cyrius-lsp", 0);
}

# Run shutdown handshake then close + reap. Idempotent — safe to
# call when no server is attached. Returns 0 in both cases (the
# handshake-failure path still closes pipes + reaps).
fn lsp_client_stop() {
    if (_lsp_proc == 0) { return 0; }
    _lsp_shutdown_handshake();
    lsp_proc_close(_lsp_proc);
    _lsp_proc = 0;
    return 0;
}

# --- lsp_state.cyr ---

# lsp_state.cyr — per-buffer LSP document state (v0.4.0)
#
# LSP requires per-document tracking:
#   - URI (file:///...) — sent in every notification
#   - version (i64) — incremented per didChange (LSP §3.7.5
#     `versionedTextDocumentIdentifier`)
#   - opened flag — has didOpen been sent? (controls
#     didOpen-vs-didChange routing on first post_change)
#
# This file owns the table of these entries, indexed by cyim
# buffer pointer. Linear vec scan for lookup — typical use is
# 1-10 open buffers, well below where a hashmap pays off.
#
# Public surface (frozen for v0.4.x):
#   lsp_state_init()                      -> 0
#   lsp_state_lookup(b)                   -> entry ptr or 0
#   lsp_state_create(b, uri)              -> entry ptr or 0
#   lsp_state_bump_version(entry)         -> new version
#   lsp_state_mark_opened(entry)          -> 0
#   lsp_state_is_opened(entry)            -> 0/1
#   lsp_state_version(entry)              -> i64
#   lsp_state_uri(entry)                  -> cstring
#   lsp_state_buf(entry)                  -> buf ptr
#
# Entry shape (32 B):
#   +0   buf_ptr        (cyim buffer pointer; the lookup key)
#   +8   version        (i64; starts at 0, bumped to 1 on first
#                        didOpen/didChange)
#   +16  opened         (0 = didOpen not yet sent; 1 = sent)
#   +24  uri            (NUL-term cstring; heap-allocated, owned
#                        by entry; lives for process lifetime)

var _lsp_state_table = 0;

fn lsp_state_init() {
    if (_lsp_state_table == 0) { _lsp_state_table = vec_new(); }
    return 0;
}

# Lookup an existing entry by buf_ptr. Returns the entry pointer
# or 0 if not found. Call lsp_state_create to register new buffers.
fn lsp_state_lookup(b) {
    if (_lsp_state_table == 0) { return 0; }
    var n = vec_len(_lsp_state_table);
    var i = 0;
    while (i < n) {
        var e = vec_get(_lsp_state_table, i);
        if (e != 0) {
            if (load64(e) == b) { return e; }
        }
        i = i + 1;
    }
    return 0;
}

# Create a new entry for buf_ptr `b` with the given URI. Returns
# the entry pointer or 0 on alloc failure. Caller should check
# lsp_state_lookup first to avoid duplicates.
fn lsp_state_create(b, uri) {
    if (_lsp_state_table == 0) { lsp_state_init(); }
    var e = alloc(32);
    if (e == 0) { return 0; }
    store64(e,      b);
    store64(e + 8,  0);     # version
    store64(e + 16, 0);     # opened
    store64(e + 24, uri);
    vec_push(_lsp_state_table, e);
    return e;
}

# Increment the entry's version and return the new value. LSP
# spec recommends version 1 for the first didOpen/didChange;
# starting at 0 and bumping before send gives 1 on the first
# call.
fn lsp_state_bump_version(entry) {
    if (entry == 0) { return 0; }
    var v = load64(entry + 8) + 1;
    store64(entry + 8, v);
    return v;
}

# Set the opened flag. Called by lsp_documents after didOpen sent.
fn lsp_state_mark_opened(entry) {
    if (entry == 0) { return 0; }
    store64(entry + 16, 1);
    return 0;
}

fn lsp_state_is_opened(entry) {
    if (entry == 0) { return 0; }
    return load64(entry + 16);
}

fn lsp_state_version(entry) {
    if (entry == 0) { return 0; }
    return load64(entry + 8);
}

fn lsp_state_uri(entry) {
    if (entry == 0) { return 0; }
    return load64(entry + 24);
}

fn lsp_state_buf(entry) {
    if (entry == 0) { return 0; }
    return load64(entry);
}

# Count of registered buffers — used by `:lsp-status` (v0.5.0+)
# and tests.
fn lsp_state_count() {
    if (_lsp_state_table == 0) { return 0; }
    return vec_len(_lsp_state_table);
}

# --- lsp_position.cyr ---

# lsp_position.cyr — buffer position helpers + Location parser (v0.6.0)
#
# LSP works in line / character coordinates (LSP §3.7);
# cyim works in byte offsets within a gap buffer. This file
# converts between them and parses LSP `Location` /
# `LocationLink` response shapes.
#
# Public surface (frozen for v0.6.x):
#   _lsp_pos_offset_to_lc(b, off, line_out, char_out) -> 0
#   _lsp_pos_lc_to_offset(b, line, character)         -> i64 offset
#   _lsp_pos_extract_uri(body, blen)                  -> cstring or 0
#   _lsp_pos_extract_first_line(body, blen)           -> i64 line or -1
#   _lsp_pos_extract_first_character(body, blen)      -> i64 char or -1
#
# Position helpers reference cyim's plugin ABI surface (`buf_get`,
# `buf_len`) — they only resolve at fold-in. Stub at standalone-
# test time same as lsp_documents.cyr.
#
# The Location-parser helpers don't reference cyim ABI; they just
# bytescan. Testable standalone.

# === Position conversions ===
#
# Convert a byte offset to (line, character) by counting newlines
# from the start of the buffer. line is 0-indexed for LSP output;
# character is bytes-from-start-of-line (cyim is byte-oriented;
# UTF-16 code-unit conversion per LSP spec is deferred — most
# code is ASCII, where bytes == characters).
#
# Writes to *line_out and *char_out via store64. Returns 0
# always (no failure modes; out-of-range offsets just return
# the line/character at buffer end).

fn _lsp_pos_offset_to_lc(b, off, line_out, char_out) {
    if (b == 0) {
        store64(line_out, 0);
        store64(char_out, 0);
        return 0;
    }
    var blen = buf_len(b);
    if (off > blen) { off = blen; }
    var line = 0;
    var ch = 0;
    var i = 0;
    while (i < off) {
        if (buf_get(b, i) == 10) {
            line = line + 1;
            ch = 0;
        }
        if (buf_get(b, i) != 10) {
            ch = ch + 1;
        }
        i = i + 1;
    }
    store64(line_out, line);
    store64(char_out, ch);
    return 0;
}

# Convert (line, character) to a byte offset. line is 0-indexed
# (LSP convention). character is byte offset from start of line.
# Returns the offset; clamped to [0, buf_len].

fn _lsp_pos_lc_to_offset(b, line, character) {
    if (b == 0) { return 0; }
    var blen = buf_len(b);
    var off = 0;
    var current_line = 0;
    var go = 1;
    while (go == 1) {
        if (current_line >= line) { go = 0; }
        if (off >= blen) { go = 0; }
        if (go == 1) {
            if (buf_get(b, off) == 10) {
                current_line = current_line + 1;
            }
            off = off + 1;
        }
    }
    # off now points at start of `line`. Add character.
    var target = off + character;
    if (target > blen) { target = blen; }
    return target;
}

# === Location response parsing ===
#
# textDocument/definition response shapes (LSP §3.10.7):
#   - Location:      {"uri":"...","range":{"start":{"line":N,"character":M},"end":...}}
#   - Location[]:    array of the above (peek the first)
#   - LocationLink[]: similar with targetUri / targetRange (post-3.14)
#
# v0.6.0 supports Location and Location[] (peeks the first
# entry). LocationLink and the empty/null result get treated as
# "not found".
#
# `_lsp_pos_extract_uri(body, blen)` finds `"uri":"..."` and
# returns the URI as a fresh cstring. (Same shape as
# lsp_diags's `_lsp_diags_extract_uri` but lives here so
# navigation doesn't depend on the diags module.)

fn _lsp_pos_extract_uri(body, blen) {
    var marker = "\"uri\":\"";
    var pos = _lsp_diags_find(body, blen, 0, marker);
    if (pos < 0) { return 0; }
    var start = pos + 7;
    var end = start;
    var go = 1;
    while (go == 1) {
        if (end >= blen) { return 0; }
        if (load8(body + end) == 34) { go = 0; }
        if (go == 1) { end = end + 1; }
    }
    var ul = end - start;
    var out = alloc(ul + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < ul) {
        store8(out + i, load8(body + start + i));
        i = i + 1;
    }
    store8(out + ul, 0);
    return out;
}

# Find the first `"start":{"line":N` and return N (LSP
# 0-indexed). Returns -1 if not found.

fn _lsp_pos_extract_first_line(body, blen) {
    var marker = "\"start\":{";
    var sp = _lsp_diags_find(body, blen, 0, marker);
    if (sp < 0) { return 0 - 1; }
    var line_marker = "\"line\":";
    var lp = _lsp_diags_find(body, blen, sp, line_marker);
    if (lp < 0) { return 0 - 1; }
    var np_slot[8];
    store64(&np_slot, 0);
    return _lsp_diag_parse_int(body, blen, lp + 7, &np_slot);
}

# Find the first `"start":{...,"character":N` and return N (LSP
# 0-indexed). Returns -1 if not found.

fn _lsp_pos_extract_first_character(body, blen) {
    var marker = "\"start\":{";
    var sp = _lsp_diags_find(body, blen, 0, marker);
    if (sp < 0) { return 0 - 1; }
    var char_marker = "\"character\":";
    var cp = _lsp_diags_find(body, blen, sp, char_marker);
    if (cp < 0) { return 0 - 1; }
    var np_slot[8];
    store64(&np_slot, 0);
    return _lsp_diag_parse_int(body, blen, cp + 12, &np_slot);
}

# --- lsp_documents.cyr ---

# lsp_documents.cyr — LSP document-sync handlers (v0.4.0)
#
# Responds to cyim's plugin hooks by sending the appropriate LSP
# notifications:
#   post_change_hook(s)       → textDocument/didChange (or didOpen
#                                if first interaction with this buffer)
#   post_save_hook(s, path)   → textDocument/didSave
#
# Auto-starts cyrius-lsp on first interaction with a .cyr buffer
# (lazy-start). Subsequent hooks reuse the running server. If
# start fails, hooks no-op silently — cyim-lsp degrades to
# "no server attached" without breaking the editor.
#
# Buffer filter: v0.4.0 only sends notifications for `.cyr` files.
# Other languages get skipped. Multi-language support is post-v1.0.
#
# Standalone-build hygiene: this file references cyim's plugin ABI
# surface (`editor_buf`, `editor_file_path`, `buf_len`, `buf_get`)
# which only resolves at fold-in into cyim's compilation unit.
# main.cyr does NOT include this file; it's only in [lib].modules.

# === JSON string escape ===
#
# Buffer text needs JSON-string-aware escaping before embedding
# in a `text` field. Encodes the 7 short escapes (\\, \", \b,
# \f, \n, \r, \t) and `\u00XX` for other control bytes (< 0x20).
# Printable ASCII passes through; non-ASCII bytes pass through
# as-is (assumes UTF-8-clean input — the typical cyim/cyrius case).

# Encode one source byte into dst[o..]. Returns new offset, or
# -1 if dst would overflow dst_cap. Worst case: 6 bytes (\u00XX).
fn _lsp_jesc_byte(c, dst, o, dst_cap) {
    if (c == 92) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 92);
        return o + 2;
    }
    if (c == 34) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 34);
        return o + 2;
    }
    if (c == 10) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 110);
        return o + 2;
    }
    if (c == 13) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 114);
        return o + 2;
    }
    if (c == 9) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 116);
        return o + 2;
    }
    if (c == 8) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 98);
        return o + 2;
    }
    if (c == 12) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 102);
        return o + 2;
    }
    if (c < 32) {
        # \u00XX — six bytes total. Escape any other control byte
        # we didn't catch above. JSON spec requires escaping all
        # bytes < 0x20 inside string literals.
        if (o + 6 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 117);
        store8(dst + o + 2, 48);
        store8(dst + o + 3, 48);
        var hi = c / 16;
        var lo = c - hi * 16;
        if (hi < 10) { store8(dst + o + 4, 48 + hi); }
        if (hi >= 10) { store8(dst + o + 4, 87 + hi); }
        if (lo < 10) { store8(dst + o + 5, 48 + lo); }
        if (lo >= 10) { store8(dst + o + 5, 87 + lo); }
        return o + 6;
    }
    if (o + 1 > dst_cap) { return 0 - 1; }
    store8(dst + o, c);
    return o + 1;
}

# Materialise a cyim gap buffer's contents into a JSON-escaped
# heap cstring. Returns a NUL-term cstring suitable for embedding
# inside `"..."` in a JSON message body. 0 on alloc failure.
fn _lsp_buf_to_json_string(b) {
    if (b == 0) { return 0; }
    var blen = buf_len(b);
    # Worst case: every byte expands to 6 chars (\u00XX). Plus
    # NUL. Allocate the upper bound — cheap for plugin scale.
    var cap = blen * 6 + 1;
    var dst = alloc(cap);
    if (dst == 0) { return 0; }
    var o = 0;
    var i = 0;
    while (i < blen) {
        o = _lsp_jesc_byte(buf_get(b, i), dst, o, cap);
        if (o < 0) { return 0; }
        i = i + 1;
    }
    store8(dst + o, 0);
    return dst;
}

# === URI construction ===
#
# Convert a filesystem path to a `file://...` URI. v0.4.0 assumes
# absolute paths (which cyim normally produces — `:e <path>`
# resolves relative paths against cwd before storing). Relative
# paths get the wrong URI; documenting the limitation here rather
# than silently fixing in v0.4.0.

fn _lsp_path_to_uri(path) {
    if (path == 0) { return 0; }
    var pl = strlen(path);
    # "file://" (7) + path + NUL
    var out = alloc(7 + pl + 1);
    if (out == 0) { return 0; }
    var prefix = "file://";
    var i = 0;
    while (i < 7) {
        store8(out + i, load8(prefix + i));
        i = i + 1;
    }
    var j = 0;
    while (j < pl) {
        store8(out + 7 + j, load8(path + j));
        j = j + 1;
    }
    store8(out + 7 + pl, 0);
    return out;
}

# === Filter: only send notifications for cyim/cyrius source ===
#
# v0.4.0 supports only `.cyr` files. Other extensions get
# silently filtered — server doesn't see notifications for them.
# Multi-language is post-v1.0 (per roadmap "Out of scope").

fn _lsp_path_is_cyr(path) {
    if (path == 0) { return 0; }
    var pl = strlen(path);
    if (pl < 4) { return 0; }
    if (load8(path + pl - 4) != 46)  { return 0; }   # '.'
    if (load8(path + pl - 3) != 99)  { return 0; }   # 'c'
    if (load8(path + pl - 2) != 121) { return 0; }   # 'y'
    if (load8(path + pl - 1) != 114) { return 0; }   # 'r'
    return 1;
}

# === Decimal i64 to cstring (mirrors lsp_client.cyr's pattern). ===

fn _lsp_doc_itoa(n) {
    if (n == 0) {
        var z = alloc(2);
        if (z == 0) { return 0; }
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    var tmp[24];
    var tlen = 0;
    var v = n;
    while (v > 0) {
        store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
        v = v / 10;
        tlen = tlen + 1;
    }
    var out = alloc(tlen + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < tlen) {
        store8(out + i, load8(&tmp + tlen - 1 - i));
        i = i + 1;
    }
    store8(out + tlen, 0);
    return out;
}

# === didOpen builder ===
#
# Body shape (LSP §3.7.5):
#   {"textDocument": {
#      "uri": "<uri>",
#      "languageId": "cyrius",
#      "version": <n>,
#      "text": "<escaped text>"
#   }}

fn _lsp_doc_build_did_open_params(uri, version, text_escaped) {
    var ul = strlen(uri);
    var vl_str = _lsp_doc_itoa(version);
    if (vl_str == 0) { return 0; }
    var vl = strlen(vl_str);
    var tl = strlen(text_escaped);
    # Fixed bytes:
    #   {"textDocument":{"uri":"<uri>","languageId":"cyrius","version":<v>,"text":"<text>"}}
    # = 1 + 16 + 1 + 7 + ul + 16 + 6 + vl + 9 + tl + 4 = 60 + ul + vl + tl
    var cap = 80 + ul + vl + tl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\",\"languageId\":\"cyrius\",\"version\":");
    off = _lsp_append(out, off, vl_str);
    off = _lsp_append(out, off, ",\"text\":\"");
    off = _lsp_append(out, off, text_escaped);
    off = _lsp_append(out, off, "\"}}");
    store8(out + off, 0);
    return out;
}

# Append helper (jsonrpc.cyr's _jr_append is internal there;
# duplicate here rather than expose it across files).
fn _lsp_append(dst, off, src) {
    var sl = strlen(src);
    var i = 0;
    while (i < sl) {
        store8(dst + off + i, load8(src + i));
        i = i + 1;
    }
    return off + sl;
}

# === didChange builder ===
#
# Body shape:
#   {"textDocument": {"uri":"<uri>","version":<n>},
#    "contentChanges": [{"text":"<escaped full text>"}]}

fn _lsp_doc_build_did_change_params(uri, version, text_escaped) {
    var ul = strlen(uri);
    var vl_str = _lsp_doc_itoa(version);
    if (vl_str == 0) { return 0; }
    var vl = strlen(vl_str);
    var tl = strlen(text_escaped);
    var cap = 100 + ul + vl + tl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\",\"version\":");
    off = _lsp_append(out, off, vl_str);
    off = _lsp_append(out, off, "},\"contentChanges\":[{\"text\":\"");
    off = _lsp_append(out, off, text_escaped);
    off = _lsp_append(out, off, "\"}]}");
    store8(out + off, 0);
    return out;
}

# === didSave builder ===
#
# Body shape:
#   {"textDocument": {"uri":"<uri>"}}
# (No `text` field — LSP defaults to "save without text" since
# the server already has the latest content from prior didChange.)

fn _lsp_doc_build_did_save_params(uri) {
    var ul = strlen(uri);
    var cap = 40 + ul;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\"}}");
    store8(out + off, 0);
    return out;
}

# === Lazy server start ===
#
# Spawn cyrius-lsp on first .cyr-file interaction. Uses
# `/usr/bin/env cyrius-lsp` so PATH lookup happens (cyrius-lsp
# typically lives at `~/.cyrius/bin/cyrius-lsp` after the
# standard install, on PATH via cyrius's bin link).

fn _lsp_doc_lazy_start() {
    if (lsp_client_running() != 0) { return 0; }
    return lsp_client_start_default();
}

# === Public hook handlers ===

# Send didOpen for a buffer if not already opened. Caller has
# already verified the path is .cyr and looked up / created the
# state entry.
fn _lsp_doc_send_did_open(b, entry) {
    if (lsp_state_is_opened(entry) == 1) { return 0; }
    var uri = lsp_state_uri(entry);
    var v = lsp_state_bump_version(entry);
    var text = _lsp_buf_to_json_string(b);
    if (text == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_open_params(uri, v, text);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didOpen", params);
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    lsp_state_mark_opened(entry);
    return 0;
}

# post_change hook handler — entry point from plugin_init.cyr's
# `_cyim_lsp_post_change(s)`. Filters non-.cyr buffers; lazy-
# starts the server; sends didOpen on first interaction; sends
# didChange thereafter with bumped version + full text payload.
fn lsp_doc_did_change(s) {
    var path = editor_file_path(s);
    if (path == 0) { return 0; }   # scratch buffer
    if (_lsp_path_is_cyr(path) == 0) { return 0; }
    if (_lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var entry = lsp_state_lookup(b);
    if (entry == 0) {
        var uri = _lsp_path_to_uri(path);
        if (uri == 0) { return 0; }
        entry = lsp_state_create(b, uri);
        if (entry == 0) { return 0; }
    }
    if (lsp_state_is_opened(entry) == 0) {
        return _lsp_doc_send_did_open(b, entry);
    }
    # Already opened — send didChange.
    var v = lsp_state_bump_version(entry);
    var uri = lsp_state_uri(entry);
    var text = _lsp_buf_to_json_string(b);
    if (text == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_change_params(uri, v, text);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didChange", params);
    if (msg == 0) { return 0 - 1; }
    return _lsp_send_all(msg);
}

# === v0.6.0: navigation handlers ===
#
# Build the JSON params for textDocument/definition or references.
# Both methods take the same params shape per LSP §3.10.7 / §3.10.8:
#   {"textDocument":{"uri":"<uri>"},"position":{"line":L,"character":C}}
# References has an extra `"context":{"includeDeclaration":true|false}`
# but cyrius-lsp ignores it; v0.6.0 omits for brevity.

fn _lsp_nav_build_params(uri, line, character) {
    var ul = strlen(uri);
    var line_str = _lsp_doc_itoa(line);
    var char_str = _lsp_doc_itoa(character);
    if (line_str == 0) { return 0; }
    if (char_str == 0) { return 0; }
    var ll = strlen(line_str);
    var cl = strlen(char_str);
    var cap = 80 + ul + ll + cl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\"},\"position\":{\"line\":");
    off = _lsp_append(out, off, line_str);
    off = _lsp_append(out, off, ",\"character\":");
    off = _lsp_append(out, off, char_str);
    off = _lsp_append(out, off, "}}");
    store8(out + off, 0);
    return out;
}

# Send a textDocument/<method> request (definition or references)
# for the active buffer's cursor position. Returns the response
# body cstring on success, 0 on failure (no server, not .cyr,
# timeout, etc.). *body_len_out gets the body byte length.
#
# v0.6.0 max_iters = 5000 polling cycles. With ~1µs per non-
# blocking sys_read on an empty pipe that's ~5ms wall-clock —
# enough for cyrius-lsp to compile + respond on small files.
# Larger files / slower servers may need a higher cap; v0.6.x
# can tune.

fn _lsp_nav_request(s, method, body_len_out) {
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    if (_lsp_path_is_cyr(path) == 0) { return 0; }
    if (_lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    # Make sure the server has the latest buffer content. If we
    # haven't sent didOpen / didChange yet for this buffer, the
    # server doesn't know about it and definition/references will
    # come up empty. lsp_doc_did_change (v0.4.0) handles the
    # didOpen-on-first-touch case + didChange refresh.
    lsp_doc_did_change(s);
    var uri = _lsp_path_to_uri(path);
    if (uri == 0) { return 0; }
    var line_slot[8];
    store64(&line_slot, 0);
    var char_slot[8];
    store64(&char_slot, 0);
    _lsp_pos_offset_to_lc(b, editor_cursor(s), &line_slot, &char_slot);
    var params = _lsp_nav_build_params(uri, load64(&line_slot), load64(&char_slot));
    if (params == 0) { return 0; }
    var id = jsonrpc_next_id();
    var msg = jsonrpc_build_request(id, method, params);
    if (msg == 0) { return 0; }
    return _lsp_request_sync(msg, id, body_len_out, 5000);
}

# Public entry — :lsp-goto-def. Sends textDocument/definition,
# parses the first Location result, jumps cursor if same-file.
# Same-file jump only in v0.6.0; cross-file gets a status message.
# Returns 0 on success, -1 on failure (cleanly degrades to "no
# definition found" status for the user).

fn lsp_nav_goto_def(s) {
    var blen_slot[8];
    store64(&blen_slot, 0);
    var resp = _lsp_nav_request(s, "textDocument/definition", &blen_slot);
    if (resp == 0) {
        editor_set_status(s, "lsp: no response from server", 28);
        return 0 - 1;
    }
    var blen = load64(&blen_slot);
    var dest_uri = _lsp_pos_extract_uri(resp, blen);
    if (dest_uri == 0) {
        editor_set_status(s, "lsp: no definition found", 24);
        return 0 - 1;
    }
    var dest_line = _lsp_pos_extract_first_line(resp, blen);
    var dest_char = _lsp_pos_extract_first_character(resp, blen);
    if (dest_line < 0) {
        editor_set_status(s, "lsp: no position in response", 28);
        return 0 - 1;
    }
    if (dest_char < 0) { dest_char = 0; }
    # Same-file check — compare dest_uri to active buffer's URI.
    var active_path = editor_file_path(s);
    var active_uri = _lsp_path_to_uri(active_path);
    if (_streq_dest(dest_uri, active_uri) == 1) {
        var b = editor_buf(s);
        var off = _lsp_pos_lc_to_offset(b, dest_line, dest_char);
        editor_set_cursor(s, off);
        return 0;
    }
    # Cross-file jump: print where the definition lives. v0.6.x
    # adds buf_load_file integration once cyim's plugin ABI for
    # opening files from a plugin context is settled.
    var msg = "lsp: definition in another file (cross-file jump deferred)";
    editor_set_status(s, msg, strlen(msg));
    return 0;
}

# Helper: byte-equality of two NUL-term cstrings. Local to nav
# code; mirrors helpers elsewhere in the codebase.
fn _streq_dest(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# Public entry — :lsp-find-refs. Sends textDocument/references,
# counts results, prints summary in status. v0.6.x will populate
# a quickfix list; v0.6.0 just shows "lsp: N references" so the
# user knows the request worked.

fn lsp_nav_find_refs(s) {
    var blen_slot[8];
    store64(&blen_slot, 0);
    var resp = _lsp_nav_request(s, "textDocument/references", &blen_slot);
    if (resp == 0) {
        editor_set_status(s, "lsp: no response from server", 28);
        return 0 - 1;
    }
    var blen = load64(&blen_slot);
    # Count `"uri":` occurrences as a proxy for reference count.
    var n = _lsp_diags_count_pattern(resp, blen, "\"uri\":");
    var n_str = _lsp_doc_itoa(n);
    if (n_str == 0) { return 0 - 1; }
    var nl = strlen(n_str);
    var prefix = "lsp: ";
    var suffix = " references";
    var pl = strlen(prefix);
    var sl = strlen(suffix);
    var msg = alloc(pl + nl + sl + 1);
    if (msg == 0) { return 0 - 1; }
    var off = 0;
    var i = 0;
    while (i < pl) { store8(msg + off + i, load8(prefix + i)); i = i + 1; }
    off = off + pl;
    i = 0;
    while (i < nl) { store8(msg + off + i, load8(n_str + i)); i = i + 1; }
    off = off + nl;
    i = 0;
    while (i < sl) { store8(msg + off + i, load8(suffix + i)); i = i + 1; }
    off = off + sl;
    store8(msg + off, 0);
    editor_set_status(s, msg, off);
    return 0;
}

# post_save hook handler — entry point from plugin_init.cyr's
# `_cyim_lsp_post_save(s, path)`. Filters non-.cyr; sends
# didOpen on first interaction (rare — usually a didChange
# preceded), then didSave.
fn lsp_doc_did_save(s, path) {
    if (path == 0) { return 0; }
    if (_lsp_path_is_cyr(path) == 0) { return 0; }
    if (_lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var entry = lsp_state_lookup(b);
    if (entry == 0) {
        var uri = _lsp_path_to_uri(path);
        if (uri == 0) { return 0; }
        entry = lsp_state_create(b, uri);
        if (entry == 0) { return 0; }
    }
    if (lsp_state_is_opened(entry) == 0) {
        # Save before any change — emit didOpen first per LSP spec.
        var rc = _lsp_doc_send_did_open(b, entry);
        if (rc != 0) { return rc; }
    }
    var uri = lsp_state_uri(entry);
    var params = _lsp_doc_build_did_save_params(uri);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didSave", params);
    if (msg == 0) { return 0 - 1; }
    return _lsp_send_all(msg);
}

# --- plugin_init.cyr ---

# plugin_init.cyr — cyim plugin ABI consumer
#
# Registers cyim-lsp's hooks against cyim's plugin ABI surface
# (frozen at cyim 1.3.6 / ADR 0004). This file references symbols
# that exist only in cyim's compilation unit:
#   plugin_register_post_save_hook(fp)
#   plugin_register_post_change_hook(fp)
#   plugin_register_status_segment(fp)
#   plugin_register_normal_key(key, fp)
#   plugin_register_ex_command(name, fp)
#   plugin_register_diagnostic_provider(fp)
#
# Standalone cyim-lsp builds (cyrius build src/main.cyr) do NOT
# include this file — the cyrius.cyml [build].entry chain pulls
# only main.cyr's transitive includes, so plugin_init.cyr's
# references stay unresolved until cyrius distlib bundles it into
# dist/cyim-lsp.cyr and cyim's `include "lib/cyim-lsp.cyr"` brings
# it into cyim's TU where the symbols are defined.
#
# This is the canonical sandhi-pattern shape — vyakarana and niyama
# work the same way (their plugin-side files reference downstream
# consumer symbols that resolve at fold-in time).
#
# === Hook callbacks (stubs for v0.1.0) ===
#
# v0.1.0 registers no-op stubs for all six hooks. The real LSP
# implementations land at v0.2.0 = cyim 1.4.1+ once the JSON-RPC
# + subprocess code is in. The stubs prove the wiring shape and
# let cyim 1.4.0 ship with a working `[plugins.cyim-lsp]` entry
# whose effect is "no behavior change yet, but the plugin is
# linked in and ready."

fn _cyim_lsp_post_save(s, path) {
    # v0.4.0: route to lsp_doc_did_save which lazy-starts cyrius-lsp,
    # filters non-.cyr files, and sends textDocument/didSave (with
    # an implicit didOpen first if the buffer hadn't been touched
    # yet).
    return lsp_doc_did_save(s, path);
}

fn _cyim_lsp_post_change(s) {
    # v0.4.0: route to lsp_doc_did_change which handles the same
    # lazy-start + filter chain, then sends textDocument/didChange
    # with the bumped version + full-text payload (or didOpen on
    # first interaction).
    return lsp_doc_did_change(s);
}

# Static buffer for the status-segment cstring. cyim's render
# layer reads this byte-by-byte once per frame, so the buffer
# can be reused — no need to alloc a fresh cstring per call.
# 64 bytes accommodates "E:NNN W:NNN I:NNN H:NNN" with margin.
var _cyim_lsp_status_buf[64];

fn _cyim_lsp_status_segment(s) {
    # v0.5.0: drain pending publishDiagnostics, then look up the
    # active buffer's URI in lsp_diags' map and format counts.
    # Lazy-drain: the diag map only updates from server-pushed
    # notifications, so we drain at the start of each render
    # frame's status pass. (diagnostic_provider fires earlier in
    # the same frame for inline-paint integration in v0.5.1+; for
    # v0.5.0 we drain here since diagnostic_provider stays no-op.)
    if (lsp_client_running() != 0) {
        _lsp_drain_frames(&lsp_diags_handle_frame);
    }
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    var uri = _lsp_path_to_uri(path);
    if (uri == 0) { return 0; }
    var entry = lsp_diags_lookup(uri);
    if (entry == 0) { return 0; }
    var n = lsp_diags_format_status(entry, &_cyim_lsp_status_buf, 64);
    if (n == 0) { return 0; }
    return &_cyim_lsp_status_buf;
}

fn _cyim_lsp_diagnostic_provider(s, b, out_vec) {
    # v0.5.1: walk the per-URI tuple list for the active buffer's
    # URI and push each diag into cyim's render-side out_vec via
    # diag_new(line, severity, msg). cyim's render layer paints
    # them as inline markers / gutter glyphs (concrete shape is
    # cyim-side; cyim-lsp just feeds the data).
    #
    # The drain-of-pending-frames also happens in
    # _cyim_lsp_status_segment which fires later in the same
    # render frame, but the diag map state we walk here
    # reflects the *previous* frame's drained data. In practice
    # that's a one-frame lag — the user types, post_change fires
    # didChange, server replies with publishDiagnostics, drain
    # happens, NEXT frame this hook surfaces them.
    #
    # No drain here ourselves: keeping drain in status_segment
    # avoids two read sweeps per frame. v0.5.x can move drain
    # earlier if the lag bites.
    if (out_vec == 0) { return 0; }
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    var uri = _lsp_path_to_uri(path);
    if (uri == 0) { return 0; }
    var entry = lsp_diags_lookup(uri);
    if (entry == 0) { return 0; }
    var n = lsp_diags_entry_count(entry);
    var i = 0;
    while (i < n) {
        var t = lsp_diags_entry_tuple(entry, i);
        if (t != 0) {
            var line = lsp_diag_tuple_line(t);
            var sev  = lsp_diag_tuple_severity(t);
            var msg  = lsp_diag_tuple_msg(t);
            # LSP severity 1=error, 2=warning, 3=info, 4=hint.
            # cyim's DIAG_* constants are 0=hint, 1=info,
            # 2=warning, 3=error (per cyim ADR 0004 §"Severity
            # constants" — higher is more severe). Translate.
            var cyim_sev = DIAG_INFO;
            if (sev == 1) { cyim_sev = DIAG_ERROR; }
            if (sev == 2) { cyim_sev = DIAG_WARNING; }
            if (sev == 3) { cyim_sev = DIAG_INFO; }
            if (sev == 4) { cyim_sev = DIAG_HINT; }
            if (msg == 0) { msg = "(no message)"; }
            var d = diag_new(line, cyim_sev, msg);
            if (d != 0) { vec_push(out_vec, d); }
        }
        i = i + 1;
    }
    return 0;
}

fn _cyim_lsp_gd(s) {
    # v0.6.0: would call lsp_nav_goto_def(s) but cyim's
    # plugin-prefix-keymap ABI for `g`-prefix sequences (`g d`)
    # isn't wired through plugin_register_normal_key yet — that's
    # cyim 1.4.x work. v0.6.0 ships navigation via the
    # `:lsp-goto-def` ex-command (see _cyim_lsp_ex_goto_def
    # below). This callback stays a stub for now; will activate
    # once cyim's prefix-keymap dispatch lands.
    return ACT_NONE;
}

fn _cyim_lsp_gr(s) {
    # See _cyim_lsp_gd above — same cyim ABI gap. Use
    # `:lsp-find-refs` ex-command instead.
    return ACT_NONE;
}

fn _cyim_lsp_ex_restart(s) {
    # v0.6.0: kill + respawn the cyrius-lsp subprocess. Useful
    # when the server is in a bad state or after upgrading
    # cyrius itself. Re-runs the initialize handshake so cyim
    # remains attached after restart.
    if (lsp_client_running() == 0) {
        # Not running — just start.
        if (lsp_client_start_default() == 0) {
            editor_set_status(s, "lsp: started", 12);
            return 0;
        }
        editor_set_status(s, "lsp: start failed", 17);
        return 0 - 1;
    }
    lsp_client_stop();
    if (lsp_client_start_default() == 0) {
        editor_set_status(s, "lsp: restarted", 14);
        return 0;
    }
    editor_set_status(s, "lsp: restart failed", 19);
    return 0 - 1;
}

# Static buffer for :lsp-status output.
var _cyim_lsp_status_msg[64];

fn _cyim_lsp_ex_status(s) {
    # v0.6.0: print server status — pid + attached/detached.
    # v0.6.x can extend with capability summary + open document
    # count once those are tracked.
    var d = lsp_client_describe();
    var dl = strlen(d);
    var prefix = "lsp: ";
    var pl = strlen(prefix);
    if (pl + dl > 63) { dl = 63 - pl; }
    var i = 0;
    while (i < pl) {
        store8(&_cyim_lsp_status_msg + i, load8(prefix + i));
        i = i + 1;
    }
    var j = 0;
    while (j < dl) {
        store8(&_cyim_lsp_status_msg + pl + j, load8(d + j));
        j = j + 1;
    }
    store8(&_cyim_lsp_status_msg + pl + dl, 0);
    editor_set_status(s, &_cyim_lsp_status_msg, pl + dl);
    return 0;
}

# v0.6.0: navigation ex-commands. `:lsp-goto-def` and
# `:lsp-find-refs` route through lsp_documents' navigation
# handlers. Ex-command form chosen because cyim's
# plugin-prefix-keymap ABI for `g d` / `g r` isn't yet wired.

fn _cyim_lsp_ex_goto_def(s) {
    return lsp_nav_goto_def(s);
}

fn _cyim_lsp_ex_find_refs(s) {
    return lsp_nav_find_refs(s);
}

# Public entry point — called from cyim's main() after plugin_init()
# and trailing_ws_init() (or whatever order main.cyr establishes).
# Idempotent: cyim's plugin_init guarantees registry vecs are non-
# null; calling cyim_lsp_init twice would double-register, so
# main() is the one source of truth.
fn cyim_lsp_init() {
    plugin_register_post_save_hook(&_cyim_lsp_post_save);
    plugin_register_post_change_hook(&_cyim_lsp_post_change);
    plugin_register_status_segment(&_cyim_lsp_status_segment);
    plugin_register_diagnostic_provider(&_cyim_lsp_diagnostic_provider);
    # NORMAL-mode keys: 'g' is a built-in prefix (`gg`), so we
    # register single-character keys that don't collide. v0.2.0
    # may move these behind a `g` plugin-prefix once cyim's
    # prefix-keymap ABI is settled.
    # TODO: register gd / gr properly once plugin-prefix ABI lands.
    # For v0.1.0 we register only the ex-commands.
    plugin_register_ex_command("lsp-restart", &_cyim_lsp_ex_restart);
    plugin_register_ex_command("lsp-status",  &_cyim_lsp_ex_status);
    # v0.6.0: navigation ex-commands.
    plugin_register_ex_command("lsp-goto-def",  &_cyim_lsp_ex_goto_def);
    plugin_register_ex_command("lsp-find-refs", &_cyim_lsp_ex_find_refs);
    return 0;
}
