# cyim-lsp.cyr -- bundled distribution
# Version: 0.4.0
# Generated by: cyrius distlib
# Do not edit -- rebuild with: cyrius distlib


# --- jsonrpc.cyr ---

# jsonrpc.cyr — JSON-RPC 2.0 framing for LSP (v0.2.0)
#
# LSP messages are JSON-RPC payloads with a Content-Length header:
#   Content-Length: <N>\r\n
#   \r\n
#   <N bytes of JSON>
#
# Public surface (frozen for v0.2.x):
#   jsonrpc_version()                          -> "2.0"
#   jsonrpc_next_id()                          -> auto-incrementing i64
#   jsonrpc_build_notification(method, params) -> framed cstring
#   jsonrpc_build_request(id, method, params)  -> framed cstring
#   jsonrpc_parse_frame(buf, len, off_out, len_out) -> 1 / 0 / -1
#
# `params` is a NUL-term cstring of pre-serialized JSON (e.g.
# `{"textDocument":{"uri":"file:///foo"}}`). v0.2.0 hand-rolls the
# JSON-RPC envelope rather than using the json stdlib because the
# envelope shape is fixed and embedding pre-serialized params keeps
# the API simple. Future versions may use json stdlib for more
# complex outgoing builds (e.g. nested object construction in
# message handlers); v0.2.0 doesn't need it.
#
# `jsonrpc_parse_frame` return values:
#   1   — valid frame found; *off_out and *len_out set
#   0   — buffer incomplete; caller should accumulate more bytes
#   -1  — malformed header; caller should drop the connection
#
# Self-contained — no plugin ABI references. First in dist/cyim-lsp.cyr
# concatenation order; downstream modules (lsp_client, plugin_init)
# build on these helpers.

# === Internal helpers ===

# Append a NUL-term cstring `src` into `dst` at offset `off`.
# Returns the new offset (off + strlen(src)).
fn _jr_append(dst, off, src) {
    var sl = strlen(src);
    var i = 0;
    while (i < sl) {
        store8(dst + off + i, load8(src + i));
        i = i + 1;
    }
    return off + sl;
}

# Convert a non-negative i64 to a NUL-term decimal cstring on the
# heap. Returns the heap pointer (caller-owned; lives until process
# exit per cyrius's bump-alloc convention).
fn _jr_itoa(n) {
    if (n == 0) {
        var z = alloc(2);
        if (z == 0) { return 0; }
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    # Reverse-fill into a 24-byte stack buf (max i64 = 19 digits + sign).
    var tmp[24];
    var tlen = 0;
    var v = n;
    while (v > 0) {
        store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
        v = v / 10;
        tlen = tlen + 1;
    }
    var out = alloc(tlen + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < tlen) {
        store8(out + i, load8(&tmp + tlen - 1 - i));
        i = i + 1;
    }
    store8(out + tlen, 0);
    return out;
}

# Wrap `body` (NUL-term JSON cstring) with the LSP Content-Length
# header. Returns the framed cstring.
fn _jr_frame(body) {
    var body_len = strlen(body);
    var dec = _jr_itoa(body_len);
    if (dec == 0) { return 0; }
    var dec_len = strlen(dec);
    # "Content-Length: " (16) + dec + "\r\n\r\n" (4) + body
    var total = 16 + dec_len + 4 + body_len;
    var out = alloc(total + 1);
    if (out == 0) { return 0; }
    var off = 0;
    off = _jr_append(out, off, "Content-Length: ");
    off = _jr_append(out, off, dec);
    off = _jr_append(out, off, "\r\n\r\n");
    off = _jr_append(out, off, body);
    store8(out + off, 0);
    return out;
}

# === Public API ===

fn jsonrpc_version() {
    return "2.0";
}

# Auto-incrementing message id allocator. Starts at 1; LSP
# specification recommends positive integers but neither requires
# strict monotonicity nor forbids reuse — incrementing is the
# safe choice. Caller correlates request id → response id.
var _jsonrpc_next_id = 1;

fn jsonrpc_next_id() {
    var n = _jsonrpc_next_id;
    _jsonrpc_next_id = n + 1;
    return n;
}

# Build a JSON-RPC notification (no `id` field — fire-and-forget).
# `method` and `params` are NUL-term cstrings; `params` must be a
# pre-serialized JSON value (object, array, or null).
#
# Body shape:
#   {"jsonrpc":"2.0","method":"<method>","params":<params>}
#
# Returns a NUL-term framed cstring (Content-Length header + body)
# or 0 on alloc failure.
fn jsonrpc_build_notification(method, params) {
    var ml = strlen(method);
    var pl = strlen(params);
    # Upper-bound capacity:
    #   prefix `{"jsonrpc":"2.0","method":"` = 27
    #   sep `","params":` = 11
    #   suffix `}` = 1
    var cap = 39 + ml + pl + 1;
    var body = alloc(cap);
    if (body == 0) { return 0; }
    var off = 0;
    off = _jr_append(body, off, "{\"jsonrpc\":\"2.0\",\"method\":\"");
    off = _jr_append(body, off, method);
    off = _jr_append(body, off, "\",\"params\":");
    off = _jr_append(body, off, params);
    off = _jr_append(body, off, "}");
    store8(body + off, 0);
    return _jr_frame(body);
}

# Build a JSON-RPC request (with `id` for response correlation).
#
# Body shape:
#   {"jsonrpc":"2.0","id":<id>,"method":"<method>","params":<params>}
#
# Returns a NUL-term framed cstring or 0 on alloc failure.
fn jsonrpc_build_request(id, method, params) {
    var id_str = _jr_itoa(id);
    if (id_str == 0) { return 0; }
    var idl = strlen(id_str);
    var ml = strlen(method);
    var pl = strlen(params);
    # Upper-bound capacity:
    #   prefix `{"jsonrpc":"2.0","id":` = 22
    #   id digits
    #   sep1 `,"method":"` = 11
    #   method
    #   sep2 `","params":` = 11
    #   params
    #   suffix `}` = 1
    var cap = 45 + idl + ml + pl + 1;
    var body = alloc(cap);
    if (body == 0) { return 0; }
    var off = 0;
    off = _jr_append(body, off, "{\"jsonrpc\":\"2.0\",\"id\":");
    off = _jr_append(body, off, id_str);
    off = _jr_append(body, off, ",\"method\":\"");
    off = _jr_append(body, off, method);
    off = _jr_append(body, off, "\",\"params\":");
    off = _jr_append(body, off, params);
    off = _jr_append(body, off, "}");
    store8(body + off, 0);
    return _jr_frame(body);
}

# Parse one LSP frame from `buf` (raw bytes, length `len`).
# On valid frame: writes body offset + length to the i64 slots
# at `off_out` and `len_out`, returns 1.
# On incomplete frame (need more bytes): returns 0 (slots untouched).
# On malformed frame: returns -1.
#
# The LSP spec also allows additional headers (e.g. Content-Type)
# separated by \r\n; v0.2.0 only handles Content-Length and
# rejects any other header line as malformed. Lifting this is a
# v0.2.x patch when a real server starts sending Content-Type.
fn jsonrpc_parse_frame(buf, len, off_out, len_out) {
    # Need at least "Content-Length: \r\n\r\n0" = ~22 bytes for any frame.
    # Tolerate short buffers (incomplete) without ever reading past `len`.
    if (len < 16) { return 0; }
    # Match prefix "Content-Length: " (16 bytes).
    var prefix = "Content-Length: ";
    var i = 0;
    while (i < 16) {
        if (load8(buf + i) != load8(prefix + i)) { return 0 - 1; }
        i = i + 1;
    }
    # Parse decimal length up to \r. Use the go-flag loop pattern
    # so we can stop the loop when CR is seen without using `break`
    # (Cyrius's break is unreliable in loops with `var` decls).
    var n = 0;
    var k = 16;
    var saw_cr = 0;
    var any_digit = 0;
    var go = 1;
    while (go == 1) {
        if (k >= len) { go = 0; }
        if (go == 1) {
            var c = load8(buf + k);
            if (c == 13) {
                saw_cr = 1;
                go = 0;
            }
            if (c != 13) {
                if (c < 48) { return 0 - 1; }
                if (c > 57) { return 0 - 1; }
                n = n * 10 + (c - 48);
                any_digit = 1;
                k = k + 1;
            }
        }
    }
    if (saw_cr == 0) { return 0; }
    if (any_digit == 0) { return 0 - 1; }
    # Now expect \r\n\r\n starting at buf[k].
    if (k + 4 > len) { return 0; }
    if (load8(buf + k) != 13)     { return 0 - 1; }
    if (load8(buf + k + 1) != 10) { return 0 - 1; }
    if (load8(buf + k + 2) != 13) { return 0 - 1; }
    if (load8(buf + k + 3) != 10) { return 0 - 1; }
    var body_start = k + 4;
    if (body_start + n > len) { return 0; }
    store64(off_out, body_start);
    store64(len_out, n);
    return 1;
}

# --- subprocess.cyr ---

# subprocess.cyr — bidirectional-pipe subprocess primitives (v0.3.0)
#
# cyim-lsp spawns cyrius-lsp as a subprocess and talks to it over
# stdin/stdout pipes (LSP protocol convention). This file owns the
# pipe + fork + exec dance and the per-process handle.
#
# Why not stdlib's `process.cyr` `spawn()`? That helper is
# unidirectional (run + capture stdout). LSP needs both directions
# in flight simultaneously: parent writes requests / notifications
# to child stdin while reading responses / publishDiagnostics from
# child stdout.
#
# Public surface (frozen for v0.3.x):
#   lsp_proc_spawn(cmd, arg1, arg2)       -> proc handle (heap) or 0
#   lsp_proc_send(proc, buf, len)         -> bytes written, or -1
#   lsp_proc_recv(proc, buf, max)         -> bytes read, or -1 / 0 (EOF)
#   lsp_proc_close(proc)                  -> 0 on success, -1 on error
#   lsp_proc_pid(proc)                    -> child pid, or -1 if closed
#
# Proc handle layout (32 B):
#   +0   pid           i64 (set to -1 by close)
#   +8   read_fd       i64 (parent reads child stdout)
#   +16  write_fd      i64 (parent writes to child stdin)
#   +24  reserved      i64 (future: spawn-side state, e.g. capabilities ptr)
#
# Pipe orientation:
#   p_in[2]:  parent → child (parent writes p_in[1], child reads p_in[0] as stdin)
#   p_out[2]: child → parent (child writes p_out[1] as stdout, parent reads p_out[0])
#
# After fork, parent closes the child's ends; child closes the
# parent's ends, dup2's its halves to stdin/stdout, then execve.

# Build the argv array for execve. Mirrors process.cyr's `_exec3`
# but inlined here so we don't need to depend on process.cyr's
# internal-only helper. argv layout: [cmd, arg1?, arg2?, NULL].
fn _lsp_proc_exec(cmd, arg1, arg2) {
    var argv[4];
    store64(&argv, cmd);
    var ai = 1;
    if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
    if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
    store64(&argv + ai * 8, 0);
    var envp[1];
    store64(&envp, 0);
    sys_execve(cmd, &argv, &envp);
    # If execve returns, exec failed.
    sys_exit(127);
    return 0;
}

# Spawn `cmd` with optional arg1 / arg2 (pass 0 to omit). Sets up
# bidirectional pipes; returns a 32 B proc handle on success, 0 on
# any failure (pipe / fork / alloc).
#
# Caller is responsible for calling lsp_proc_close to reap the
# child and free the pipe fds. Forgetting close leaks fds + leaves
# a zombie process; always pair spawn with close.
fn lsp_proc_spawn(cmd, arg1, arg2) {
    var p_in[16];
    var p_out[16];
    if (sys_pipe(&p_in) < 0) { return 0; }
    if (sys_pipe(&p_out) < 0) {
        sys_close(load32(&p_in));
        sys_close(load32(&p_in + 4));
        return 0;
    }
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(load32(&p_in));
        sys_close(load32(&p_in + 4));
        sys_close(load32(&p_out));
        sys_close(load32(&p_out + 4));
        return 0;
    }
    if (pid == 0) {
        # Child: close parent's ends, wire halves to stdin/stdout.
        sys_close(load32(&p_in + 4));   # parent's write end of input pipe
        sys_close(load32(&p_out));      # parent's read end of output pipe
        sys_dup2(load32(&p_in), 0);     # stdin = read end of input pipe
        sys_dup2(load32(&p_out + 4), 1); # stdout = write end of output pipe
        sys_close(load32(&p_in));
        sys_close(load32(&p_out + 4));
        _lsp_proc_exec(cmd, arg1, arg2);
        # Unreachable; _lsp_proc_exec calls sys_exit on failure.
        sys_exit(127);
    }
    # Parent: close child's ends, build the handle.
    sys_close(load32(&p_in));        # child's read end of input pipe
    sys_close(load32(&p_out + 4));   # child's write end of output pipe
    var proc = alloc(32);
    if (proc == 0) {
        sys_close(load32(&p_in + 4));
        sys_close(load32(&p_out));
        return 0;
    }
    store64(proc,      pid);
    store64(proc + 8,  load32(&p_out));     # parent reads child stdout from here
    store64(proc + 16, load32(&p_in + 4));  # parent writes to child stdin here
    store64(proc + 24, 0);
    return proc;
}

# Accessors.
fn lsp_proc_pid(proc) {
    if (proc == 0) { return 0 - 1; }
    return load64(proc);
}

# Write `len` bytes from `buf` to the child's stdin. Returns the
# write() return value (bytes written, or -errno on failure).
fn lsp_proc_send(proc, buf, len) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    return sys_write(load64(proc + 16), buf, len);
}

# Read up to `max` bytes from the child's stdout into `buf`.
# Returns the read() return value:
#   > 0  — bytes read
#   = 0  — EOF (child closed stdout / exited)
#   < 0  — -errno
fn lsp_proc_recv(proc, buf, max) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    return sys_read(load64(proc + 8), buf, max);
}

# Close the child's pipes and reap the process via sys_waitpid.
# Idempotent: marks the proc handle's pid = -1 after first call so
# a second close() returns immediately without re-reaping.
fn lsp_proc_close(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0; }   # already closed
    sys_close(load64(proc + 8));
    sys_close(load64(proc + 16));
    var status_buf[1];
    sys_waitpid(pid, &status_buf, 0);
    store64(proc, 0 - 1);   # mark closed
    return 0;
}

# Send SIGTERM to the child without closing pipes or reaping.
# Used by `:lsp-restart` to interrupt an unresponsive server
# before close-then-respawn. The caller still needs to call
# lsp_proc_close afterward to reap the zombie. Returns sys_kill's
# return value.
fn lsp_proc_kill(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    # SIGTERM = 15
    return sys_kill(pid, 15);
}

# --- lsp_client.cyr ---

# lsp_client.cyr — LSP protocol client (v0.3.0)
#
# High-level layer above subprocess.cyr + jsonrpc.cyr:
#   - Spawns cyrius-lsp (or any LSP server cmd) and runs the
#     `initialize` handshake
#   - Owns the per-process state: proc handle (pid + pipe fds),
#     last received frame, attached/detached flag
#   - Issues `shutdown` + `exit` cleanly when stopping
#
# Protocol shape (LSP §3.7 LifeCycle):
#   1. Client → Server: `initialize` request (id=1)
#   2. Server → Client: `initialize` response (id=1, result has capabilities)
#   3. Client → Server: `initialized` notification
#   4. … traffic …
#   5. Client → Server: `shutdown` request
#   6. Server → Client: `shutdown` response
#   7. Client → Server: `exit` notification
#   8. Server exits
#
# v0.3.0 implements 1, 2, 3, 5, 6, 7, 8. Step 4 (real document
# sync via post_save / post_change hooks) lands in v0.4.0 / M3.
#
# Public surface (frozen for v0.3.x):
#   lsp_client_running()                  -> pid (>0 if attached, 0 otherwise)
#   lsp_client_describe()                 -> cstring
#   lsp_client_start(cmd_path)            -> 0 / -1
#   lsp_client_stop()                     -> 0 / -1
#   lsp_client_proc()                     -> proc handle (or 0)

# Per-client state. _lsp_proc holds the subprocess handle; null
# means "no server attached". Single-server design — multi-server
# multiplexing is post-v1.0 per the cyim-lsp roadmap "Out of scope".
var _lsp_proc = 0;

# Static description buffer, regenerated on each `lsp_client_describe`
# call. 64 bytes accommodates "cyrius-lsp pid=<i64-decimal> (running)"
# or the "(not attached)" alternative.
var _lsp_describe_buf[64];

# Public: returns the child pid if attached, 0 if not. Reads past
# `lsp_proc_close` are safe — the close marks pid = -1, and we
# treat any non-positive value as detached.
fn lsp_client_running() {
    if (_lsp_proc == 0) { return 0; }
    var pid = lsp_proc_pid(_lsp_proc);
    if (pid <= 0) { return 0; }
    return pid;
}

fn lsp_client_proc() {
    return _lsp_proc;
}

# Render a human-readable description into `_lsp_describe_buf` and
# return a pointer to it. Used by:
#   - main.cyr's standalone driver (smoke output)
#   - the v0.5.0+ `:lsp-status` ex-command
fn lsp_client_describe() {
    var pid = lsp_client_running();
    if (pid == 0) {
        var s = "(not attached)";
        var sl = strlen(s);
        var i = 0;
        while (i < sl) {
            store8(&_lsp_describe_buf + i, load8(s + i));
            i = i + 1;
        }
        store8(&_lsp_describe_buf + sl, 0);
        return &_lsp_describe_buf;
    }
    # "cyrius-lsp pid=" + decimal pid
    var prefix = "cyrius-lsp pid=";
    var pl = strlen(prefix);
    var off = 0;
    while (off < pl) {
        store8(&_lsp_describe_buf + off, load8(prefix + off));
        off = off + 1;
    }
    # Inline itoa for pid (mirrors trailing_ws's pattern in cyim).
    var tmp[24];
    var tlen = 0;
    var v = pid;
    if (v == 0) {
        store8(&tmp, 48);
        tlen = 1;
    } else {
        while (v > 0) {
            store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
            v = v / 10;
            tlen = tlen + 1;
        }
    }
    var j = 0;
    while (j < tlen) {
        store8(&_lsp_describe_buf + off, load8(&tmp + tlen - 1 - j));
        off = off + 1;
        j = j + 1;
    }
    store8(&_lsp_describe_buf + off, 0);
    return &_lsp_describe_buf;
}

# Read one framed JSON-RPC message from the server. Allocates a
# heap buffer, accumulates bytes via lsp_proc_recv, calls
# jsonrpc_parse_frame after each read until a complete frame is
# present (or error / EOF).
#
# Writes body offset + length to *off_out / *len_out.
# Returns the buffer pointer on success, 0 on error (alloc fail,
# malformed frame, EOF mid-frame, oversized frame).
#
# v0.3.0 uses an 8 KB buffer — handles initialize + shutdown
# responses (typically <2 KB). v0.4.0+ may need to grow for
# publishDiagnostics on large files; that's a wrap-and-grow
# refinement.
fn _lsp_recv_frame(off_out, len_out) {
    if (_lsp_proc == 0) { return 0; }
    var cap = 8192;
    var buf = alloc(cap);
    if (buf == 0) { return 0; }
    var total = 0;
    var go = 1;
    while (go == 1) {
        if (total >= cap) {
            # Frame larger than v0.3.0 buffer cap.
            return 0;
        }
        var n = lsp_proc_recv(_lsp_proc, buf + total, cap - total);
        if (n <= 0) {
            # 0 = EOF mid-frame, < 0 = error.
            return 0;
        }
        total = total + n;
        var off_slot[8];
        store64(&off_slot, 0);
        var len_slot[8];
        store64(&len_slot, 0);
        var rc = jsonrpc_parse_frame(buf, total, &off_slot, &len_slot);
        if (rc == 1) {
            store64(off_out, load64(&off_slot));
            store64(len_out, load64(&len_slot));
            return buf;
        }
        if (rc == 0 - 1) {
            return 0;
        }
        # rc == 0: incomplete; loop and read more.
    }
    return 0;
}

# Send `msg` (a framed JSON-RPC cstring) to the server, writing
# all bytes (handling short writes). Returns 0 on success, -1 on
# error.
fn _lsp_send_all(msg) {
    if (_lsp_proc == 0) { return 0 - 1; }
    var total = strlen(msg);
    var sent = 0;
    var go = 1;
    while (go == 1) {
        if (sent >= total) { go = 0; }
        if (go == 1) {
            var n = lsp_proc_send(_lsp_proc, msg + sent, total - sent);
            if (n <= 0) { return 0 - 1; }
            sent = sent + n;
        }
    }
    return 0;
}

# Send the LSP `initialize` request and wait for the response.
# Discards capabilities for v0.3.0 (just verifies the response
# parses cleanly). v0.4.0+ stores capabilities for feature
# negotiation (e.g. did we get definitionProvider?).
fn _lsp_initialize() {
    var id = jsonrpc_next_id();
    # Minimal initialize params per LSP §3.7.1. processId=null is
    # accepted by cyrius-lsp; rootUri=null too. capabilities={}
    # signals "client supports nothing optional".
    var params = "{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}";
    var msg = jsonrpc_build_request(id, "initialize", params);
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    # Read response. v0.3.0 just verifies a frame arrives — no
    # capability inspection.
    var off_slot[8];
    store64(&off_slot, 0);
    var len_slot[8];
    store64(&len_slot, 0);
    var resp = _lsp_recv_frame(&off_slot, &len_slot);
    if (resp == 0) { return 0 - 1; }
    # Send `initialized` notification — LSP requires this to
    # signal "ready to send didOpen" etc. Empty params per spec.
    var notif = jsonrpc_build_notification("initialized", "{}");
    if (notif == 0) { return 0 - 1; }
    if (_lsp_send_all(notif) != 0) { return 0 - 1; }
    return 0;
}

# Send `shutdown` request, await response, then send `exit`
# notification. After this the server should exit on its own;
# lsp_proc_close still calls sys_waitpid to reap.
fn _lsp_shutdown_handshake() {
    var id = jsonrpc_next_id();
    var msg = jsonrpc_build_request(id, "shutdown", "null");
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    var off_slot[8];
    store64(&off_slot, 0);
    var len_slot[8];
    store64(&len_slot, 0);
    var resp = _lsp_recv_frame(&off_slot, &len_slot);
    if (resp == 0) {
        # Server may have crashed mid-shutdown; not fatal.
        return 0 - 1;
    }
    var exit_notif = jsonrpc_build_notification("exit", "null");
    if (exit_notif == 0) { return 0 - 1; }
    if (_lsp_send_all(exit_notif) != 0) { return 0 - 1; }
    return 0;
}

# Spawn + initialize handshake. Internal entry point — public
# variants vary the cmd argv shape.
fn _lsp_client_start_with(cmd, arg1, arg2) {
    if (_lsp_proc != 0) {
        # Already attached — caller should stop before restart.
        return 0 - 1;
    }
    var p = lsp_proc_spawn(cmd, arg1, arg2);
    if (p == 0) { return 0 - 1; }
    _lsp_proc = p;
    var rc = _lsp_initialize();
    if (rc != 0) {
        # Handshake failed; clean up.
        lsp_proc_close(_lsp_proc);
        _lsp_proc = 0;
        return 0 - 1;
    }
    return 0;
}

# Spawn `cmd_path` (absolute path expected) and run the LSP
# `initialize` handshake. Returns 0 on success, -1 on any failure
# (already running, spawn failed, handshake failed).
fn lsp_client_start(cmd_path) {
    return _lsp_client_start_with(cmd_path, 0, 0);
}

# Spawn `cyrius-lsp` via PATH lookup (`/usr/bin/env cyrius-lsp`)
# and run the initialize handshake. The default entry point used
# by lsp_documents' lazy-start path. Returns 0 on success, -1 on
# any failure.
fn lsp_client_start_default() {
    return _lsp_client_start_with("/usr/bin/env", "cyrius-lsp", 0);
}

# Run shutdown handshake then close + reap. Idempotent — safe to
# call when no server is attached. Returns 0 in both cases (the
# handshake-failure path still closes pipes + reaps).
fn lsp_client_stop() {
    if (_lsp_proc == 0) { return 0; }
    _lsp_shutdown_handshake();
    lsp_proc_close(_lsp_proc);
    _lsp_proc = 0;
    return 0;
}

# --- lsp_state.cyr ---

# lsp_state.cyr — per-buffer LSP document state (v0.4.0)
#
# LSP requires per-document tracking:
#   - URI (file:///...) — sent in every notification
#   - version (i64) — incremented per didChange (LSP §3.7.5
#     `versionedTextDocumentIdentifier`)
#   - opened flag — has didOpen been sent? (controls
#     didOpen-vs-didChange routing on first post_change)
#
# This file owns the table of these entries, indexed by cyim
# buffer pointer. Linear vec scan for lookup — typical use is
# 1-10 open buffers, well below where a hashmap pays off.
#
# Public surface (frozen for v0.4.x):
#   lsp_state_init()                      -> 0
#   lsp_state_lookup(b)                   -> entry ptr or 0
#   lsp_state_create(b, uri)              -> entry ptr or 0
#   lsp_state_bump_version(entry)         -> new version
#   lsp_state_mark_opened(entry)          -> 0
#   lsp_state_is_opened(entry)            -> 0/1
#   lsp_state_version(entry)              -> i64
#   lsp_state_uri(entry)                  -> cstring
#   lsp_state_buf(entry)                  -> buf ptr
#
# Entry shape (32 B):
#   +0   buf_ptr        (cyim buffer pointer; the lookup key)
#   +8   version        (i64; starts at 0, bumped to 1 on first
#                        didOpen/didChange)
#   +16  opened         (0 = didOpen not yet sent; 1 = sent)
#   +24  uri            (NUL-term cstring; heap-allocated, owned
#                        by entry; lives for process lifetime)

var _lsp_state_table = 0;

fn lsp_state_init() {
    if (_lsp_state_table == 0) { _lsp_state_table = vec_new(); }
    return 0;
}

# Lookup an existing entry by buf_ptr. Returns the entry pointer
# or 0 if not found. Call lsp_state_create to register new buffers.
fn lsp_state_lookup(b) {
    if (_lsp_state_table == 0) { return 0; }
    var n = vec_len(_lsp_state_table);
    var i = 0;
    while (i < n) {
        var e = vec_get(_lsp_state_table, i);
        if (e != 0) {
            if (load64(e) == b) { return e; }
        }
        i = i + 1;
    }
    return 0;
}

# Create a new entry for buf_ptr `b` with the given URI. Returns
# the entry pointer or 0 on alloc failure. Caller should check
# lsp_state_lookup first to avoid duplicates.
fn lsp_state_create(b, uri) {
    if (_lsp_state_table == 0) { lsp_state_init(); }
    var e = alloc(32);
    if (e == 0) { return 0; }
    store64(e,      b);
    store64(e + 8,  0);     # version
    store64(e + 16, 0);     # opened
    store64(e + 24, uri);
    vec_push(_lsp_state_table, e);
    return e;
}

# Increment the entry's version and return the new value. LSP
# spec recommends version 1 for the first didOpen/didChange;
# starting at 0 and bumping before send gives 1 on the first
# call.
fn lsp_state_bump_version(entry) {
    if (entry == 0) { return 0; }
    var v = load64(entry + 8) + 1;
    store64(entry + 8, v);
    return v;
}

# Set the opened flag. Called by lsp_documents after didOpen sent.
fn lsp_state_mark_opened(entry) {
    if (entry == 0) { return 0; }
    store64(entry + 16, 1);
    return 0;
}

fn lsp_state_is_opened(entry) {
    if (entry == 0) { return 0; }
    return load64(entry + 16);
}

fn lsp_state_version(entry) {
    if (entry == 0) { return 0; }
    return load64(entry + 8);
}

fn lsp_state_uri(entry) {
    if (entry == 0) { return 0; }
    return load64(entry + 24);
}

fn lsp_state_buf(entry) {
    if (entry == 0) { return 0; }
    return load64(entry);
}

# Count of registered buffers — used by `:lsp-status` (v0.5.0+)
# and tests.
fn lsp_state_count() {
    if (_lsp_state_table == 0) { return 0; }
    return vec_len(_lsp_state_table);
}

# --- lsp_documents.cyr ---

# lsp_documents.cyr — LSP document-sync handlers (v0.4.0)
#
# Responds to cyim's plugin hooks by sending the appropriate LSP
# notifications:
#   post_change_hook(s)       → textDocument/didChange (or didOpen
#                                if first interaction with this buffer)
#   post_save_hook(s, path)   → textDocument/didSave
#
# Auto-starts cyrius-lsp on first interaction with a .cyr buffer
# (lazy-start). Subsequent hooks reuse the running server. If
# start fails, hooks no-op silently — cyim-lsp degrades to
# "no server attached" without breaking the editor.
#
# Buffer filter: v0.4.0 only sends notifications for `.cyr` files.
# Other languages get skipped. Multi-language support is post-v1.0.
#
# Standalone-build hygiene: this file references cyim's plugin ABI
# surface (`editor_buf`, `editor_file_path`, `buf_len`, `buf_get`)
# which only resolves at fold-in into cyim's compilation unit.
# main.cyr does NOT include this file; it's only in [lib].modules.

# === JSON string escape ===
#
# Buffer text needs JSON-string-aware escaping before embedding
# in a `text` field. Encodes the 7 short escapes (\\, \", \b,
# \f, \n, \r, \t) and `\u00XX` for other control bytes (< 0x20).
# Printable ASCII passes through; non-ASCII bytes pass through
# as-is (assumes UTF-8-clean input — the typical cyim/cyrius case).

# Encode one source byte into dst[o..]. Returns new offset, or
# -1 if dst would overflow dst_cap. Worst case: 6 bytes (\u00XX).
fn _lsp_jesc_byte(c, dst, o, dst_cap) {
    if (c == 92) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 92);
        return o + 2;
    }
    if (c == 34) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 34);
        return o + 2;
    }
    if (c == 10) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 110);
        return o + 2;
    }
    if (c == 13) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 114);
        return o + 2;
    }
    if (c == 9) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 116);
        return o + 2;
    }
    if (c == 8) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 98);
        return o + 2;
    }
    if (c == 12) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 102);
        return o + 2;
    }
    if (c < 32) {
        # \u00XX — six bytes total. Escape any other control byte
        # we didn't catch above. JSON spec requires escaping all
        # bytes < 0x20 inside string literals.
        if (o + 6 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 117);
        store8(dst + o + 2, 48);
        store8(dst + o + 3, 48);
        var hi = c / 16;
        var lo = c - hi * 16;
        if (hi < 10) { store8(dst + o + 4, 48 + hi); }
        if (hi >= 10) { store8(dst + o + 4, 87 + hi); }
        if (lo < 10) { store8(dst + o + 5, 48 + lo); }
        if (lo >= 10) { store8(dst + o + 5, 87 + lo); }
        return o + 6;
    }
    if (o + 1 > dst_cap) { return 0 - 1; }
    store8(dst + o, c);
    return o + 1;
}

# Materialise a cyim gap buffer's contents into a JSON-escaped
# heap cstring. Returns a NUL-term cstring suitable for embedding
# inside `"..."` in a JSON message body. 0 on alloc failure.
fn _lsp_buf_to_json_string(b) {
    if (b == 0) { return 0; }
    var blen = buf_len(b);
    # Worst case: every byte expands to 6 chars (\u00XX). Plus
    # NUL. Allocate the upper bound — cheap for plugin scale.
    var cap = blen * 6 + 1;
    var dst = alloc(cap);
    if (dst == 0) { return 0; }
    var o = 0;
    var i = 0;
    while (i < blen) {
        o = _lsp_jesc_byte(buf_get(b, i), dst, o, cap);
        if (o < 0) { return 0; }
        i = i + 1;
    }
    store8(dst + o, 0);
    return dst;
}

# === URI construction ===
#
# Convert a filesystem path to a `file://...` URI. v0.4.0 assumes
# absolute paths (which cyim normally produces — `:e <path>`
# resolves relative paths against cwd before storing). Relative
# paths get the wrong URI; documenting the limitation here rather
# than silently fixing in v0.4.0.

fn _lsp_path_to_uri(path) {
    if (path == 0) { return 0; }
    var pl = strlen(path);
    # "file://" (7) + path + NUL
    var out = alloc(7 + pl + 1);
    if (out == 0) { return 0; }
    var prefix = "file://";
    var i = 0;
    while (i < 7) {
        store8(out + i, load8(prefix + i));
        i = i + 1;
    }
    var j = 0;
    while (j < pl) {
        store8(out + 7 + j, load8(path + j));
        j = j + 1;
    }
    store8(out + 7 + pl, 0);
    return out;
}

# === Filter: only send notifications for cyim/cyrius source ===
#
# v0.4.0 supports only `.cyr` files. Other extensions get
# silently filtered — server doesn't see notifications for them.
# Multi-language is post-v1.0 (per roadmap "Out of scope").

fn _lsp_path_is_cyr(path) {
    if (path == 0) { return 0; }
    var pl = strlen(path);
    if (pl < 4) { return 0; }
    if (load8(path + pl - 4) != 46)  { return 0; }   # '.'
    if (load8(path + pl - 3) != 99)  { return 0; }   # 'c'
    if (load8(path + pl - 2) != 121) { return 0; }   # 'y'
    if (load8(path + pl - 1) != 114) { return 0; }   # 'r'
    return 1;
}

# === Decimal i64 to cstring (mirrors lsp_client.cyr's pattern). ===

fn _lsp_doc_itoa(n) {
    if (n == 0) {
        var z = alloc(2);
        if (z == 0) { return 0; }
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    var tmp[24];
    var tlen = 0;
    var v = n;
    while (v > 0) {
        store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
        v = v / 10;
        tlen = tlen + 1;
    }
    var out = alloc(tlen + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < tlen) {
        store8(out + i, load8(&tmp + tlen - 1 - i));
        i = i + 1;
    }
    store8(out + tlen, 0);
    return out;
}

# === didOpen builder ===
#
# Body shape (LSP §3.7.5):
#   {"textDocument": {
#      "uri": "<uri>",
#      "languageId": "cyrius",
#      "version": <n>,
#      "text": "<escaped text>"
#   }}

fn _lsp_doc_build_did_open_params(uri, version, text_escaped) {
    var ul = strlen(uri);
    var vl_str = _lsp_doc_itoa(version);
    if (vl_str == 0) { return 0; }
    var vl = strlen(vl_str);
    var tl = strlen(text_escaped);
    # Fixed bytes:
    #   {"textDocument":{"uri":"<uri>","languageId":"cyrius","version":<v>,"text":"<text>"}}
    # = 1 + 16 + 1 + 7 + ul + 16 + 6 + vl + 9 + tl + 4 = 60 + ul + vl + tl
    var cap = 80 + ul + vl + tl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\",\"languageId\":\"cyrius\",\"version\":");
    off = _lsp_append(out, off, vl_str);
    off = _lsp_append(out, off, ",\"text\":\"");
    off = _lsp_append(out, off, text_escaped);
    off = _lsp_append(out, off, "\"}}");
    store8(out + off, 0);
    return out;
}

# Append helper (jsonrpc.cyr's _jr_append is internal there;
# duplicate here rather than expose it across files).
fn _lsp_append(dst, off, src) {
    var sl = strlen(src);
    var i = 0;
    while (i < sl) {
        store8(dst + off + i, load8(src + i));
        i = i + 1;
    }
    return off + sl;
}

# === didChange builder ===
#
# Body shape:
#   {"textDocument": {"uri":"<uri>","version":<n>},
#    "contentChanges": [{"text":"<escaped full text>"}]}

fn _lsp_doc_build_did_change_params(uri, version, text_escaped) {
    var ul = strlen(uri);
    var vl_str = _lsp_doc_itoa(version);
    if (vl_str == 0) { return 0; }
    var vl = strlen(vl_str);
    var tl = strlen(text_escaped);
    var cap = 100 + ul + vl + tl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\",\"version\":");
    off = _lsp_append(out, off, vl_str);
    off = _lsp_append(out, off, "},\"contentChanges\":[{\"text\":\"");
    off = _lsp_append(out, off, text_escaped);
    off = _lsp_append(out, off, "\"}]}");
    store8(out + off, 0);
    return out;
}

# === didSave builder ===
#
# Body shape:
#   {"textDocument": {"uri":"<uri>"}}
# (No `text` field — LSP defaults to "save without text" since
# the server already has the latest content from prior didChange.)

fn _lsp_doc_build_did_save_params(uri) {
    var ul = strlen(uri);
    var cap = 40 + ul;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\"}}");
    store8(out + off, 0);
    return out;
}

# === Lazy server start ===
#
# Spawn cyrius-lsp on first .cyr-file interaction. Uses
# `/usr/bin/env cyrius-lsp` so PATH lookup happens (cyrius-lsp
# typically lives at `~/.cyrius/bin/cyrius-lsp` after the
# standard install, on PATH via cyrius's bin link).

fn _lsp_doc_lazy_start() {
    if (lsp_client_running() != 0) { return 0; }
    return lsp_client_start_default();
}

# === Public hook handlers ===

# Send didOpen for a buffer if not already opened. Caller has
# already verified the path is .cyr and looked up / created the
# state entry.
fn _lsp_doc_send_did_open(b, entry) {
    if (lsp_state_is_opened(entry) == 1) { return 0; }
    var uri = lsp_state_uri(entry);
    var v = lsp_state_bump_version(entry);
    var text = _lsp_buf_to_json_string(b);
    if (text == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_open_params(uri, v, text);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didOpen", params);
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    lsp_state_mark_opened(entry);
    return 0;
}

# post_change hook handler — entry point from plugin_init.cyr's
# `_cyim_lsp_post_change(s)`. Filters non-.cyr buffers; lazy-
# starts the server; sends didOpen on first interaction; sends
# didChange thereafter with bumped version + full text payload.
fn lsp_doc_did_change(s) {
    var path = editor_file_path(s);
    if (path == 0) { return 0; }   # scratch buffer
    if (_lsp_path_is_cyr(path) == 0) { return 0; }
    if (_lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var entry = lsp_state_lookup(b);
    if (entry == 0) {
        var uri = _lsp_path_to_uri(path);
        if (uri == 0) { return 0; }
        entry = lsp_state_create(b, uri);
        if (entry == 0) { return 0; }
    }
    if (lsp_state_is_opened(entry) == 0) {
        return _lsp_doc_send_did_open(b, entry);
    }
    # Already opened — send didChange.
    var v = lsp_state_bump_version(entry);
    var uri = lsp_state_uri(entry);
    var text = _lsp_buf_to_json_string(b);
    if (text == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_change_params(uri, v, text);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didChange", params);
    if (msg == 0) { return 0 - 1; }
    return _lsp_send_all(msg);
}

# post_save hook handler — entry point from plugin_init.cyr's
# `_cyim_lsp_post_save(s, path)`. Filters non-.cyr; sends
# didOpen on first interaction (rare — usually a didChange
# preceded), then didSave.
fn lsp_doc_did_save(s, path) {
    if (path == 0) { return 0; }
    if (_lsp_path_is_cyr(path) == 0) { return 0; }
    if (_lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var entry = lsp_state_lookup(b);
    if (entry == 0) {
        var uri = _lsp_path_to_uri(path);
        if (uri == 0) { return 0; }
        entry = lsp_state_create(b, uri);
        if (entry == 0) { return 0; }
    }
    if (lsp_state_is_opened(entry) == 0) {
        # Save before any change — emit didOpen first per LSP spec.
        var rc = _lsp_doc_send_did_open(b, entry);
        if (rc != 0) { return rc; }
    }
    var uri = lsp_state_uri(entry);
    var params = _lsp_doc_build_did_save_params(uri);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didSave", params);
    if (msg == 0) { return 0 - 1; }
    return _lsp_send_all(msg);
}

# --- plugin_init.cyr ---

# plugin_init.cyr — cyim plugin ABI consumer
#
# Registers cyim-lsp's hooks against cyim's plugin ABI surface
# (frozen at cyim 1.3.6 / ADR 0004). This file references symbols
# that exist only in cyim's compilation unit:
#   plugin_register_post_save_hook(fp)
#   plugin_register_post_change_hook(fp)
#   plugin_register_status_segment(fp)
#   plugin_register_normal_key(key, fp)
#   plugin_register_ex_command(name, fp)
#   plugin_register_diagnostic_provider(fp)
#
# Standalone cyim-lsp builds (cyrius build src/main.cyr) do NOT
# include this file — the cyrius.cyml [build].entry chain pulls
# only main.cyr's transitive includes, so plugin_init.cyr's
# references stay unresolved until cyrius distlib bundles it into
# dist/cyim-lsp.cyr and cyim's `include "lib/cyim-lsp.cyr"` brings
# it into cyim's TU where the symbols are defined.
#
# This is the canonical sandhi-pattern shape — vyakarana and niyama
# work the same way (their plugin-side files reference downstream
# consumer symbols that resolve at fold-in time).
#
# === Hook callbacks (stubs for v0.1.0) ===
#
# v0.1.0 registers no-op stubs for all six hooks. The real LSP
# implementations land at v0.2.0 = cyim 1.4.1+ once the JSON-RPC
# + subprocess code is in. The stubs prove the wiring shape and
# let cyim 1.4.0 ship with a working `[plugins.cyim-lsp]` entry
# whose effect is "no behavior change yet, but the plugin is
# linked in and ready."

fn _cyim_lsp_post_save(s, path) {
    # v0.4.0: route to lsp_doc_did_save which lazy-starts cyrius-lsp,
    # filters non-.cyr files, and sends textDocument/didSave (with
    # an implicit didOpen first if the buffer hadn't been touched
    # yet).
    return lsp_doc_did_save(s, path);
}

fn _cyim_lsp_post_change(s) {
    # v0.4.0: route to lsp_doc_did_change which handles the same
    # lazy-start + filter chain, then sends textDocument/didChange
    # with the bumped version + full-text payload (or didOpen on
    # first interaction).
    return lsp_doc_did_change(s);
}

fn _cyim_lsp_status_segment(s) {
    # TODO v0.2.0: format "E:N W:M I:K" from accumulated diagnostics.
    # v0.1.0 returns 0 (no segment) so the status line stays clean.
    return 0;
}

fn _cyim_lsp_diagnostic_provider(s, b, out_vec) {
    # TODO v0.2.0: push collected publishDiagnostics entries from
    # cyrius-lsp into out_vec via diag_new(line, severity, msg).
    return 0;
}

fn _cyim_lsp_gd(s) {
    # TODO v0.2.0: textDocument/definition; jump cursor to result.
    return ACT_NONE;
}

fn _cyim_lsp_gr(s) {
    # TODO v0.2.0: textDocument/references; populate quickfix list.
    return ACT_NONE;
}

fn _cyim_lsp_ex_restart(s) {
    # TODO v0.2.0: kill + respawn cyrius-lsp subprocess.
    return 0;
}

fn _cyim_lsp_ex_status(s) {
    # TODO v0.2.0: print server status (pid, capabilities, doc count).
    return 0;
}

# Public entry point — called from cyim's main() after plugin_init()
# and trailing_ws_init() (or whatever order main.cyr establishes).
# Idempotent: cyim's plugin_init guarantees registry vecs are non-
# null; calling cyim_lsp_init twice would double-register, so
# main() is the one source of truth.
fn cyim_lsp_init() {
    plugin_register_post_save_hook(&_cyim_lsp_post_save);
    plugin_register_post_change_hook(&_cyim_lsp_post_change);
    plugin_register_status_segment(&_cyim_lsp_status_segment);
    plugin_register_diagnostic_provider(&_cyim_lsp_diagnostic_provider);
    # NORMAL-mode keys: 'g' is a built-in prefix (`gg`), so we
    # register single-character keys that don't collide. v0.2.0
    # may move these behind a `g` plugin-prefix once cyim's
    # prefix-keymap ABI is settled.
    # TODO: register gd / gr properly once plugin-prefix ABI lands.
    # For v0.1.0 we register only the ex-commands.
    plugin_register_ex_command("lsp-restart", &_cyim_lsp_ex_restart);
    plugin_register_ex_command("lsp-status",  &_cyim_lsp_ex_status);
    return 0;
}
