# cyim_glue.cyr — reference consumer-side glue for cyim-lsp
#
# This file is the **consumer's** responsibility, not part of the
# cyim-lsp [lib] bundle. The bundle (jsonrpc, subprocess,
# lsp_diags, lsp_client, lsp_state, lsp_position, lsp_documents)
# is genuinely self-contained: every symbol resolves against the
# bundle + cyrius stdlib, with no references to consumer-side
# editor symbols.
#
# Consumers (like cyim) provide a glue file that:
#   1. Reads editor state via the host's plugin ABI.
#   2. Reads buffer bytes via the host's buffer ABI and materializes
#      them into a flat (content_ptr, content_len) snapshot.
#   3. Calls into cyim-lsp's pure-protocol API (`lsp_doc_send_*`,
#      `lsp_nav_request_sync`, `lsp_pos_*`, `lsp_diags_*`).
#   4. Writes responses back via the host's editor-state setters.
#
# To use: cyim copies this file (or its equivalent) to
# `src/plugins/lsp_glue.cyr` and includes it from `src/main.cyr`
# after `include "lib/cyim-lsp.cyr"` and cyim's plugin ABI files.
# Then cyim's `main()` calls `cyim_lsp_init()` after
# `plugin_init()` and `trailing_ws_init()`.
#
# Other editor consumers (a hypothetical `aeed-lsp` for the AGNOS
# shell, etc.) would write their own glue against their own host
# ABI; the bundle stays the same.
#
# === cyim plugin ABI consumed (per cyim ADR 0003 / 0004) ===
#
#   plugin_register_post_save_hook(fp)            fp(s, path) -> 0
#   plugin_register_post_change_hook(fp)          fp(s)       -> 0
#   plugin_register_status_segment(fp)            fp(s)       -> cstring
#   plugin_register_diagnostic_provider(fp)       fp(s, b, out_vec) -> 0
#   plugin_register_normal_key(key, fp)           fp(s)       -> action
#   plugin_register_normal_prefix_key(prefix, key, fp)        # cyim 1.4.2
#   plugin_register_ex_command(name, fp)          fp(s)       -> 0/-1
#   plugin_buf_load_file(s, path) -> buf or 0                 # cyim 1.4.2
#   plugin_list_display(s, items, count, on_select) -> 0      # cyim 1.5.0
#   KEY_G                                                     # cyim 1.4.2
#
# cyim-lsp bundle helpers consumed (besides the protocol senders):
#   lsp_uri_decode(uri) -> cstring or 0                       # cyim-lsp 1.2.1
#   lsp_ref_preview(uri, line, max_chars) -> cstring or 0     # cyim-lsp 1.4.0
#   editor_buf(s) / editor_file_path(s)           accessors (load64)
#   editor_set_status(s, msg)                     2-arg cstring set
#   buf_get(b, i) / buf_len(b)                    buffer-byte access
#   buf_cursor(b)                                 cursor offset
#   buf_move(b, off)                              cursor set
#   diag_new(line, severity, msg) / vec_push(v, item)
#   ACT_NONE / DIAG_ERROR / DIAG_WARNING / DIAG_INFO / DIAG_HINT
#
# Note: cyim has no `editor_cursor(s)` / `editor_set_cursor(s, off)`
# — cursor is per-buffer, not per-editor (cyim has multi-buffer
# state). Read via `buf_cursor(editor_buf(s))`; write via
# `buf_move(editor_buf(s), off)`.
#
# Minimum cyim version: 1.5.0 as of cyim-lsp 1.2.0 (for
# `plugin_list_display`). 1.0.x consumers continue to work against
# cyim 1.4.0+ if they stick with cyim-lsp 1.0.x glue. The bundle's
# pure-protocol ABI is unchanged across 1.0.x → 1.1.x → 1.2.x; only
# this consumer-side glue grew.

# === Buffer materialization ===
#
# cyim's gap buffer doesn't expose a flat pointer (the gap moves
# around), so we copy bytes through `buf_get`. Returns a heap-
# alloc'd buffer; caller doesn't free (cyrius's freelist reclaims
# at next GC; for typical edit sessions the leak is fine).
fn _cyim_lsp_buf_to_flat(b, len_out) {
    if (b == 0) {
        store64(len_out, 0);
        return 0;
    }
    var blen = buf_len(b);
    store64(len_out, blen);
    if (blen == 0) {
        var empty = alloc(1);
        if (empty == 0) { return 0; }
        store8(empty, 0);
        return empty;
    }
    var dst = alloc(blen);
    if (dst == 0) { return 0; }
    var i = 0;
    while (i < blen) {
        store8(dst + i, buf_get(b, i));
        i = i + 1;
    }
    return dst;
}

# === post_save hook ===

fn _cyim_lsp_post_save(s, path) {
    if (path == 0) { return 0; }
    if (lsp_path_is_cyr(path) == 0) { return 0; }
    if (lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var entry = lsp_state_lookup(b);
    if (entry == 0) {
        var uri = lsp_path_to_uri(path);
        if (uri == 0) { return 0; }
        entry = lsp_state_create(b, uri);
        if (entry == 0) { return 0; }
    }
    if (lsp_state_is_opened(entry) == 0) {
        # didSave before any change — emit didOpen first per LSP spec.
        var clen_slot[8];
        store64(&clen_slot, 0);
        var content = _cyim_lsp_buf_to_flat(b, &clen_slot);
        if (content == 0) { return 0 - 1; }
        var rc = lsp_doc_send_did_open(entry, content, load64(&clen_slot));
        if (rc != 0) { return rc; }
    }
    var uri = lsp_state_uri(entry);
    return lsp_doc_send_did_save(uri);
}

# === post_change hook ===

fn _cyim_lsp_post_change(s) {
    var path = editor_file_path(s);
    if (path == 0) { return 0; }                  # scratch buffer
    if (lsp_path_is_cyr(path) == 0) { return 0; }
    if (lsp_doc_lazy_start() != 0) { return 0; }
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var entry = lsp_state_lookup(b);
    if (entry == 0) {
        var uri = lsp_path_to_uri(path);
        if (uri == 0) { return 0; }
        entry = lsp_state_create(b, uri);
        if (entry == 0) { return 0; }
    }
    var clen_slot[8];
    store64(&clen_slot, 0);
    var content = _cyim_lsp_buf_to_flat(b, &clen_slot);
    if (content == 0) { return 0 - 1; }
    var clen = load64(&clen_slot);
    if (lsp_state_is_opened(entry) == 0) {
        return lsp_doc_send_did_open(entry, content, clen);
    }
    return lsp_doc_send_did_change(entry, content, clen);
}

# === status_segment hook ===

var _cyim_lsp_status_buf[64];

fn _cyim_lsp_status_segment(s) {
    if (lsp_client_running() != 0) {
        _lsp_drain_frames(&lsp_diags_handle_frame);
    }
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    var uri = lsp_path_to_uri(path);
    if (uri == 0) { return 0; }
    var entry = lsp_diags_lookup(uri);
    if (entry == 0) { return 0; }
    var n = lsp_diags_format_status(entry, &_cyim_lsp_status_buf, 64);
    if (n == 0) { return 0; }
    return &_cyim_lsp_status_buf;
}

# === diagnostic_provider hook ===

fn _cyim_lsp_diagnostic_provider(s, b, out_vec) {
    if (out_vec == 0) { return 0; }
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    var uri = lsp_path_to_uri(path);
    if (uri == 0) { return 0; }
    var entry = lsp_diags_lookup(uri);
    if (entry == 0) { return 0; }
    var n = lsp_diags_entry_count(entry);
    var i = 0;
    while (i < n) {
        var t = lsp_diags_entry_tuple(entry, i);
        if (t != 0) {
            var line = lsp_diag_tuple_line(t);
            var sev  = lsp_diag_tuple_severity(t);
            var msg  = lsp_diag_tuple_msg(t);
            var cyim_sev = DIAG_INFO;
            if (sev == 1) { cyim_sev = DIAG_ERROR; }
            if (sev == 2) { cyim_sev = DIAG_WARNING; }
            if (sev == 3) { cyim_sev = DIAG_INFO; }
            if (sev == 4) { cyim_sev = DIAG_HINT; }
            if (msg == 0) { msg = "(no message)"; }
            var d = diag_new(line, cyim_sev, msg);
            if (d != 0) { vec_push(out_vec, d); }
        }
        i = i + 1;
    }
    return 0;
}

# === Normal-mode prefix-key handlers (gd / gr) ===
#
# v1.1.0 — activated against cyim 1.4.2's
# `plugin_register_normal_prefix_key` ABI. The handlers delegate
# to the ex-command implementations so `gd` and `:lsp-goto-def`
# share one code path. Both return ACT_NONE — the prefix-dispatch
# pipeline expects an action_id and side effects (cursor jump /
# status set) happen during the delegate call.
#
# Built-ins win on conflict per cyim ADR 0003 §3, so the cyim
# 1.4.2 built-in `gg` (ACT_MOVE_FILE_START) shadows any plugin
# attempt to bind `(KEY_G, 'g', fp)`. `(KEY_G, 'd')` and
# `(KEY_G, 'r')` are unclaimed by built-ins, so the plugin owns
# them.

fn _cyim_lsp_gd(s) {
    _cyim_lsp_ex_goto_def(s);
    return ACT_NONE;
}

fn _cyim_lsp_gr(s) {
    _cyim_lsp_ex_find_refs(s);
    return ACT_NONE;
}

# === ex-command hooks ===

fn _cyim_lsp_ex_restart(s) {
    if (lsp_client_running() == 0) {
        if (lsp_client_start_default() == 0) {
            editor_set_status(s, "lsp: started");
            return 0;
        }
        editor_set_status(s, "lsp: start failed");
        return 0 - 1;
    }
    lsp_client_stop();
    if (lsp_client_start_default() == 0) {
        editor_set_status(s, "lsp: restarted");
        return 0;
    }
    editor_set_status(s, "lsp: restart failed");
    return 0 - 1;
}

var _cyim_lsp_status_msg[64];

fn _cyim_lsp_ex_status(s) {
    var d = lsp_client_describe();
    var dl = strlen(d);
    var prefix = "lsp: ";
    var pl = strlen(prefix);
    if (pl + dl > 63) { dl = 63 - pl; }
    var i = 0;
    while (i < pl) {
        store8(&_cyim_lsp_status_msg + i, load8(prefix + i));
        i = i + 1;
    }
    var j = 0;
    while (j < dl) {
        store8(&_cyim_lsp_status_msg + pl + j, load8(d + j));
        j = j + 1;
    }
    store8(&_cyim_lsp_status_msg + pl + dl, 0);
    editor_set_status(s, &_cyim_lsp_status_msg);
    return 0;
}

# === :lsp-goto-def ===

fn _cyim_lsp_ex_goto_def(s) {
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    if (lsp_path_is_cyr(path) == 0) { return 0; }
    _cyim_lsp_post_change(s);
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var clen_slot[8];
    store64(&clen_slot, 0);
    var content = _cyim_lsp_buf_to_flat(b, &clen_slot);
    if (content == 0) { return 0 - 1; }
    var clen = load64(&clen_slot);
    var line_slot[8];
    store64(&line_slot, 0);
    var char_slot[8];
    store64(&char_slot, 0);
    lsp_pos_offset_to_lc(content, clen, buf_cursor(b), &line_slot, &char_slot);
    var uri = lsp_path_to_uri(path);
    if (uri == 0) { return 0 - 1; }
    var blen_slot[8];
    store64(&blen_slot, 0);
    var resp = lsp_nav_request_sync(uri, load64(&line_slot), load64(&char_slot),
                                    "textDocument/definition", &blen_slot);
    if (resp == 0) {
        editor_set_status(s, "lsp: no response from server");
        return 0 - 1;
    }
    var blen = load64(&blen_slot);
    var dest_uri = lsp_pos_extract_uri(resp, blen);
    if (dest_uri == 0) {
        editor_set_status(s, "lsp: no definition found");
        return 0 - 1;
    }
    var dest_line = lsp_pos_extract_first_line(resp, blen);
    var dest_char = lsp_pos_extract_first_character(resp, blen);
    if (dest_line < 0) {
        editor_set_status(s, "lsp: no position in response");
        return 0 - 1;
    }
    if (dest_char < 0) { dest_char = 0; }
    if (lsp_streq(dest_uri, uri) == 1) {
        # Same-file: jump cursor in current buffer.
        var off = lsp_pos_lc_to_offset(content, clen, dest_line, dest_char);
        buf_move(b, off);
        return 0;
    }
    # Cross-file: load destination via cyim 1.4.2's plugin_buf_load_file.
    # dest_uri starts with "file://" per LSP §3.5; strip 7 bytes then
    # percent-decode (cyim-lsp 1.2.1+ exposes `lsp_uri_decode` for
    # paths with spaces / non-ASCII / %XX escapes).
    var dest_path = lsp_uri_decode(dest_uri + 7);
    if (dest_path == 0) {
        editor_set_status(s, "lsp: failed to decode destination URI");
        return 0 - 1;
    }
    var new_b = plugin_buf_load_file(s, dest_path);
    if (new_b == 0) {
        editor_set_status(s, "lsp: failed to load definition file");
        return 0 - 1;
    }
    # Materialize the loaded buffer's content for offset conversion.
    var nb_clen_slot[8];
    store64(&nb_clen_slot, 0);
    var nb_content = _cyim_lsp_buf_to_flat(new_b, &nb_clen_slot);
    if (nb_content == 0) { return 0 - 1; }
    var nb_off = lsp_pos_lc_to_offset(nb_content, load64(&nb_clen_slot),
                                       dest_line, dest_char);
    buf_move(new_b, nb_off);
    return 0;
}

# === :lsp-find-refs — quickfix picker (v1.2.0) ===
#
# Cyim 1.5.0's plugin_list_display ABI lets us replace the
# v1.0.x/1.1.x status-bar count with a navigable picker. Steps:
#
#   1. Send textDocument/references (same as before).
#   2. Walk the response array, pulling (uri, line, character)
#      for each location.
#   3. Build a parallel labels vec of "filename:line:col" cstrings.
#   4. Stash the (uri, line, char) parallel vecs in module-level
#      globals so the on_select callback can look them up by index.
#   5. plugin_list_display(s, labels, count, &_cyim_lsp_on_ref_select).
#
# The user picks one (j/k navigate, Enter select). on_select loads
# the file (cyim 1.4.2's plugin_buf_load_file dedups against the
# active buflist), materializes content, converts (line, char) →
# byte offset, and buf_move's the cursor.
#
# Storage is module-global. Only one find-refs picker active at a
# time (matches plugin_list_display's single-list constraint). A
# second :lsp-find-refs call replaces the parallel vecs cleanly —
# the old picker dismisses (cyim 1.5.0 semantics) before the new
# one displays, so the old payload is never needed again.

# Parallel payload vecs for the active picker. on_select indexes
# all three by the same idx.
var _cyim_lsp_refs_uris  = 0;   # vec<cstring>
var _cyim_lsp_refs_lines = 0;   # vec<i64> — LSP 0-indexed
var _cyim_lsp_refs_chars = 0;   # vec<i64> — LSP 0-indexed

# Walk a textDocument/references response body, populating the
# three parallel vecs. Returns the number of references parsed.
#
# Response shape (LSP §3.10.8):
#   {"jsonrpc":"2.0","id":N,"result":[
#     {"uri":"...","range":{"start":{"line":L,"character":C},"end":{...}}},
#     ...
#   ]}
#
# Strategy: bytescan for `"uri":"..."` then advance to the next
# `"start":{"line":N,"character":M`. Reuses the bundle's internal
# `_lsp_diags_find` / `_lsp_diag_parse_int` helpers (underscore
# prefix is documentation, not access control — these are linked
# into the consumer's TU when the bundle is folded in).
fn _cyim_lsp_parse_refs(body, blen, uris, lines, chars) {
    if (body == 0) { return 0; }
    var count = 0;
    var pos = 0;
    var go = 1;
    while (go == 1) {
        var uri_p = _lsp_diags_find(body, blen, pos, "\"uri\":\"");
        if (uri_p < 0) {
            go = 0;
        }
        if (go == 1) {
            var uri_start = uri_p + 7;
            # Walk to the closing quote.
            var uri_end = uri_start;
            var quote_found = 0;
            while (quote_found == 0) {
                if (uri_end >= blen) {
                    quote_found = 1;
                    go = 0;
                }
                if (go == 1) {
                    if (load8(body + uri_end) == 34) {
                        quote_found = 1;
                    }
                    if (quote_found == 0) { uri_end = uri_end + 1; }
                }
            }
            if (go == 1) {
                # Materialize uri as heap cstring.
                var ulen = uri_end - uri_start;
                var uri = alloc(ulen + 1);
                if (uri == 0) {
                    go = 0;
                }
                if (go == 1) {
                    var ci = 0;
                    while (ci < ulen) {
                        store8(uri + ci, load8(body + uri_start + ci));
                        ci = ci + 1;
                    }
                    store8(uri + ulen, 0);

                    # Find the next "start":{"line":N,"character":M block.
                    var start_p = _lsp_diags_find(body, blen, uri_end, "\"start\":{");
                    if (start_p < 0) { go = 0; }
                    if (go == 1) {
                        var line_p = _lsp_diags_find(body, blen, start_p, "\"line\":");
                        if (line_p < 0) { go = 0; }
                        if (go == 1) {
                            var line_np_slot[8];
                            store64(&line_np_slot, 0);
                            var line_val = _lsp_diag_parse_int(body, blen,
                                                                line_p + 7, &line_np_slot);
                            var char_p = _lsp_diags_find(body, blen, line_p, "\"character\":");
                            if (char_p < 0) { go = 0; }
                            if (go == 1) {
                                var char_np_slot[8];
                                store64(&char_np_slot, 0);
                                var char_val = _lsp_diag_parse_int(body, blen,
                                                                    char_p + 12, &char_np_slot);
                                vec_push(uris,  uri);
                                vec_push(lines, line_val);
                                vec_push(chars, char_val);
                                count = count + 1;
                                # Advance past this reference's "character" field.
                                pos = char_p + 12;
                            }
                        }
                    }
                }
            }
        }
    }
    return count;
}

# Format a "filename:line:col  preview" cstring for one reference.
# Strips the `file://` prefix from `uri`, takes the last path
# segment (everything after the last '/'), and 1-indexes
# (line, char) for display since most editors / LSP UIs surface
# 1-indexed coordinates to humans even though LSP wire format is
# 0-indexed.
#
# v1.4.0 appends a source-line preview via `lsp_ref_preview`:
# leading whitespace stripped, capped at LABEL_PREVIEW_MAX bytes,
# separated from `filename:line:col` by two spaces. Falls through
# to the bare label if the preview helper returns 0 (file too
# large, line out of range, alloc failure, etc.) — the picker
# still navigates correctly without it.
fn _cyim_lsp_label_for_ref(uri, line, char) {
    if (uri == 0) { return 0; }
    var ul = strlen(uri);
    # Find the last '/' to strip path → filename.
    var last_slash = 0 - 1;
    var i = 0;
    while (i < ul) {
        if (load8(uri + i) == 47) { last_slash = i; }
        i = i + 1;
    }
    var name_start = last_slash + 1;
    var name_len = ul - name_start;
    var line_str = _lsp_doc_itoa(line + 1);
    var char_str = _lsp_doc_itoa(char + 1);
    if (line_str == 0) { return 0; }
    if (char_str == 0) { return 0; }
    var ll = strlen(line_str);
    var cl = strlen(char_str);

    # v1.4.0: ask the bundle for a preview snippet. 80 bytes
    # comfortably fits typical popup widths without dominating;
    # the picker UI truncates further if needed.
    var preview_max = 80;
    var preview = lsp_ref_preview(uri, line, preview_max);
    var pl = 0;
    if (preview != 0) { pl = strlen(preview); }
    # Two spaces separator between coords and preview when present.
    var sep_len = 0;
    if (pl > 0) { sep_len = 2; }

    # name + ':' + line + ':' + char + sep + preview + NUL.
    var total = name_len + 1 + ll + 1 + cl + sep_len + pl + 1;
    var out = alloc(total);
    if (out == 0) { return 0; }
    var off = 0;
    var j = 0;
    while (j < name_len) {
        store8(out + off + j, load8(uri + name_start + j));
        j = j + 1;
    }
    off = off + name_len;
    store8(out + off, 58); off = off + 1;            # ':'
    j = 0;
    while (j < ll) { store8(out + off + j, load8(line_str + j)); j = j + 1; }
    off = off + ll;
    store8(out + off, 58); off = off + 1;            # ':'
    j = 0;
    while (j < cl) { store8(out + off + j, load8(char_str + j)); j = j + 1; }
    off = off + cl;
    if (pl > 0) {
        store8(out + off, 32); off = off + 1;        # ' '
        store8(out + off, 32); off = off + 1;        # ' '
        j = 0;
        while (j < pl) { store8(out + off + j, load8(preview + j)); j = j + 1; }
        off = off + pl;
    }
    store8(out + off, 0);
    return out;
}

# plugin_list_display on_select callback. Looks up the (uri, line,
# char) at `idx`, opens the file via plugin_buf_load_file (dedups
# against active buflist if already open), materializes content,
# converts (line, char) → byte offset, jumps cursor.
fn _cyim_lsp_on_ref_select(s, idx) {
    if (_cyim_lsp_refs_uris == 0) { return 0; }
    if (idx < 0) { return 0; }
    if (idx >= vec_len(_cyim_lsp_refs_uris)) { return 0; }
    var uri  = vec_get(_cyim_lsp_refs_uris,  idx);
    var line = vec_get(_cyim_lsp_refs_lines, idx);
    var char = vec_get(_cyim_lsp_refs_chars, idx);
    if (uri == 0) { return 0; }
    # Strip "file://" prefix per LSP §3.5 + percent-decode (cyim-lsp
    # 1.2.1+).
    var path = lsp_uri_decode(uri + 7);
    if (path == 0) {
        editor_set_status(s, "lsp: failed to decode reference URI");
        return 0 - 1;
    }
    var b = plugin_buf_load_file(s, path);
    if (b == 0) {
        editor_set_status(s, "lsp: failed to load reference file");
        return 0 - 1;
    }
    var clen_slot[8];
    store64(&clen_slot, 0);
    var content = _cyim_lsp_buf_to_flat(b, &clen_slot);
    if (content == 0) { return 0 - 1; }
    var off = lsp_pos_lc_to_offset(content, load64(&clen_slot), line, char);
    buf_move(b, off);
    return 0;
}

fn _cyim_lsp_ex_find_refs(s) {
    var path = editor_file_path(s);
    if (path == 0) { return 0; }
    if (lsp_path_is_cyr(path) == 0) { return 0; }
    _cyim_lsp_post_change(s);
    var b = editor_buf(s);
    if (b == 0) { return 0; }
    var clen_slot[8];
    store64(&clen_slot, 0);
    var content = _cyim_lsp_buf_to_flat(b, &clen_slot);
    if (content == 0) { return 0 - 1; }
    var clen = load64(&clen_slot);
    var line_slot[8];
    store64(&line_slot, 0);
    var char_slot[8];
    store64(&char_slot, 0);
    lsp_pos_offset_to_lc(content, clen, buf_cursor(b), &line_slot, &char_slot);
    var uri = lsp_path_to_uri(path);
    if (uri == 0) { return 0 - 1; }
    var blen_slot[8];
    store64(&blen_slot, 0);
    var resp = lsp_nav_request_sync(uri, load64(&line_slot), load64(&char_slot),
                                    "textDocument/references", &blen_slot);
    if (resp == 0) {
        editor_set_status(s, "lsp: no response from server");
        return 0 - 1;
    }
    var blen = load64(&blen_slot);

    # Parse references into fresh parallel vecs. Replaces any prior
    # picker's payload — cyim 1.5.0's plugin_list_display semantics
    # dismiss the old list before displaying the new one, so the
    # prior on_select can never fire on a stale index.
    var uris  = vec_new();
    var lines = vec_new();
    var chars = vec_new();
    var n = _cyim_lsp_parse_refs(resp, blen, uris, lines, chars);

    if (n == 0) {
        editor_set_status(s, "lsp: no references found");
        return 0;
    }

    # Build labels.
    var labels = vec_new();
    var i = 0;
    while (i < n) {
        var label = _cyim_lsp_label_for_ref(vec_get(uris, i),
                                             vec_get(lines, i),
                                             vec_get(chars, i));
        if (label != 0) { vec_push(labels, label); }
        i = i + 1;
    }

    # Stash payload for on_select.
    _cyim_lsp_refs_uris  = uris;
    _cyim_lsp_refs_lines = lines;
    _cyim_lsp_refs_chars = chars;

    plugin_list_display(s, labels, n, &_cyim_lsp_on_ref_select);
    return 0;
}

# === Public entry — register all hooks ===

fn cyim_lsp_init() {
    plugin_register_post_save_hook(&_cyim_lsp_post_save);
    plugin_register_post_change_hook(&_cyim_lsp_post_change);
    plugin_register_status_segment(&_cyim_lsp_status_segment);
    plugin_register_diagnostic_provider(&_cyim_lsp_diagnostic_provider);
    # v1.1.0 — gd / gr prefix-keymap (cyim 1.4.2 ABI).
    plugin_register_normal_prefix_key(KEY_G, 100, &_cyim_lsp_gd);   # 'd' = 100
    plugin_register_normal_prefix_key(KEY_G, 114, &_cyim_lsp_gr);   # 'r' = 114
    plugin_register_ex_command("lsp-restart",   &_cyim_lsp_ex_restart);
    plugin_register_ex_command("lsp-status",    &_cyim_lsp_ex_status);
    plugin_register_ex_command("lsp-goto-def",  &_cyim_lsp_ex_goto_def);
    plugin_register_ex_command("lsp-find-refs", &_cyim_lsp_ex_find_refs);
    return 0;
}
