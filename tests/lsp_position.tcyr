# tests/lsp_position.tcyr — position helpers + Location parser
#
# Tests:
#   - lsp_pos_offset_to_lc + lsp_pos_lc_to_offset (round-trip)
#   - lsp_pos_extract_uri / _extract_first_line / _extract_first_character
#
# Position helpers operate on flat (content_ptr, content_len)
# pairs — no consumer-side ABI stubs needed since the v1.0.2
# refactor (ADR 0001 amendment).

include "src/jsonrpc.cyr"
include "src/subprocess.cyr"
include "src/lsp_client.cyr"
include "src/lsp_state.cyr"
include "src/lsp_diags.cyr"
include "src/lsp_position.cyr"

fn _streq(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();

    var lo[8]; store64(&lo, 99);
    var co[8]; store64(&co, 99);

    test_group("offset_to_lc: empty buffer");
    var empty = "";
    lsp_pos_offset_to_lc(empty, 0, 0, &lo, &co);
    assert_eq(load64(&lo), 0, "line 0");
    assert_eq(load64(&co), 0, "char 0");

    test_group("offset_to_lc: single line");
    var hello = "hello";
    lsp_pos_offset_to_lc(hello, 5, 0, &lo, &co);
    assert_eq(load64(&lo), 0, "start: line 0");
    assert_eq(load64(&co), 0, "start: char 0");
    lsp_pos_offset_to_lc(hello, 5, 5, &lo, &co);
    assert_eq(load64(&lo), 0, "end of single line: line still 0");
    assert_eq(load64(&co), 5, "end: char 5");

    test_group("offset_to_lc: multi-line");
    var ml = "ab\ncd\nef";
    var ml_len = 8;
    lsp_pos_offset_to_lc(ml, ml_len, 0, &lo, &co);
    assert_eq(load64(&lo), 0, "off 0 -> line 0 char 0");
    assert_eq(load64(&co), 0, "");
    lsp_pos_offset_to_lc(ml, ml_len, 2, &lo, &co);
    assert_eq(load64(&lo), 0, "off 2 -> line 0 char 2 (before \\n)");
    assert_eq(load64(&co), 2, "");
    lsp_pos_offset_to_lc(ml, ml_len, 3, &lo, &co);
    assert_eq(load64(&lo), 1, "off 3 -> line 1 char 0 (just past \\n)");
    assert_eq(load64(&co), 0, "");
    lsp_pos_offset_to_lc(ml, ml_len, 4, &lo, &co);
    assert_eq(load64(&lo), 1, "off 4 -> line 1 char 1");
    assert_eq(load64(&co), 1, "");
    lsp_pos_offset_to_lc(ml, ml_len, 7, &lo, &co);
    assert_eq(load64(&lo), 2, "off 7 -> line 2 char 1");
    assert_eq(load64(&co), 1, "");

    test_group("lc_to_offset: round-trips");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 0, 0), 0, "line 0 char 0 -> off 0");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 0, 2), 2, "line 0 char 2 -> off 2");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 1, 0), 3, "line 1 char 0 -> off 3");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 2, 1), 7, "line 2 char 1 -> off 7");

    test_group("lc_to_offset: clamps to buffer end");
    var n = lsp_pos_lc_to_offset(ml, ml_len, 99, 99);
    assert_eq(n, 8, "way past end -> content_len");

    test_group("offset/lc round-trip: every offset 0..N maps back");
    var i = 0;
    while (i <= 8) {
        lsp_pos_offset_to_lc(ml, ml_len, i, &lo, &co);
        var rt = lsp_pos_lc_to_offset(ml, ml_len, load64(&lo), load64(&co));
        assert_eq(rt, i, "round-trip");
        i = i + 1;
    }

    test_group("extract_uri: pulls URI from Location response");
    var resp_def = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"uri\":\"file:///dst.cyr\",\"range\":{\"start\":{\"line\":7,\"character\":2},\"end\":{\"line\":7,\"character\":12}}}}";
    var u = lsp_pos_extract_uri(resp_def, strlen(resp_def));
    assert_neq(u, 0, "URI extracted");
    assert_eq(_streq(u, "file:///dst.cyr"), 1, "URI matches");

    test_group("extract_first_line / character");
    var ln = lsp_pos_extract_first_line(resp_def, strlen(resp_def));
    var ch = lsp_pos_extract_first_character(resp_def, strlen(resp_def));
    assert_eq(ln, 7, "line 7");
    assert_eq(ch, 2, "character 2");

    test_group("extract from Location[] (array form): peeks first");
    var resp_arr = "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":[{\"uri\":\"file:///a.cyr\",\"range\":{\"start\":{\"line\":1,\"character\":3},\"end\":{\"line\":1,\"character\":7}}},{\"uri\":\"file:///b.cyr\",\"range\":{\"start\":{\"line\":99,\"character\":99},\"end\":{}}}]}";
    var u2 = lsp_pos_extract_uri(resp_arr, strlen(resp_arr));
    assert_eq(_streq(u2, "file:///a.cyr"), 1, "first URI");
    var ln2 = lsp_pos_extract_first_line(resp_arr, strlen(resp_arr));
    assert_eq(ln2, 1, "first line");

    test_group("extract from empty result");
    var resp_empty = "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":null}";
    var u3 = lsp_pos_extract_uri(resp_empty, strlen(resp_empty));
    assert_eq(u3, 0, "no URI in null result");
    var ln3 = lsp_pos_extract_first_line(resp_empty, strlen(resp_empty));
    assert_eq(ln3, 0 - 1, "no line -> -1");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
