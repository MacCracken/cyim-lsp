# tests/lsp_position.tcyr — position helpers + Location parser
#
# Tests:
#   - lsp_pos_offset_to_lc + lsp_pos_lc_to_offset (round-trip)
#   - lsp_pos_extract_uri / _extract_first_line / _extract_first_character
#
# Position helpers operate on flat (content_ptr, content_len)
# pairs — no consumer-side ABI stubs needed since the v1.0.2
# refactor (ADR 0001 amendment).

include "src/jsonrpc.cyr"
include "src/subprocess.cyr"
include "src/lsp_client.cyr"
include "src/lsp_state.cyr"
include "src/lsp_diags.cyr"
include "src/lsp_position.cyr"

fn _streq(a, b) {
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn main() {
    alloc_init();

    var lo[8]; store64(&lo, 99);
    var co[8]; store64(&co, 99);

    test_group("offset_to_lc: empty buffer");
    var empty = "";
    lsp_pos_offset_to_lc(empty, 0, 0, &lo, &co);
    assert_eq(load64(&lo), 0, "line 0");
    assert_eq(load64(&co), 0, "char 0");

    test_group("offset_to_lc: single line");
    var hello = "hello";
    lsp_pos_offset_to_lc(hello, 5, 0, &lo, &co);
    assert_eq(load64(&lo), 0, "start: line 0");
    assert_eq(load64(&co), 0, "start: char 0");
    lsp_pos_offset_to_lc(hello, 5, 5, &lo, &co);
    assert_eq(load64(&lo), 0, "end of single line: line still 0");
    assert_eq(load64(&co), 5, "end: char 5");

    test_group("offset_to_lc: multi-line");
    var ml = "ab\ncd\nef";
    var ml_len = 8;
    lsp_pos_offset_to_lc(ml, ml_len, 0, &lo, &co);
    assert_eq(load64(&lo), 0, "off 0 -> line 0 char 0");
    assert_eq(load64(&co), 0, "");
    lsp_pos_offset_to_lc(ml, ml_len, 2, &lo, &co);
    assert_eq(load64(&lo), 0, "off 2 -> line 0 char 2 (before \\n)");
    assert_eq(load64(&co), 2, "");
    lsp_pos_offset_to_lc(ml, ml_len, 3, &lo, &co);
    assert_eq(load64(&lo), 1, "off 3 -> line 1 char 0 (just past \\n)");
    assert_eq(load64(&co), 0, "");
    lsp_pos_offset_to_lc(ml, ml_len, 4, &lo, &co);
    assert_eq(load64(&lo), 1, "off 4 -> line 1 char 1");
    assert_eq(load64(&co), 1, "");
    lsp_pos_offset_to_lc(ml, ml_len, 7, &lo, &co);
    assert_eq(load64(&lo), 2, "off 7 -> line 2 char 1");
    assert_eq(load64(&co), 1, "");

    test_group("lc_to_offset: round-trips");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 0, 0), 0, "line 0 char 0 -> off 0");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 0, 2), 2, "line 0 char 2 -> off 2");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 1, 0), 3, "line 1 char 0 -> off 3");
    assert_eq(lsp_pos_lc_to_offset(ml, ml_len, 2, 1), 7, "line 2 char 1 -> off 7");

    test_group("lc_to_offset: clamps to buffer end");
    var n = lsp_pos_lc_to_offset(ml, ml_len, 99, 99);
    assert_eq(n, 8, "way past end -> content_len");

    test_group("offset/lc round-trip: every offset 0..N maps back");
    var i = 0;
    while (i <= 8) {
        lsp_pos_offset_to_lc(ml, ml_len, i, &lo, &co);
        var rt = lsp_pos_lc_to_offset(ml, ml_len, load64(&lo), load64(&co));
        assert_eq(rt, i, "round-trip");
        i = i + 1;
    }

    test_group("extract_uri: pulls URI from Location response");
    var resp_def = "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"uri\":\"file:///dst.cyr\",\"range\":{\"start\":{\"line\":7,\"character\":2},\"end\":{\"line\":7,\"character\":12}}}}";
    var u = lsp_pos_extract_uri(resp_def, strlen(resp_def));
    assert_neq(u, 0, "URI extracted");
    assert_eq(_streq(u, "file:///dst.cyr"), 1, "URI matches");

    test_group("extract_first_line / character");
    var ln = lsp_pos_extract_first_line(resp_def, strlen(resp_def));
    var ch = lsp_pos_extract_first_character(resp_def, strlen(resp_def));
    assert_eq(ln, 7, "line 7");
    assert_eq(ch, 2, "character 2");

    test_group("extract from Location[] (array form): peeks first");
    var resp_arr = "{\"jsonrpc\":\"2.0\",\"id\":4,\"result\":[{\"uri\":\"file:///a.cyr\",\"range\":{\"start\":{\"line\":1,\"character\":3},\"end\":{\"line\":1,\"character\":7}}},{\"uri\":\"file:///b.cyr\",\"range\":{\"start\":{\"line\":99,\"character\":99},\"end\":{}}}]}";
    var u2 = lsp_pos_extract_uri(resp_arr, strlen(resp_arr));
    assert_eq(_streq(u2, "file:///a.cyr"), 1, "first URI");
    var ln2 = lsp_pos_extract_first_line(resp_arr, strlen(resp_arr));
    assert_eq(ln2, 1, "first line");

    test_group("extract from empty result");
    var resp_empty = "{\"jsonrpc\":\"2.0\",\"id\":5,\"result\":null}";
    var u3 = lsp_pos_extract_uri(resp_empty, strlen(resp_empty));
    assert_eq(u3, 0, "no URI in null result");
    var ln3 = lsp_pos_extract_first_line(resp_empty, strlen(resp_empty));
    assert_eq(ln3, 0 - 1, "no line -> -1");

    # === v1.2.1 — lsp_uri_decode ===

    test_group("uri_decode: passthrough when no escapes");
    var d1 = lsp_uri_decode("file:///abs/path.cyr");
    assert_eq(_streq(d1, "file:///abs/path.cyr"), 1, "no-escape passthrough");

    test_group("uri_decode: %20 -> space");
    var d2 = lsp_uri_decode("file:///foo%20bar.cyr");
    assert_eq(_streq(d2, "file:///foo bar.cyr"), 1, "%20 decoded to space");

    test_group("uri_decode: %2F -> /");
    var d3 = lsp_uri_decode("file:///a%2Fb.cyr");
    assert_eq(_streq(d3, "file:///a/b.cyr"), 1, "%2F decoded to slash");

    test_group("uri_decode: hex case-insensitivity");
    var d4 = lsp_uri_decode("%2f%2F%2a%2A");
    assert_eq(_streq(d4, "//**"), 1, "lower + upper hex both decode");

    test_group("uri_decode: ASCII letter via %41 / %61");
    var d5 = lsp_uri_decode("%41%61");
    assert_eq(_streq(d5, "Aa"), 1, "%41=A %61=a");

    test_group("uri_decode: UTF-8 byte via percent-encoding");
    # 'é' in UTF-8 is 0xC3 0xA9.
    var d6 = lsp_uri_decode("caf%C3%A9");
    var expected6_b0 = load8(d6 + 0);
    var expected6_b3 = load8(d6 + 3);
    var expected6_b4 = load8(d6 + 4);
    var expected6_b5 = load8(d6 + 5);
    assert_eq(expected6_b0, 99, "byte 0 = 'c'");
    assert_eq(expected6_b3, 195, "byte 3 = 0xC3");
    assert_eq(expected6_b4, 169, "byte 4 = 0xA9");
    assert_eq(expected6_b5, 0, "NUL terminator at byte 5");

    test_group("uri_decode: malformed %XY (X not hex) keeps literal '%'");
    var d7 = lsp_uri_decode("a%ZZb");
    assert_eq(_streq(d7, "a%ZZb"), 1, "%ZZ kept literal");

    test_group("uri_decode: malformed %2X (Y not hex) keeps literal '%'");
    var d8 = lsp_uri_decode("a%2Zb");
    assert_eq(_streq(d8, "a%2Zb"), 1, "%2Z kept literal");

    test_group("uri_decode: truncated %X at end -> literal '%X'");
    var d9 = lsp_uri_decode("foo%2");
    assert_eq(_streq(d9, "foo%2"), 1, "truncated %2 kept literal");

    test_group("uri_decode: bare % at end -> literal '%'");
    var d10 = lsp_uri_decode("foo%");
    assert_eq(_streq(d10, "foo%"), 1, "bare trailing % kept literal");

    test_group("uri_decode: empty input -> empty cstring");
    var d11 = lsp_uri_decode("");
    assert_eq(_streq(d11, ""), 1, "empty input -> empty output");

    test_group("uri_decode: NULL input -> 0");
    var d12 = lsp_uri_decode(0);
    assert_eq(d12, 0, "null input -> null return");

    test_group("uri_decode: mixed escapes + literals");
    var d13 = lsp_uri_decode("/path/to/foo%20bar%2Fbaz.cyr");
    assert_eq(_streq(d13, "/path/to/foo bar/baz.cyr"), 1, "mixed encoding decoded");

    # === lsp_ref_preview (v1.4.0) ===
    #
    # Tests need a real file on disk because lsp_ref_preview's
    # core path is file_read_all → walk-to-line → strip → cap.
    # Fixture: /tmp/cyim-lsp-ref-preview-test.txt.

    var fixture_path = "/tmp/cyim-lsp-ref-preview-test.txt";
    var fixture_uri  = "file:///tmp/cyim-lsp-ref-preview-test.txt";
    # Layout (0-indexed lines):
    #   line 0: "first line"
    #   line 1: "    second line with leading spaces"
    #   line 2: "\tthird line with leading tab"
    #   line 3: "fourth line is much much much longer than thirty bytes for the cap test"
    #   line 4: "trailing CR follows\r" (CRLF — strip CR before cap)
    #   line 5: "" (empty line)
    #   line 6: "after empty"
    var fixture_body = "first line\n    second line with leading spaces\n\tthird line with leading tab\nfourth line is much much much longer than thirty bytes for the cap test\ntrailing CR follows\r\n\nafter empty\n";
    file_write_all(fixture_path, fixture_body, strlen(fixture_body));

    test_group("ref_preview: line 0 — plain content, no leading whitespace");
    var p0 = lsp_ref_preview(fixture_uri, 0, 80);
    assert_eq(_streq(p0, "first line"), 1, "line 0 returned verbatim");

    test_group("ref_preview: line 1 — leading spaces stripped");
    var p1 = lsp_ref_preview(fixture_uri, 1, 80);
    assert_eq(_streq(p1, "second line with leading spaces"), 1, "leading 4 spaces stripped");

    test_group("ref_preview: line 2 — leading tab stripped");
    var p2 = lsp_ref_preview(fixture_uri, 2, 80);
    assert_eq(_streq(p2, "third line with leading tab"), 1, "leading tab stripped");

    test_group("ref_preview: line 3 — capped at max_chars");
    var p3 = lsp_ref_preview(fixture_uri, 3, 30);
    assert_eq(strlen(p3), 30, "exactly max_chars bytes");
    assert_eq(_streq(p3, "fourth line is much much much "), 1, "first 30 bytes returned");

    test_group("ref_preview: line 4 — CR stripped before cap");
    var p4 = lsp_ref_preview(fixture_uri, 4, 80);
    assert_eq(_streq(p4, "trailing CR follows"), 1, "CRLF -> CR stripped");

    test_group("ref_preview: line 5 — empty line returns empty cstring");
    var p5 = lsp_ref_preview(fixture_uri, 5, 80);
    assert_eq(_streq(p5, ""), 1, "empty line -> empty output");
    assert_eq(strlen(p5), 0, "strlen 0 on empty preview");

    test_group("ref_preview: line 6 — line after empty line");
    var p6 = lsp_ref_preview(fixture_uri, 6, 80);
    assert_eq(_streq(p6, "after empty"), 1, "line walk handles empty intermediate");

    test_group("ref_preview: line out of range -> 0");
    var p_oob = lsp_ref_preview(fixture_uri, 999, 80);
    assert_eq(p_oob, 0, "line 999 -> null");

    test_group("ref_preview: null uri -> 0");
    var p_null = lsp_ref_preview(0, 0, 80);
    assert_eq(p_null, 0, "null uri -> null");

    test_group("ref_preview: zero max_chars -> 0");
    var p_zero = lsp_ref_preview(fixture_uri, 0, 0);
    assert_eq(p_zero, 0, "max_chars=0 -> null");

    test_group("ref_preview: negative max_chars -> 0");
    var p_neg = lsp_ref_preview(fixture_uri, 0, 0 - 5);
    assert_eq(p_neg, 0, "max_chars<0 -> null");

    test_group("ref_preview: missing file -> 0");
    var p_miss = lsp_ref_preview("file:///tmp/cyim-lsp-this-does-not-exist-12345.txt", 0, 80);
    assert_eq(p_miss, 0, "missing file -> null");

    return assert_summary();
}

var exit_code = main();
syscall(60, exit_code);
