# lsp_client.cyr — LSP protocol client (v0.3.0)
#
# High-level layer above subprocess.cyr + jsonrpc.cyr:
#   - Spawns cyrius-lsp (or any LSP server cmd) and runs the
#     `initialize` handshake
#   - Owns the per-process state: proc handle (pid + pipe fds),
#     last received frame, attached/detached flag
#   - Issues `shutdown` + `exit` cleanly when stopping
#
# Protocol shape (LSP §3.7 LifeCycle):
#   1. Client → Server: `initialize` request (id=1)
#   2. Server → Client: `initialize` response (id=1, result has capabilities)
#   3. Client → Server: `initialized` notification
#   4. … traffic …
#   5. Client → Server: `shutdown` request
#   6. Server → Client: `shutdown` response
#   7. Client → Server: `exit` notification
#   8. Server exits
#
# v0.3.0 implements 1, 2, 3, 5, 6, 7, 8. Step 4 (real document
# sync via post_save / post_change hooks) lands in v0.4.0 / M3.
#
# Public surface (frozen for v0.3.x):
#   lsp_client_running()                  -> pid (>0 if attached, 0 otherwise)
#   lsp_client_describe()                 -> cstring
#   lsp_client_start(cmd_path)            -> 0 / -1
#   lsp_client_stop()                     -> 0 / -1
#   lsp_client_proc()                     -> proc handle (or 0)

# Per-client state. _lsp_proc holds the subprocess handle; null
# means "no server attached". Single-server design — multi-server
# multiplexing is post-v1.0 per the cyim-lsp roadmap "Out of scope".
var _lsp_proc = 0;

# Static description buffer, regenerated on each `lsp_client_describe`
# call. 64 bytes accommodates "cyrius-lsp pid=<i64-decimal> (running)"
# or the "(not attached)" alternative.
var _lsp_describe_buf[64];

# Public: returns the child pid if attached, 0 if not. Reads past
# `lsp_proc_close` are safe — the close marks pid = -1, and we
# treat any non-positive value as detached.
fn lsp_client_running() {
    if (_lsp_proc == 0) { return 0; }
    var pid = lsp_proc_pid(_lsp_proc);
    if (pid <= 0) { return 0; }
    return pid;
}

fn lsp_client_proc() {
    return _lsp_proc;
}

# Render a human-readable description into `_lsp_describe_buf` and
# return a pointer to it. Used by:
#   - main.cyr's standalone driver (smoke output)
#   - the v0.5.0+ `:lsp-status` ex-command
fn lsp_client_describe() {
    var pid = lsp_client_running();
    if (pid == 0) {
        var s = "(not attached)";
        var sl = strlen(s);
        var i = 0;
        while (i < sl) {
            store8(&_lsp_describe_buf + i, load8(s + i));
            i = i + 1;
        }
        store8(&_lsp_describe_buf + sl, 0);
        return &_lsp_describe_buf;
    }
    # "cyrius-lsp pid=" + decimal pid
    var prefix = "cyrius-lsp pid=";
    var pl = strlen(prefix);
    var off = 0;
    while (off < pl) {
        store8(&_lsp_describe_buf + off, load8(prefix + off));
        off = off + 1;
    }
    # Inline itoa for pid (mirrors trailing_ws's pattern in cyim).
    var tmp[24];
    var tlen = 0;
    var v = pid;
    if (v == 0) {
        store8(&tmp, 48);
        tlen = 1;
    } else {
        while (v > 0) {
            store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
            v = v / 10;
            tlen = tlen + 1;
        }
    }
    var j = 0;
    while (j < tlen) {
        store8(&_lsp_describe_buf + off, load8(&tmp + tlen - 1 - j));
        off = off + 1;
        j = j + 1;
    }
    store8(&_lsp_describe_buf + off, 0);
    return &_lsp_describe_buf;
}

# Read one framed JSON-RPC message from the server. Allocates a
# heap buffer, accumulates bytes via lsp_proc_recv, calls
# jsonrpc_parse_frame after each read until a complete frame is
# present (or error / EOF).
#
# Writes body offset + length to *off_out / *len_out.
# Returns the buffer pointer on success, 0 on error (alloc fail,
# malformed frame, EOF mid-frame, oversized frame).
#
# v0.3.0 uses an 8 KB buffer — handles initialize + shutdown
# responses (typically <2 KB). v0.4.0+ may need to grow for
# publishDiagnostics on large files; that's a wrap-and-grow
# refinement.
fn _lsp_recv_frame(off_out, len_out) {
    if (_lsp_proc == 0) { return 0; }
    var cap = 8192;
    var buf = alloc(cap);
    if (buf == 0) { return 0; }
    var total = 0;
    var go = 1;
    while (go == 1) {
        if (total >= cap) {
            # Frame larger than v0.3.0 buffer cap.
            return 0;
        }
        var n = lsp_proc_recv(_lsp_proc, buf + total, cap - total);
        if (n <= 0) {
            # 0 = EOF mid-frame, < 0 = error.
            return 0;
        }
        total = total + n;
        var off_slot[8];
        store64(&off_slot, 0);
        var len_slot[8];
        store64(&len_slot, 0);
        var rc = jsonrpc_parse_frame(buf, total, &off_slot, &len_slot);
        if (rc == 1) {
            store64(off_out, load64(&off_slot));
            store64(len_out, load64(&len_slot));
            return buf;
        }
        if (rc == 0 - 1) {
            return 0;
        }
        # rc == 0: incomplete; loop and read more.
    }
    return 0;
}

# Send `msg` (a framed JSON-RPC cstring) to the server, writing
# all bytes (handling short writes). Returns 0 on success, -1 on
# error.
fn _lsp_send_all(msg) {
    if (_lsp_proc == 0) { return 0 - 1; }
    var total = strlen(msg);
    var sent = 0;
    var go = 1;
    while (go == 1) {
        if (sent >= total) { go = 0; }
        if (go == 1) {
            var n = lsp_proc_send(_lsp_proc, msg + sent, total - sent);
            if (n <= 0) { return 0 - 1; }
            sent = sent + n;
        }
    }
    return 0;
}

# Send the LSP `initialize` request and wait for the response.
# Discards capabilities for v0.3.0 (just verifies the response
# parses cleanly). v0.4.0+ stores capabilities for feature
# negotiation (e.g. did we get definitionProvider?).
fn _lsp_initialize() {
    var id = jsonrpc_next_id();
    # Minimal initialize params per LSP §3.7.1. processId=null is
    # accepted by cyrius-lsp; rootUri=null too. capabilities={}
    # signals "client supports nothing optional".
    var params = "{\"processId\":null,\"rootUri\":null,\"capabilities\":{}}";
    var msg = jsonrpc_build_request(id, "initialize", params);
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    # Read response. v0.3.0 just verifies a frame arrives — no
    # capability inspection.
    var off_slot[8];
    store64(&off_slot, 0);
    var len_slot[8];
    store64(&len_slot, 0);
    var resp = _lsp_recv_frame(&off_slot, &len_slot);
    if (resp == 0) { return 0 - 1; }
    # Send `initialized` notification — LSP requires this to
    # signal "ready to send didOpen" etc. Empty params per spec.
    var notif = jsonrpc_build_notification("initialized", "{}");
    if (notif == 0) { return 0 - 1; }
    if (_lsp_send_all(notif) != 0) { return 0 - 1; }
    # v0.5.0: switch the read fd to non-blocking so the periodic
    # frame drain (called from cyim's diagnostic_provider hook
    # per render frame) can return immediately when no server-
    # pushed notifications are waiting. The handshake above used
    # blocking reads — once the protocol is established and the
    # only inbound traffic is async notifications (publishDiagnostics
    # etc.), non-blocking is the right mode.
    lsp_proc_set_nonblock(_lsp_proc);
    return 0;
}

# Drain available frames from the server. Reads bytes non-blocking,
# accumulates into a buffer, parses complete frames as they arrive,
# and dispatches each to `handler_fp(body_ptr, body_len)`. Stops
# when the read fd has no more bytes available right now (EAGAIN).
#
# Returns the number of frames successfully dispatched. -1 on
# unrecoverable error (alloc / read).
#
# Buffer management: 16 KB scratch per call. Frames larger than
# that get rejected by jsonrpc_parse_frame's incomplete-buffer
# branch — same cap as the v0.3.0 _lsp_recv_frame; v0.5.x can
# grow if real-world diagnostics push past it.
fn _lsp_drain_frames(handler_fp) {
    if (_lsp_proc == 0) { return 0; }
    var cap = 16384;
    var buf = alloc(cap);
    if (buf == 0) { return 0 - 1; }
    var total = 0;
    var dispatched = 0;
    var go = 1;
    while (go == 1) {
        if (total >= cap) { go = 0; }
        if (go == 1) {
            var n = lsp_proc_recv_nb(_lsp_proc, buf + total, cap - total);
            if (n == 0 - 2) {
                # EAGAIN: no more data right now. Try parsing
                # what we have, then exit.
                go = 0;
            }
            if (n == 0) {
                # EOF: server exited; bail.
                return dispatched;
            }
            if (n < 0) {
                if (n != 0 - 2) { return 0 - 1; }
            }
            if (n > 0) { total = total + n; }
        }
        # Parse + dispatch every complete frame in [0, total).
        var parse_more = 1;
        while (parse_more == 1) {
            var off_slot[8];
            store64(&off_slot, 0);
            var len_slot[8];
            store64(&len_slot, 0);
            var rc = jsonrpc_parse_frame(buf, total, &off_slot, &len_slot);
            if (rc == 1) {
                var body_off = load64(&off_slot);
                var body_len = load64(&len_slot);
                fncall2(handler_fp, buf + body_off, body_len);
                dispatched = dispatched + 1;
                # Shift remaining bytes left; we may have started
                # the next frame's header.
                var remaining = total - (body_off + body_len);
                if (remaining > 0) {
                    var i = 0;
                    while (i < remaining) {
                        store8(buf + i, load8(buf + body_off + body_len + i));
                        i = i + 1;
                    }
                }
                total = remaining;
            }
            if (rc != 1) { parse_more = 0; }
            if (rc == 0 - 1) {
                # Malformed: drop the buffer to recover. Future
                # bytes start fresh.
                total = 0;
            }
        }
    }
    return dispatched;
}

# === v0.6.0: synchronous request/response helper ===
#
# `_lsp_request_sync` sends a JSON-RPC request and polls the drain
# until a response arrives with the matching id, or until
# `max_iters` polling cycles elapse (rough timeout — each cycle
# does one non-blocking read attempt + tight loop).
#
# Used by navigation (textDocument/definition, references) where
# the user presses a key / runs an ex-command and expects a
# result without returning to the editor's render loop. LSP
# responses to definition queries from cyrius-lsp typically
# arrive within a few ms; max_iters of 1000 (with a tight inner
# loop) gives ample headroom without freezing cyim if the server
# is slow / dead.
#
# Notification handlers (publishDiagnostics) registered with
# `_lsp_drain_frames` still fire during the wait — non-response
# frames just go through the normal handler chain.
#
# Returns the body buffer + sets *body_off_out / *body_len_out
# on success. 0 on timeout / error.

# State for matching incoming responses to the in-flight request.
var _lsp_pending_id     = 0;
var _lsp_pending_body   = 0;
var _lsp_pending_off    = 0;
var _lsp_pending_len    = 0;

# Frame handler invoked by drain when waiting for a response. If
# the frame's `"id":N` matches the pending request id, capture
# the body for the caller and clear the pending slot. Other
# frames (notifications) get dispatched to lsp_diags_handle_frame
# so publishDiagnostics still updates state during sync waits.
fn _lsp_response_handler(body, body_len) {
    if (_lsp_pending_id == 0) {
        # Not currently waiting — let other handlers (diags) see it.
        lsp_diags_handle_frame(body, body_len);
        return 0;
    }
    # Look for `"id":<n>` (response). Bytescan because we don't
    # have the json stdlib parser in this hot path.
    var id_marker = "\"id\":";
    var ip = _lsp_diags_find(body, body_len, 0, id_marker);
    if (ip < 0) {
        # No id field → notification (publishDiagnostics, etc).
        lsp_diags_handle_frame(body, body_len);
        return 0;
    }
    var np_slot[8];
    store64(&np_slot, 0);
    var fid = _lsp_diag_parse_int(body, body_len, ip + 5, &np_slot);
    if (fid != _lsp_pending_id) {
        # Response to some other request, or the id is wrong.
        lsp_diags_handle_frame(body, body_len);
        return 0;
    }
    # Match: capture body for the caller. Allocate copy so the
    # frame buffer (drain's scratch) can be reused.
    var copy = alloc(body_len + 1);
    if (copy == 0) { return 0; }
    var i = 0;
    while (i < body_len) {
        store8(copy + i, load8(body + i));
        i = i + 1;
    }
    store8(copy + body_len, 0);
    _lsp_pending_body = copy;
    _lsp_pending_off  = 0;
    _lsp_pending_len  = body_len;
    _lsp_pending_id   = 0;   # clear pending — caller picks up
    return 0;
}

# Send `request_msg` (a framed JSON-RPC cstring built by
# jsonrpc_build_request) and poll until the response with
# `expected_id` arrives or `max_iters` polling cycles elapse.
# Returns response body cstring (heap-owned, length in *len_out)
# or 0 on timeout / error.
fn _lsp_request_sync(request_msg, expected_id, body_len_out, max_iters) {
    if (_lsp_proc == 0) { return 0; }
    if (_lsp_pending_id != 0) {
        # Already waiting on a different request — concurrent
        # sync requests not supported in v0.6.0.
        return 0;
    }
    _lsp_pending_id   = expected_id;
    _lsp_pending_body = 0;
    _lsp_pending_len  = 0;
    if (_lsp_send_all(request_msg) != 0) {
        _lsp_pending_id = 0;
        return 0;
    }
    var iter = 0;
    var go = 1;
    while (go == 1) {
        if (iter >= max_iters) { go = 0; }
        if (go == 1) {
            _lsp_drain_frames(&_lsp_response_handler);
            if (_lsp_pending_body != 0) {
                # Response arrived (handler captured it).
                store64(body_len_out, _lsp_pending_len);
                var b = _lsp_pending_body;
                _lsp_pending_body = 0;
                _lsp_pending_len  = 0;
                return b;
            }
            iter = iter + 1;
        }
    }
    # Timeout: clear pending so future calls can retry.
    _lsp_pending_id = 0;
    return 0;
}

# Send `shutdown` request, await response, then send `exit`
# notification. After this the server should exit on its own;
# lsp_proc_close still calls sys_waitpid to reap.
fn _lsp_shutdown_handshake() {
    var id = jsonrpc_next_id();
    var msg = jsonrpc_build_request(id, "shutdown", "null");
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    var off_slot[8];
    store64(&off_slot, 0);
    var len_slot[8];
    store64(&len_slot, 0);
    var resp = _lsp_recv_frame(&off_slot, &len_slot);
    if (resp == 0) {
        # Server may have crashed mid-shutdown; not fatal.
        return 0 - 1;
    }
    var exit_notif = jsonrpc_build_notification("exit", "null");
    if (exit_notif == 0) { return 0 - 1; }
    if (_lsp_send_all(exit_notif) != 0) { return 0 - 1; }
    return 0;
}

# Spawn + initialize handshake. Internal entry point — public
# variants vary the cmd argv shape.
fn _lsp_client_start_with(cmd, arg1, arg2) {
    if (_lsp_proc != 0) {
        # Already attached — caller should stop before restart.
        return 0 - 1;
    }
    var p = lsp_proc_spawn(cmd, arg1, arg2);
    if (p == 0) { return 0 - 1; }
    _lsp_proc = p;
    var rc = _lsp_initialize();
    if (rc != 0) {
        # Handshake failed; clean up.
        lsp_proc_close(_lsp_proc);
        _lsp_proc = 0;
        return 0 - 1;
    }
    return 0;
}

# Spawn `cmd_path` (absolute path expected) and run the LSP
# `initialize` handshake. Returns 0 on success, -1 on any failure
# (already running, spawn failed, handshake failed).
fn lsp_client_start(cmd_path) {
    return _lsp_client_start_with(cmd_path, 0, 0);
}

# Spawn `cyrius-lsp` via PATH lookup (`/usr/bin/env cyrius-lsp`)
# and run the initialize handshake. The default entry point used
# by lsp_documents' lazy-start path. Returns 0 on success, -1 on
# any failure.
fn lsp_client_start_default() {
    return _lsp_client_start_with("/usr/bin/env", "cyrius-lsp", 0);
}

# Run shutdown handshake then close + reap. Idempotent — safe to
# call when no server is attached. Returns 0 in both cases (the
# handshake-failure path still closes pipes + reaps).
fn lsp_client_stop() {
    if (_lsp_proc == 0) { return 0; }
    _lsp_shutdown_handshake();
    lsp_proc_close(_lsp_proc);
    _lsp_proc = 0;
    return 0;
}
