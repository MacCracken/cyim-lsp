# subprocess.cyr — bidirectional-pipe subprocess primitives (v0.3.0)
#
# cyim-lsp spawns cyrius-lsp as a subprocess and talks to it over
# stdin/stdout pipes (LSP protocol convention). This file owns the
# pipe + fork + exec dance and the per-process handle.
#
# Why not stdlib's `process.cyr` `spawn()`? That helper is
# unidirectional (run + capture stdout). LSP needs both directions
# in flight simultaneously: parent writes requests / notifications
# to child stdin while reading responses / publishDiagnostics from
# child stdout.
#
# Public surface (frozen for v0.3.x):
#   lsp_proc_spawn(cmd, arg1, arg2)       -> proc handle (heap) or 0
#   lsp_proc_send(proc, buf, len)         -> bytes written, or -1
#   lsp_proc_recv(proc, buf, max)         -> bytes read, or -1 / 0 (EOF)
#   lsp_proc_close(proc)                  -> 0 on success, -1 on error
#   lsp_proc_pid(proc)                    -> child pid, or -1 if closed
#
# Proc handle layout (32 B):
#   +0   pid           i64 (set to -1 by close)
#   +8   read_fd       i64 (parent reads child stdout)
#   +16  write_fd      i64 (parent writes to child stdin)
#   +24  reserved      i64 (future: spawn-side state, e.g. capabilities ptr)
#
# Pipe orientation:
#   p_in[2]:  parent → child (parent writes p_in[1], child reads p_in[0] as stdin)
#   p_out[2]: child → parent (child writes p_out[1] as stdout, parent reads p_out[0])
#
# After fork, parent closes the child's ends; child closes the
# parent's ends, dup2's its halves to stdin/stdout, then execve.

# =====================================================================
# Capability gate — the spawn half does not exist on agnos.
# =====================================================================
#
# agnos has no `sys_fork` / `sys_execve` / `sys_dup2` at all. Its frozen
# process band is run-to-completion only — `execwait#37` (load a static ELF64,
# block until it exits) and `spawn_path#43` (non-blocking, but with no way to
# wire the child's stdin/stdout to a pipe). Neither can host the *persistent
# bidirectional* connection LSP is defined on, and there is no language server
# to spawn on agnos anyway. `fork` is reserved as syscall #96 and unimplemented
# (agnos `docs/development/roadmap.md`), so this is not a near-term gap to code
# around — it is a capability the target does not have.
#
# ⛔ THIS GATE IS NOT ONLY ABOUT COMPILING. Three functions here reach the
# kernel by RAW LINUX SYSCALL NUMBER, and agnos assigns those same numbers to
# completely different calls — so on agnos they would not fail, they would do
# something else and look like they worked:
#
#     used here      Linux            agnos (syscalls_x86_64_agnos.cyr)
#     syscall(0,…)   read             SYS_EXIT        — terminates the editor
#     syscall(2,…)   open             SYS_GETPID      — returns a pid, so the
#                                                       `fd < 0` guard PASSES
#     syscall(3,…)   close            SYS_SPAWN       — spawns an in-memory ELF
#     syscall(72,…)  fcntl            SYS_SHM_WRITE   — writes shared memory
#
# `syscall(72, read_fd, 4, flags | 2048)` — a "set O_NONBLOCK" — is
# `shm_write(id, user_src, size)` on agnos. That is the worst shape available:
# a silent write through a caller-controlled pointer, from code whose stated
# intent is to flip a flag. Gating these out of the agnos build is the fix; a
# runtime `if` would still leave the call sites compiled and one bad branch
# away from firing. Same class of per-target hazard kriya documents in
# `src/lib/sys.cyr` ("raw Linux-numbered syscalls are a silent footgun").
#
# ⛔ THE ARMS MUST WRAP WHOLE FUNCTION BODIES, NOT SIT INSIDE THEM AS AN EARLY
# RETURN. `#ifdef CYRIUS_TARGET_AGNOS return 0; #endif` at the top of a function
# leaves the REST of that function outside the conditional and therefore still
# compiled — the undefined symbol survives, and only the runtime path changes.
# Every function below that touches the spawn half is written as a matched
# `#ifdef` / `#ifndef` PAIR of complete definitions.
#
# `LSP_HAVE_SUBPROC` is the consumer-facing flag: 0 means `lsp_proc_spawn` will
# always refuse, so a consumer can skip registering LSP entirely (cyim does
# exactly this in `src/plugins/lsp_glue.cyr`) or report "not supported on this
# system" instead of surfacing a spawn failure as an error.

#ifdef CYRIUS_TARGET_AGNOS
enum LspSysCap {
    LSP_HAVE_SUBPROC = 0;   # no fork / execve / dup2; no fcntl
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
enum LspSysCap {
    LSP_HAVE_SUBPROC = 1;
}
#endif

# Accessor so consumers can branch on the capability without depending on
# enum visibility through the bundle concatenation.
fn lsp_have_subproc() {
    return LSP_HAVE_SUBPROC;
}

# Read /proc/self/environ and build a NUL-terminated envp array of
# cstring pointers suitable for execve. Returns 0 on read or alloc
# failure (caller falls back to empty envp).
#
# v1.0.3: introduced because v1.0.0–v1.0.2's empty-envp pattern broke
# `lsp_client_start_default()` — `/usr/bin/env cyrius-lsp` can't
# resolve PATH lookups when the child has no env. Per cyim-lsp's
# trust model (cyim ADR 0001 single-user, not a privilege boundary)
# env passthrough is fine; argv hygiene (which v1.0.0 already
# enforces) remains the command-injection defense.
#
# agnos arm: there is no `/proc`, and the raw numbers below mean getpid / exit /
# spawn there (see the capability-gate note above). Answer 0 — the same "no
# envp" result the Linux arm gives on read/alloc failure — and let the caller
# take its existing fallback path. Unreachable in practice because
# `lsp_proc_spawn` refuses first; defined so the agnos build carries no
# mis-numbered call at all.
#ifdef CYRIUS_TARGET_AGNOS
fn _lsp_proc_envp_from_self() {
    return 0;
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
fn _lsp_proc_envp_from_self() {
    var fd = syscall(2, "/proc/self/environ", 0, 0);   # SYS_open, O_RDONLY
    if (fd < 0) { return 0; }
    # 64 KB cap: typical environ is < 4 KB; 64 KB covers any reasonable
    # interactive session including XDG / DBUS / dev-tool exports.
    var buf = alloc(65536);
    if (buf == 0) {
        syscall(3, fd);   # SYS_close
        return 0;
    }
    var n = syscall(0, fd, buf, 65536);   # SYS_read
    syscall(3, fd);
    if (n <= 0) { return 0; }
    # Count NUL-separated entries.
    var nentries = 0;
    var i = 0;
    while (i < n) {
        if (load8(buf + i) == 0) { nentries = nentries + 1; }
        i = i + 1;
    }
    # envp = (nentries + 1) i64 slots: one ptr per entry + NULL terminator.
    var envp = alloc((nentries + 1) * 8);
    if (envp == 0) { return 0; }
    var slot = 0;
    var start = 0;
    i = 0;
    while (i < n) {
        if (load8(buf + i) == 0) {
            # Entry [start, i) is already NUL-terminated in `buf`;
            # store the pointer-into-buf as the envp slot.
            store64(envp + slot * 8, buf + start);
            slot = slot + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    store64(envp + slot * 8, 0);   # NULL terminator
    return envp;
}
#endif

# Build the argv array for execve. Mirrors process.cyr's `_exec3`
# but inlined here so we don't need to depend on process.cyr's
# internal-only helper. argv layout: [cmd, arg1?, arg2?, NULL].
#
# envp inherits the parent's environment via /proc/self/environ
# (v1.0.3+). On read/alloc failure falls back to empty envp; that
# fallback path means /usr/bin/env-based commands won't resolve,
# but absolute-path commands (lsp_client_start("/abs/path")) still
# work.
#
# agnos arm: `sys_execve` does not exist. Answer -1 so a caller that somehow
# reached here gets a failure rather than an undefined call. (The Linux arm can
# never actually return -1: a successful execve does not come back, and a failed
# one calls sys_exit.)
#ifdef CYRIUS_TARGET_AGNOS
fn _lsp_proc_exec(cmd, arg1, arg2) {
    return 0 - 1;
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
fn _lsp_proc_exec(cmd, arg1, arg2) {
    # ⭐⭐ SIZED IN BYTES, NOT POINTER SLOTS. In Cyrius `var buf[N]` reserves
    # **N bytes**, and this array holds four 64-bit pointers — cmd, arg1,
    # arg2, NULL — so it needs 4 * 8 = 32.
    #
    # It said `var argv[4]` from v0.2.0 through v1.5.2: a FOUR-BYTE buffer
    # taking up to 32 bytes of pointer writes. That is the whole of the
    # "LSP never starts" bug. `lsp_client_start_default()` passes
    # ("/usr/bin/env", "cyrius-lsp", 0), so `ai` reaches 2 and the writes
    # span [0, 24) — six times the declared size. The adjacent stack was
    # clobbered, `execve` got a malformed argv, it failed, and the child fell
    # through to its own `sys_exit(127)`. Every consumer saw
    # `lsp_client_start_default()` answer -1 with nothing on stderr, because
    # execve never took and so `env` was never there to complain.
    #
    # ⚠ The 4-byte version SURVIVED the test suite, and it is worth knowing
    # why: `tests/subprocess.tcyr` spawned `/bin/cat` with arg1 = arg2 = 0, so
    # `ai` stayed at 1 and only 16 bytes were written — a smaller overrun that
    # happened not to break that particular exec. The regression test added in
    # v1.5.3 spawns WITH arguments, which is the shape that actually failed.
    #
    # This is the same slot-vs-byte mistake `lsp_proc_close`'s
    # `var status_buf[1]` had, fixed at v1.5.2 (see its note ~150 lines down).
    # That sweep caught the reap buffer and missed this one.
    var argv[32];               # 4 pointer slots * 8 bytes
    store64(&argv, cmd);
    var ai = 1;
    if (arg1 != 0) { store64(&argv + ai * 8, arg1); ai = ai + 1; }
    if (arg2 != 0) { store64(&argv + ai * 8, arg2); ai = ai + 1; }
    store64(&argv + ai * 8, 0);
    var envp = _lsp_proc_envp_from_self();
    if (envp == 0) {
        # Fallback: empty envp. /usr/bin/env-based commands will
        # fail (cf. lsp_client_start_default); absolute-path
        # commands still work.
        var fallback[8];        # one NULL pointer slot — 8 bytes, not 1
        store64(&fallback, 0);
        sys_execve(cmd, &argv, &fallback);
        sys_exit(127);
        return 0;
    }
    sys_execve(cmd, &argv, envp);
    # If execve returns, exec failed.
    sys_exit(127);
    return 0;
}
#endif

# Spawn `cmd` with optional arg1 / arg2 (pass 0 to omit). Sets up
# bidirectional pipes; returns a 32 B proc handle on success, 0 on
# any failure (pipe / fork / alloc).
#
# Caller is responsible for calling lsp_proc_close to reap the
# child and free the pipe fds. Forgetting close leaks fds + leaves
# a zombie process; always pair spawn with close.
#
# ⭐ agnos arm: THIS IS THE ONE THAT MATTERS — it is the single door into the
# whole spawn half, so refusing here makes every function downstream
# unreachable with a handle of 0, which they all already treat as "not
# attached" and answer -1 for. `_lsp_client_start_with` has tested
# `if (p == 0) { return 0 - 1; }` since v0.3.0, so a consumer that calls
# `lsp_client_start*` on agnos gets the ordinary "server did not start"
# failure it already handles — no new error path, no partial state, and no
# pipe fds leaked (we never open them).
#
# Refusing BEFORE `sys_pipe` is deliberate even though agnos does have
# `pipe#…`: a pipe pair we can never hand to a child is just two leaked fds.
#ifdef CYRIUS_TARGET_AGNOS
fn lsp_proc_spawn(cmd, arg1, arg2) {
    return 0;
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
fn lsp_proc_spawn(cmd, arg1, arg2) {
    var p_in[16];
    var p_out[16];
    if (sys_pipe(&p_in) < 0) { return 0; }
    if (sys_pipe(&p_out) < 0) {
        sys_close(load32(&p_in));
        sys_close(load32(&p_in + 4));
        return 0;
    }
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(load32(&p_in));
        sys_close(load32(&p_in + 4));
        sys_close(load32(&p_out));
        sys_close(load32(&p_out + 4));
        return 0;
    }
    if (pid == 0) {
        # Child: close parent's ends, wire halves to stdin/stdout.
        sys_close(load32(&p_in + 4));   # parent's write end of input pipe
        sys_close(load32(&p_out));      # parent's read end of output pipe
        sys_dup2(load32(&p_in), 0);     # stdin = read end of input pipe
        sys_dup2(load32(&p_out + 4), 1); # stdout = write end of output pipe
        sys_close(load32(&p_in));
        sys_close(load32(&p_out + 4));
        _lsp_proc_exec(cmd, arg1, arg2);
        # Unreachable; _lsp_proc_exec calls sys_exit on failure.
        sys_exit(127);
    }
    # Parent: close child's ends, build the handle.
    sys_close(load32(&p_in));        # child's read end of input pipe
    sys_close(load32(&p_out + 4));   # child's write end of output pipe
    var proc = alloc(32);
    if (proc == 0) {
        sys_close(load32(&p_in + 4));
        sys_close(load32(&p_out));
        return 0;
    }
    store64(proc,      pid);
    store64(proc + 8,  load32(&p_out));     # parent reads child stdout from here
    store64(proc + 16, load32(&p_in + 4));  # parent writes to child stdin here
    store64(proc + 24, 0);
    return proc;
}
#endif

# Accessors.
fn lsp_proc_pid(proc) {
    if (proc == 0) { return 0 - 1; }
    return load64(proc);
}

# Write `len` bytes from `buf` to the child's stdin. Returns the
# write() return value (bytes written, or -errno on failure).
fn lsp_proc_send(proc, buf, len) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    return sys_write(load64(proc + 16), buf, len);
}

# Read up to `max` bytes from the child's stdout into `buf`.
# Returns the read() return value:
#   > 0  — bytes read
#   = 0  — EOF (child closed stdout / exited)
#   < 0  — -errno
fn lsp_proc_recv(proc, buf, max) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    return sys_read(load64(proc + 8), buf, max);
}

# Close the child's pipes and reap the process via sys_waitpid.
# Idempotent: marks the proc handle's pid = -1 after first call so
# a second close() returns immediately without re-reaping.
#
# The reap is target-branched. The raw `sys_*` wrappers are per-target by design
# (`lib/syscalls_<arch>_<os>.cyr`) and agnos's `sys_waitpid` is a 1-arg
# `sys_waitpid(pid)` that returns the child's exit code DIRECTLY, against Linux's
# 3-arg `sys_waitpid(pid, statusp, options)` that fills a wait-status word. The
# Linux shape was written unconditionally, which cyrius only WARNED about until
# v6.5.1 escalated a wrong argument count to a hard error — so `--agnos` builds of
# this bundle now fail outright, and every consumer that prepends it fails with
# them (cyim's own agnos build was the report). Same per-target arity class sigil
# fixed in 3.9.8 (`_sig_unlink`) and sit in 1.3.4 (`sit_mkdir` / `sit_rmdir`).
#
# The spawn half (`sys_fork` / `sys_execve` / `sys_dup2`) has no agnos peer at all,
# so no LSP server can actually be started there — this branch exists so the
# bundle COMPILES as dead code on agnos, and is correct if a peer ever lands.
fn lsp_proc_close(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0; }   # already closed
    sys_close(load64(proc + 8));
    sys_close(load64(proc + 16));
    #ifdef CYRIUS_TARGET_AGNOS
    sys_waitpid(pid);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    # 8 bytes, not 1. A function-local `var X[N]` allocates N BYTES in cyrius
    # (module-scope is N x u64 — the units differ by scope), and the kernel writes
    # a 4-byte status word here, so `var status_buf[1]` was a 3-byte stack
    # overwrite on every reap. Latent before cyrius 6.3.13 moved locals onto the
    # stack behind a guard page; not worth leaving armed either way.
    var status_buf[8];
    sys_waitpid(pid, &status_buf, 0);
    #endif
    store64(proc, 0 - 1);   # mark closed
    return 0;
}

# Send SIGTERM to the child without closing pipes or reaping.
# Used by `:lsp-restart` to interrupt an unresponsive server
# before close-then-respawn. The caller still needs to call
# lsp_proc_close afterward to reap the zombie. Returns sys_kill's
# return value.
fn lsp_proc_kill(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    # SIGTERM = 15
    return sys_kill(pid, 15);
}

# Set O_NONBLOCK on the read pipe (parent reads child stdout).
# Called by lsp_client.cyr at the end of the initialize handshake
# so subsequent reads can return -EAGAIN instead of blocking. The
# write fd stays blocking (we always intend to send our entire
# message; partial-write handling lives in `_lsp_send_all` already).
#
# Constants: F_GETFL = 3, F_SETFL = 4, O_NONBLOCK = 2048 (Linux).
# SYS_FCNTL = 72 from syscalls_x86_64_linux.cyr.
#
# Returns 0 on success, -1 on fcntl failure.
#
# ⛔ agnos arm exists because #72 IS ASSIGNED THERE, not because it is missing.
# agnos has no fcntl; syscall 72 is `SYS_SHM_WRITE(id, user_src, size)`. The
# Linux body's `syscall(72, read_fd, 4, flags | 2048)` would therefore be a
# shared-memory write with `read_fd` as the segment id and the flags word as a
# length — a silent memory write from a call whose stated job is to set a flag.
# An undefined function is a loud failure; this would have been a quiet one.
# Answer -1: `_lsp_initialize` treats a set-nonblock failure as non-fatal.
#ifdef CYRIUS_TARGET_AGNOS
fn lsp_proc_set_nonblock(proc) {
    return 0 - 1;
}
#endif
#ifndef CYRIUS_TARGET_AGNOS
fn lsp_proc_set_nonblock(proc) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    var read_fd = load64(proc + 8);
    var flags = syscall(72, read_fd, 3, 0);   # F_GETFL
    if (flags < 0) { return 0 - 1; }
    var rc = syscall(72, read_fd, 4, flags | 2048);   # F_SETFL | O_NONBLOCK
    if (rc < 0) { return 0 - 1; }
    return 0;
}
#endif

# Non-blocking read variant. Like lsp_proc_recv but returns:
#   > 0  bytes read
#   = 0  EOF (child exited / closed stdout)
#   = -2 EAGAIN — no data ready right now (caller drains later)
#   = -1 unrecoverable error
#
# Requires lsp_proc_set_nonblock to have been called first.
fn lsp_proc_recv_nb(proc, buf, max) {
    if (proc == 0) { return 0 - 1; }
    var pid = load64(proc);
    if (pid < 0) { return 0 - 1; }
    var n = sys_read(load64(proc + 8), buf, max);
    if (n >= 0) { return n; }
    # Linux's read(O_NONBLOCK) returns -EAGAIN (-11) when no data.
    if (n == 0 - 11) { return 0 - 2; }
    return 0 - 1;
}
