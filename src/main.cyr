# cyim-lsp — standalone driver
#
# This binary is for ad-hoc smoke / development — `cyrius build
# src/main.cyr build/cyim-lsp` produces a CLI that exercises the
# library-side helpers (JSON-RPC framing, subprocess control)
# without needing cyim. The actual plugin shipping happens via
# `cyrius distlib` → dist/cyim-lsp.cyr → cyim's `include
# "lib/cyim-lsp.cyr"` per ADR 0003 §4.
#
# Stdlib auto-included via cyrius.cyml.

include "src/jsonrpc.cyr"
include "src/subprocess.cyr"
include "src/lsp_client.cyr"

# Print a NUL-term cstring + newline. Avoids hand-counting byte
# lengths (which is fragile for any string with multibyte runes).
fn _emit(s) {
    syscall(1, 1, s, strlen(s));
    syscall(1, 1, "\n", 1);
    return 0;
}

fn main() {
    alloc_init();
    _emit("cyim-lsp 0.4.0 (document sync wired)");
    var v = jsonrpc_version();
    syscall(1, 1, "JSON-RPC version: ", 18);
    _emit(v);
    syscall(1, 1, "lsp_client describe: ", 21);
    _emit(lsp_client_describe());
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
