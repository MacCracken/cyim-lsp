# lsp_documents.cyr — LSP document-sync senders + builders
#
# Pure-protocol surface for textDocument/didOpen, didChange,
# didSave, definition, references. The bundle is genuinely
# self-contained — no references to consumer-side editor symbols.
# Callers materialize their editor's buffer into a flat
# (content_ptr, content_len) before invoking the senders, and
# orchestrate the editor-state side themselves (see
# `docs/examples/cyim_glue.cyr` for cyim's reference shape).
#
# Public surface:
#   lsp_content_to_json_string(content, content_len)     -> json-escaped cstring
#   lsp_path_to_uri(path)                                -> "file://<path>" cstring
#   lsp_path_is_cyr(path)                                -> 0/1
#   lsp_doc_lazy_start()                                 -> 0/-1
#   lsp_doc_send_did_open(entry, content, content_len)   -> 0/-1
#   lsp_doc_send_did_change(entry, content, content_len) -> 0/-1
#   lsp_doc_send_did_save(uri)                           -> 0/-1
#   lsp_nav_request_sync(uri, line, character, method, body_len_out)
#                                                        -> body_ptr or 0
#   lsp_streq(a, b)                                      -> 0/1

# === JSON string escape ===
#
# Buffer text needs JSON-string-aware escaping before embedding
# in a `text` field. Encodes the 7 short escapes (\\, \", \b,
# \f, \n, \r, \t) and `\u00XX` for other control bytes (< 0x20).
# Printable ASCII passes through; non-ASCII bytes pass through
# as-is (assumes UTF-8-clean input — the typical cyrius case).

# Encode one source byte into dst[o..]. Returns new offset, or
# -1 if dst would overflow dst_cap. Worst case: 6 bytes (\u00XX).
fn _lsp_jesc_byte(c, dst, o, dst_cap) {
    if (c == 92) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 92);
        return o + 2;
    }
    if (c == 34) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 34);
        return o + 2;
    }
    if (c == 10) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 110);
        return o + 2;
    }
    if (c == 13) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 114);
        return o + 2;
    }
    if (c == 9) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 116);
        return o + 2;
    }
    if (c == 8) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 98);
        return o + 2;
    }
    if (c == 12) {
        if (o + 2 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 102);
        return o + 2;
    }
    if (c < 32) {
        # \u00XX — six bytes total. JSON spec requires escaping all
        # bytes < 0x20 inside string literals.
        if (o + 6 > dst_cap) { return 0 - 1; }
        store8(dst + o,     92);
        store8(dst + o + 1, 117);
        store8(dst + o + 2, 48);
        store8(dst + o + 3, 48);
        var hi = c / 16;
        var lo = c - hi * 16;
        if (hi < 10) { store8(dst + o + 4, 48 + hi); }
        if (hi >= 10) { store8(dst + o + 4, 87 + hi); }
        if (lo < 10) { store8(dst + o + 5, 48 + lo); }
        if (lo >= 10) { store8(dst + o + 5, 87 + lo); }
        return o + 6;
    }
    if (o + 1 > dst_cap) { return 0 - 1; }
    store8(dst + o, c);
    return o + 1;
}

# Materialize a flat byte buffer into a JSON-escaped heap cstring.
# Returns a NUL-term cstring suitable for embedding inside `"..."`
# in a JSON message body. 0 on alloc failure or 0-content_ptr.
fn lsp_content_to_json_string(content, content_len) {
    if (content == 0) { return 0; }
    # Worst case: every byte expands to 6 chars (\u00XX). Plus
    # NUL. Allocate the upper bound — cheap for plugin scale.
    var cap = content_len * 6 + 1;
    var dst = alloc(cap);
    if (dst == 0) { return 0; }
    var o = 0;
    var i = 0;
    while (i < content_len) {
        o = _lsp_jesc_byte(load8(content + i), dst, o, cap);
        if (o < 0) { return 0; }
        i = i + 1;
    }
    store8(dst + o, 0);
    return dst;
}

# === URI construction ===
#
# Convert a filesystem path to a `file://...` URI. Assumes
# absolute paths (consumer normalizes before calling). Relative
# paths produce technically-invalid URIs.

fn lsp_path_to_uri(path) {
    if (path == 0) { return 0; }
    var pl = strlen(path);
    var out = alloc(7 + pl + 1);
    if (out == 0) { return 0; }
    var prefix = "file://";
    var i = 0;
    while (i < 7) {
        store8(out + i, load8(prefix + i));
        i = i + 1;
    }
    var j = 0;
    while (j < pl) {
        store8(out + 7 + j, load8(path + j));
        j = j + 1;
    }
    store8(out + 7 + pl, 0);
    return out;
}

# === Filter: only operate on cyrius source ===
#
# Returns 1 if path ends in ".cyr", 0 otherwise. Multi-language
# support is post-v1.0 — consumers that want broader filters
# implement their own.

fn lsp_path_is_cyr(path) {
    if (path == 0) { return 0; }
    var pl = strlen(path);
    if (pl < 4) { return 0; }
    if (load8(path + pl - 4) != 46)  { return 0; }   # '.'
    if (load8(path + pl - 3) != 99)  { return 0; }   # 'c'
    if (load8(path + pl - 2) != 121) { return 0; }   # 'y'
    if (load8(path + pl - 1) != 114) { return 0; }   # 'r'
    return 1;
}

# === Decimal i64 to cstring (mirrors lsp_client.cyr's pattern). ===

fn _lsp_doc_itoa(n) {
    if (n == 0) {
        var z = alloc(2);
        if (z == 0) { return 0; }
        store8(z, 48);
        store8(z + 1, 0);
        return z;
    }
    var tmp[24];
    var tlen = 0;
    var v = n;
    while (v > 0) {
        store8(&tmp + tlen, 48 + (v - (v / 10) * 10));
        v = v / 10;
        tlen = tlen + 1;
    }
    var out = alloc(tlen + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < tlen) {
        store8(out + i, load8(&tmp + tlen - 1 - i));
        i = i + 1;
    }
    store8(out + tlen, 0);
    return out;
}

# Append helper (jsonrpc.cyr's _jr_append is internal there;
# duplicate here rather than expose it across files).
fn _lsp_append(dst, off, src) {
    var sl = strlen(src);
    var i = 0;
    while (i < sl) {
        store8(dst + off + i, load8(src + i));
        i = i + 1;
    }
    return off + sl;
}

# === didOpen builder ===
#
# Body shape (LSP §3.7.5):
#   {"textDocument": {
#      "uri": "<uri>",
#      "languageId": "cyrius",
#      "version": <n>,
#      "text": "<escaped text>"
#   }}

fn _lsp_doc_build_did_open_params(uri, version, text_escaped) {
    var ul = strlen(uri);
    var vl_str = _lsp_doc_itoa(version);
    if (vl_str == 0) { return 0; }
    var vl = strlen(vl_str);
    var tl = strlen(text_escaped);
    var cap = 80 + ul + vl + tl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\",\"languageId\":\"cyrius\",\"version\":");
    off = _lsp_append(out, off, vl_str);
    off = _lsp_append(out, off, ",\"text\":\"");
    off = _lsp_append(out, off, text_escaped);
    off = _lsp_append(out, off, "\"}}");
    store8(out + off, 0);
    return out;
}

# === didChange builder ===
#
# Body shape:
#   {"textDocument": {"uri":"<uri>","version":<n>},
#    "contentChanges": [{"text":"<escaped full text>"}]}

fn _lsp_doc_build_did_change_params(uri, version, text_escaped) {
    var ul = strlen(uri);
    var vl_str = _lsp_doc_itoa(version);
    if (vl_str == 0) { return 0; }
    var vl = strlen(vl_str);
    var tl = strlen(text_escaped);
    var cap = 100 + ul + vl + tl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\",\"version\":");
    off = _lsp_append(out, off, vl_str);
    off = _lsp_append(out, off, "},\"contentChanges\":[{\"text\":\"");
    off = _lsp_append(out, off, text_escaped);
    off = _lsp_append(out, off, "\"}]}");
    store8(out + off, 0);
    return out;
}

# === didSave builder ===
#
# Body shape:
#   {"textDocument": {"uri":"<uri>"}}
# (No `text` field — server already has the latest content from
# prior didChange.)

fn _lsp_doc_build_did_save_params(uri) {
    var ul = strlen(uri);
    var cap = 40 + ul;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\"}}");
    store8(out + off, 0);
    return out;
}

# === Lazy server start ===
#
# Spawn cyrius-lsp on first interaction. Idempotent — returns 0
# if already running. Uses `/usr/bin/env cyrius-lsp` so PATH
# lookup happens.

fn lsp_doc_lazy_start() {
    if (lsp_client_running() != 0) { return 0; }
    return lsp_client_start_default();
}

# === Public senders ===
#
# These take pre-extracted state (entry handle, flat content,
# URI) and emit the corresponding LSP notification. Consumer
# glue calls these after reading editor state and materializing
# buffer content.

# Send didOpen for an already-created state entry. Bumps version
# and marks the entry opened on success. Returns 0 / -1.
fn lsp_doc_send_did_open(entry, content, content_len) {
    if (entry == 0) { return 0 - 1; }
    if (lsp_state_is_opened(entry) == 1) { return 0; }
    var uri = lsp_state_uri(entry);
    var v = lsp_state_bump_version(entry);
    var text = lsp_content_to_json_string(content, content_len);
    if (text == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_open_params(uri, v, text);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didOpen", params);
    if (msg == 0) { return 0 - 1; }
    if (_lsp_send_all(msg) != 0) { return 0 - 1; }
    lsp_state_mark_opened(entry);
    return 0;
}

# Send didChange for an opened entry. Caller must have already
# sent didOpen (lsp_state_is_opened(entry) == 1). Bumps version.
# Returns 0 / -1.
fn lsp_doc_send_did_change(entry, content, content_len) {
    if (entry == 0) { return 0 - 1; }
    if (lsp_state_is_opened(entry) == 0) {
        # Caller didn't send didOpen first — surface as didOpen
        # rather than fail. Simplifies consumer glue.
        return lsp_doc_send_did_open(entry, content, content_len);
    }
    var v = lsp_state_bump_version(entry);
    var uri = lsp_state_uri(entry);
    var text = lsp_content_to_json_string(content, content_len);
    if (text == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_change_params(uri, v, text);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didChange", params);
    if (msg == 0) { return 0 - 1; }
    return _lsp_send_all(msg);
}

# Send didSave for a URI. Per LSP spec, no `text` field needed —
# server already has latest content from prior didChange.
fn lsp_doc_send_did_save(uri) {
    if (uri == 0) { return 0 - 1; }
    var params = _lsp_doc_build_did_save_params(uri);
    if (params == 0) { return 0 - 1; }
    var msg = jsonrpc_build_notification("textDocument/didSave", params);
    if (msg == 0) { return 0 - 1; }
    return _lsp_send_all(msg);
}

# === v0.6.0 navigation ===

# Build the JSON params for textDocument/definition or references.
# Both methods take the same params shape per LSP §3.10.7 / §3.10.8:
#   {"textDocument":{"uri":"<uri>"},"position":{"line":L,"character":C}}

fn _lsp_nav_build_params(uri, line, character) {
    var ul = strlen(uri);
    var line_str = _lsp_doc_itoa(line);
    var char_str = _lsp_doc_itoa(character);
    if (line_str == 0) { return 0; }
    if (char_str == 0) { return 0; }
    var ll = strlen(line_str);
    var cl = strlen(char_str);
    var cap = 80 + ul + ll + cl;
    var out = alloc(cap);
    if (out == 0) { return 0; }
    var off = 0;
    off = _lsp_append(out, off, "{\"textDocument\":{\"uri\":\"");
    off = _lsp_append(out, off, uri);
    off = _lsp_append(out, off, "\"},\"position\":{\"line\":");
    off = _lsp_append(out, off, line_str);
    off = _lsp_append(out, off, ",\"character\":");
    off = _lsp_append(out, off, char_str);
    off = _lsp_append(out, off, "}}");
    store8(out + off, 0);
    return out;
}

# Send a textDocument/<method> request (definition or references)
# for the given (uri, line, character). Returns the response body
# cstring on success, 0 on failure (no server, timeout, malformed
# response). *body_len_out gets the body byte length.
#
# max_iters = 5000 polling cycles. With ~1µs per non-blocking
# sys_read on an empty pipe that's ~5ms wall-clock — enough for
# cyrius-lsp on small files. Larger files may need a higher cap;
# consumer glue can tune by calling _lsp_request_sync directly.

fn lsp_nav_request_sync(uri, line, character, method, body_len_out) {
    if (uri == 0) { return 0; }
    var params = _lsp_nav_build_params(uri, line, character);
    if (params == 0) { return 0; }
    var id = jsonrpc_next_id();
    var msg = jsonrpc_build_request(id, method, params);
    if (msg == 0) { return 0; }
    return _lsp_request_sync(msg, id, body_len_out, 5000);
}

# Byte-equality of two NUL-term cstrings. Pure helper; consumer
# glue uses this for same-file checks against active buffer URI.
fn lsp_streq(a, b) {
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var i = 0;
    while (1 == 1) {
        var ca = load8(a + i);
        var cb = load8(b + i);
        if (ca != cb) { return 0; }
        if (ca == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}
