# lsp_position.cyr — buffer position helpers + Location parser
#
# LSP works in line / character coordinates (LSP §3.7);
# editors work in byte offsets within their buffer abstraction.
# This file converts between them and parses LSP `Location` /
# `LocationLink` response shapes.
#
# Public surface:
#   lsp_pos_offset_to_lc(content, content_len, off, line_out, char_out) -> 0
#   lsp_pos_lc_to_offset(content, content_len, line, character)         -> i64 offset
#   lsp_pos_extract_uri(body, blen)                                     -> cstring or 0
#   lsp_pos_extract_first_line(body, blen)                              -> i64 line or -1
#   lsp_pos_extract_first_character(body, blen)                         -> i64 char or -1
#   lsp_uri_decode(uri)                                                 -> cstring or 0  (v1.2.1)
#   lsp_ref_preview(uri, line, max_chars)                               -> cstring or 0  (v1.4.0)
#
# All helpers operate on flat byte buffers; consumers materialize
# their editor's buffer to a contiguous (ptr, len) before calling.
# No references to consumer-side symbols — the bundle is genuinely
# self-contained per ADR 0001's amended freeze.

# === Position conversions ===
#
# Convert a byte offset to (line, character) by counting newlines
# from the start of the buffer. line is 0-indexed for LSP output;
# character is bytes-from-start-of-line (byte-oriented; UTF-16
# code-unit conversion per LSP spec is deferred — most code is
# ASCII, where bytes == characters).
#
# Writes to *line_out and *char_out via store64. Returns 0
# always (no failure modes; out-of-range offsets just return
# the line/character at buffer end).

fn lsp_pos_offset_to_lc(content, content_len, off, line_out, char_out) {
    if (content == 0) {
        store64(line_out, 0);
        store64(char_out, 0);
        return 0;
    }
    if (off > content_len) { off = content_len; }
    var line = 0;
    var ch = 0;
    var i = 0;
    while (i < off) {
        if (load8(content + i) == 10) {
            line = line + 1;
            ch = 0;
        }
        if (load8(content + i) != 10) {
            ch = ch + 1;
        }
        i = i + 1;
    }
    store64(line_out, line);
    store64(char_out, ch);
    return 0;
}

# Convert (line, character) to a byte offset. line is 0-indexed
# (LSP convention). character is byte offset from start of line.
# Returns the offset; clamped to [0, content_len].

fn lsp_pos_lc_to_offset(content, content_len, line, character) {
    if (content == 0) { return 0; }
    var off = 0;
    var current_line = 0;
    var go = 1;
    while (go == 1) {
        if (current_line >= line) { go = 0; }
        if (off >= content_len) { go = 0; }
        if (go == 1) {
            if (load8(content + off) == 10) {
                current_line = current_line + 1;
            }
            off = off + 1;
        }
    }
    # off now points at start of `line`. Add character.
    var target = off + character;
    if (target > content_len) { target = content_len; }
    return target;
}

# === Location response parsing ===
#
# textDocument/definition response shapes (LSP §3.10.7):
#   - Location:      {"uri":"...","range":{"start":{"line":N,"character":M},"end":...}}
#   - Location[]:    array of the above (peek the first)
#   - LocationLink[]: similar with targetUri / targetRange (post-3.14)
#
# v0.6.0 supports Location and Location[] (peeks the first
# entry). LocationLink and the empty/null result get treated as
# "not found".
#
# `lsp_pos_extract_uri(body, blen)` finds `"uri":"..."` and
# returns the URI as a fresh cstring. (Same shape as
# lsp_diags's `_lsp_diags_extract_uri` but lives here so
# navigation doesn't depend on the diags module.)

fn lsp_pos_extract_uri(body, blen) {
    var marker = "\"uri\":\"";
    var pos = _lsp_diags_find(body, blen, 0, marker);
    if (pos < 0) { return 0; }
    var start = pos + 7;
    var end = start;
    var go = 1;
    while (go == 1) {
        if (end >= blen) { return 0; }
        if (load8(body + end) == 34) { go = 0; }
        if (go == 1) { end = end + 1; }
    }
    var ul = end - start;
    var out = alloc(ul + 1);
    if (out == 0) { return 0; }
    var i = 0;
    while (i < ul) {
        store8(out + i, load8(body + start + i));
        i = i + 1;
    }
    store8(out + ul, 0);
    return out;
}

# Find the first `"start":{"line":N` and return N (LSP
# 0-indexed). Returns -1 if not found.

fn lsp_pos_extract_first_line(body, blen) {
    var marker = "\"start\":{";
    var sp = _lsp_diags_find(body, blen, 0, marker);
    if (sp < 0) { return 0 - 1; }
    var line_marker = "\"line\":";
    var lp = _lsp_diags_find(body, blen, sp, line_marker);
    if (lp < 0) { return 0 - 1; }
    var np_slot[8];
    store64(&np_slot, 0);
    return _lsp_diag_parse_int(body, blen, lp + 7, &np_slot);
}

# Find the first `"start":{...,"character":N` and return N (LSP
# 0-indexed). Returns -1 if not found.

fn lsp_pos_extract_first_character(body, blen) {
    var marker = "\"start\":{";
    var sp = _lsp_diags_find(body, blen, 0, marker);
    if (sp < 0) { return 0 - 1; }
    var char_marker = "\"character\":";
    var cp = _lsp_diags_find(body, blen, sp, char_marker);
    if (cp < 0) { return 0 - 1; }
    var np_slot[8];
    store64(&np_slot, 0);
    return _lsp_diag_parse_int(body, blen, cp + 12, &np_slot);
}

# === URI percent-decoding (v1.2.1) ===
#
# LSP `file://` URIs follow RFC 3986 — bytes outside the
# unreserved set are percent-encoded. Common cases:
#   ' ' (space)  -> "%20"
#   '/' (slash)  -> "%2F" (rare; usually kept literal in path components)
#   non-ASCII    -> percent-encoded UTF-8 bytes
#
# cyim-lsp 1.0–1.2.0 stripped "file://" with a direct byte-7
# slice and passed the rest verbatim to plugin_buf_load_file —
# percent-encoded paths failed the OS open(). v1.2.1 adds
# `lsp_uri_decode(uri)` that consumers (cyim-lsp's reference
# glue, cyim's src/plugins/lsp_glue.cyr) call to materialize a
# real filesystem path.
#
# Decoding rules:
#   - %XX with two hex digits (case-insensitive) -> the
#     corresponding byte
#   - %XY where X or Y is not hex -> '%' kept literally; the X
#     byte continues normally next iteration
#   - % at end of string with < 2 following bytes -> literal '%'
#   - All other bytes pass through unchanged
#
# Returns a fresh heap cstring; caller doesn't free (matches the
# `lsp_path_to_uri` / `lsp_pos_extract_uri` lifetime convention).
# Returns 0 on null input or alloc failure.

fn _lsp_hex_digit(c) {
    if (c >= 48) {
        if (c <= 57)  { return c - 48; }    # '0'-'9' -> 0-9
    }
    if (c >= 65) {
        if (c <= 70)  { return c - 55; }    # 'A'-'F' -> 10-15
    }
    if (c >= 97) {
        if (c <= 102) { return c - 87; }    # 'a'-'f' -> 10-15
    }
    return 0 - 1;
}

fn lsp_uri_decode(uri) {
    if (uri == 0) { return 0; }
    var src_len = strlen(uri);
    # Decoded length is at most src_len (every %XX shrinks 3->1).
    var out = alloc(src_len + 1);
    if (out == 0) { return 0; }
    var src_i = 0;
    var out_i = 0;
    while (src_i < src_len) {
        var c = load8(uri + src_i);
        var consumed = 0;
        if (c == 37) {   # '%'
            # Need at least 2 more bytes for %XX.
            if (src_i + 2 < src_len) {
                var hi = _lsp_hex_digit(load8(uri + src_i + 1));
                var lo = _lsp_hex_digit(load8(uri + src_i + 2));
                if (hi >= 0) {
                    if (lo >= 0) {
                        store8(out + out_i, hi * 16 + lo);
                        out_i = out_i + 1;
                        src_i = src_i + 3;
                        consumed = 1;
                    }
                }
            }
        }
        if (consumed == 0) {
            store8(out + out_i, c);
            out_i = out_i + 1;
            src_i = src_i + 1;
        }
    }
    store8(out + out_i, 0);
    return out;
}

# === Reference previews (v1.4.0) ===
#
# `:lsp-find-refs` populates a quickfix picker labeled
# `filename:line:col`. That's enough to navigate, but doesn't
# surface what's *at* each reference. v1.4.0 adds
# `lsp_ref_preview(uri, line, max_chars)` — returns the source
# line at (uri, line), leading whitespace stripped, capped at
# `max_chars` bytes. Consumers append it to the picker label.
#
# Read strategy: `file_read_all` into a 1 MiB heap buffer.
# Sufficient for any source file that's plausibly being edited.
# Files larger than the cap fall back to no-preview (the label
# still surfaces filename:line:col and navigates correctly).
#
# `line` is 0-indexed (LSP wire convention), matching the
# `_cyim_lsp_refs_lines` storage in the reference glue.
#
# Returns a fresh heap cstring; caller doesn't free (matches the
# `lsp_uri_decode` lifetime convention). Returns 0 on:
#   - null uri or non-positive max_chars
#   - URI that doesn't start with "file://" (we strip 7 bytes and
#     hand the remainder to `lsp_uri_decode`; a non-file URI hits
#     a path that doesn't open)
#   - `file_read_all` failure (file missing / too large / I/O error)
#   - line out of range
#   - alloc failure

fn lsp_ref_preview(uri, line, max_chars) {
    if (uri == 0) { return 0; }
    if (max_chars <= 0) { return 0; }

    var path = lsp_uri_decode(uri + 7);
    if (path == 0) { return 0; }

    var cap = 1048576;   # 1 MiB
    var buf = alloc(cap);
    if (buf == 0) { return 0; }
    var n = file_read_all(path, buf, cap);
    if (n <= 0) { return 0; }

    # Walk to start of line `line` (0-indexed). Flag-pattern loop
    # because `break` with var-decls is unreliable in Cyrius.
    var line_start = 0;
    var lines_seen = 0;
    var i = 0;
    var walking = 1;
    while (walking == 1) {
        if (i >= n) {
            walking = 0;
        } else {
            if (lines_seen >= line) {
                walking = 0;
            } else {
                if (load8(buf + i) == 10) {
                    lines_seen = lines_seen + 1;
                    line_start = i + 1;
                }
                i = i + 1;
            }
        }
    }
    if (lines_seen < line) { return 0; }

    # Find end of line (next '\n' or buffer end).
    var line_end = line_start;
    var ending = 1;
    while (ending == 1) {
        if (line_end >= n) {
            ending = 0;
        } else {
            if (load8(buf + line_end) == 10) {
                ending = 0;
            } else {
                line_end = line_end + 1;
            }
        }
    }

    # Strip trailing CR (handles CRLF endings).
    if (line_end > line_start) {
        if (load8(buf + line_end - 1) == 13) { line_end = line_end - 1; }
    }

    # Strip leading whitespace (space / tab).
    var stripped = line_start;
    var stripping = 1;
    while (stripping == 1) {
        if (stripped >= line_end) {
            stripping = 0;
        } else {
            var c = load8(buf + stripped);
            if (c == 32) {
                stripped = stripped + 1;
            } else {
                if (c == 9) {
                    stripped = stripped + 1;
                } else {
                    stripping = 0;
                }
            }
        }
    }

    var avail = line_end - stripped;
    if (avail < 0) { avail = 0; }
    var keep = avail;
    if (keep > max_chars) { keep = max_chars; }

    var out = alloc(keep + 1);
    if (out == 0) { return 0; }
    var k = 0;
    while (k < keep) {
        store8(out + k, load8(buf + stripped + k));
        k = k + 1;
    }
    store8(out + keep, 0);
    return out;
}
